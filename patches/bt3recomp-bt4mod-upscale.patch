diff --git a/ps2xRuntime/src/lib/seamvk/seam_mv.vert b/ps2xRuntime/src/lib/seamvk/seam_mv.vert
new file mode 100644
index 0000000..f93c019
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/seam_mv.vert
@@ -0,0 +1,40 @@
+#version 450
+// [mvpass] Motion vectors of the seam meshes: the same vertices and position code as seam.vert (so depth EQUAL against
+// the scene's depth keeps only the visible surface), plus each chunk's position under the PREVIOUS frame's constants of
+// the same chunk (matched on the CPU; a chunk without a match carries its current constants: no motion).
+layout(location = 0) in vec4 inP;
+
+#include "seam_xform.glsl"
+layout(std430, set = 0, binding = 0) readonly buffer ConstsArr { Consts arr[]; } ca;
+layout(std430, set = 0, binding = 1) readonly buffer PrevArr { Consts arr[]; } cp;
+
+layout(push_constant) uniform MvPC
+{
+    vec4 view;    // the pass viewport, as pc.view in seam.vert
+    vec4 batch;   // z = 1: batched, w = chunk count
+    vec4 misc;    // x = target pixels per GS pixel
+} mp;
+
+layout(location = 0) out vec4 vCur;    // screen position (GS pixels * w), this frame
+layout(location = 1) out vec4 vPrev;   // the same vertex last frame
+out float gl_ClipDistance[2];
+invariant gl_Position;
+
+void main()
+{
+    int ci = 0;
+    if (mp.batch.z > 0.5)
+    {
+        int lo = 0, hi = int(mp.batch.w + 0.5) - 1;
+        const float vi = float(gl_VertexIndex);
+        while (lo < hi) { int mid = (lo + hi + 1) >> 1; if (vi >= ca.arr[mid].range.x) lo = mid; else hi = mid - 1; }
+        ci = lo;
+    }
+    vec4 screen, clipv, pscreen, pclipv;
+    seamPosition(ca.arr[ci], inP, screen, clipv);
+    seamPosition(cp.arr[ci], inP, pscreen, pclipv);
+    seamClipPlanes(int(ca.arr[ci].misc.x), clipv, gl_ClipDistance[0], gl_ClipDistance[1]);
+    gl_Position = seamClipPos(screen, mp.view);
+    vCur = screen;
+    vPrev = pscreen;
+}
