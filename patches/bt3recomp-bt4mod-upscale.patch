diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index e6d56e5..03c7b2c 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -1159,6 +1159,31 @@ if (_seamvk)
     target_compile_definitions(ps2_runtime PUBLIC PS2X_HAVE_SEAMVK=1)
     target_compile_definitions(ps2x_settings PRIVATE PS2X_HAVE_SEAMVK=1)   # [fesettings] same: without it the front end showed (and would save) OpenGL for a saved "native"
     message(STATUS "[seamvk] native Vulkan renderer enabled")
+    # [dlss] NVIDIA DLSS for the native renderer through the NGX SDK (github.com/NVIDIA/DLSS), when it is there. The runtime
+    # (nvngx_dlss.dll / libnvidia-ngx-dlss.so) goes next to the executable; without it DLSS reports itself unavailable.
+    set(PS2X_DLSS_SDK "" CACHE PATH "NVIDIA DLSS SDK root (include/nvsdk_ngx_vk.h)")
+    if(NOT PS2X_DLSS_SDK AND WIN32 AND EXISTS "C:/NBAStreetRecomp/ext/DLSS/include/nvsdk_ngx_vk.h")
+        set(PS2X_DLSS_SDK "C:/NBAStreetRecomp/ext/DLSS")
+    endif()
+    set(_ps2x_ngx_lib "")
+    if(PS2X_DLSS_SDK AND EXISTS "${PS2X_DLSS_SDK}/include/nvsdk_ngx_vk.h")
+        if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
+            set(_ps2x_ngx_lib "${PS2X_DLSS_SDK}/lib/Windows_x86_64/x64/nvsdk_ngx_d.lib")   # /MD
+        elseif(UNIX AND NOT APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
+            set(_ps2x_ngx_lib "${PS2X_DLSS_SDK}/lib/Linux_x86_64/libnvsdk_ngx.a")
+        endif()
+    endif()
+    if(_ps2x_ngx_lib AND EXISTS "${_ps2x_ngx_lib}")
+        target_compile_definitions(ps2_runtime PRIVATE PS2X_SEAMVK_DLSS=1)
+        target_include_directories(ps2_runtime PRIVATE "${PS2X_DLSS_SDK}/include")
+        target_link_libraries(ps2_runtime PRIVATE "${_ps2x_ngx_lib}")
+        if(UNIX)
+            target_link_libraries(ps2_runtime PRIVATE ${CMAKE_DL_LIBS} stdc++fs)
+        endif()
+        message(STATUS "[dlss] native renderer DLSS from ${PS2X_DLSS_SDK}")
+    else()
+        message(STATUS "[dlss] no DLSS SDK (PS2X_DLSS_SDK): the native renderer's upscaler is FSR only")
+    endif()
 else()
     message(STATUS "[seamvk] native Vulkan renderer not built (no Granite at ${PS2X_GRANITE_DIR}, or PS2X_DISABLE_SEAMVK)")
 endif()
