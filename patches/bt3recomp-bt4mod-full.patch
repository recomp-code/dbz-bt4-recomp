diff --git a/ps2xRuntime/src/lib/bt4mod_overrides.cpp b/ps2xRuntime/src/lib/bt4mod_overrides.cpp
new file mode 100644
index 0000000..bffe01d
--- /dev/null
+++ b/ps2xRuntime/src/lib/bt4mod_overrides.cpp
@@ -0,0 +1,146 @@
+// [BT4-mod] Overrides for the "BT4 Beta 14 Rev2" mod of Dragon Ball Z: Budokai Tenkaichi 3 (USA).
+//
+// The mod ships the USA ELF binary-patched in place (same name on our side, SLUS_216.78) plus a
+// longer DBZP.BIN, so the BT3 overrides in game_overrides.cpp apply to it as well. Everything here
+// runs only when the mod is detected (a hook word only the mod has), never on the USA game.
+// The recompile-time half (function maps, entry hints, heap patch) is games/bt3/bt4mod/.
+
+#include "game_overrides.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "runtime/ps2_memory.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace
+{
+    constexpr uint32_t kModSigAddr = 0x001133F4u;   // `j 0x3bee20`: a hook into the mod's code block
+    constexpr uint32_t kModSigWord = 0x080EFB88u;
+
+    inline uint32_t rd32(const uint8_t *rdram, uint32_t a)
+    {
+        uint32_t v = 0;
+        std::memcpy(&v, rdram + (a & 0x01FFFFFCu), 4);
+        return v;
+    }
+
+    bool isBt4Mod(PS2Runtime &runtime)
+    {
+        uint8_t *rdram = runtime.memory().getRDRAM();
+        return rdram && rd32(rdram, kModSigAddr) == kModSigWord;
+    }
+
+    // ---- PS2X_BT4_CALLPROBE=<hex addr>[,<hex frame offset>]: log sp / a saved word of the caller's
+    // frame around one guest function, to catch a callee that leaves the stack (or the caller's saved
+    // $ra) different from how it found it.
+    PS2Runtime::RecompiledFunction g_probeOrig = nullptr;
+    uint32_t g_probeAddr = 0u, g_probeOff = 0u;
+    void bt4CallProbe(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        static int s_n = 0;
+        static const bool s_all = std::getenv("PS2X_BT4_CALLPROBE_ALL") != nullptr;
+        const uint32_t sp0 = GPR_U32(ctx, 29), ra0 = GPR_U32(ctx, 31);
+        if (s_all && s_n < 200)
+        {
+            ++s_n;
+            std::fprintf(stderr, "[bt4probe] enter 0x%x pc=0x%x ra=0x%x sp=0x%x a0=0x%x\n",
+                         g_probeAddr, ctx->pc, ra0, sp0, GPR_U32(ctx, 4));
+        }
+        const uint32_t w0 = rd32(rdram, sp0 + g_probeOff);
+        g_probeOrig(rdram, ctx, runtime);
+        const uint32_t sp1 = GPR_U32(ctx, 29);
+        const uint32_t w1 = rd32(rdram, sp0 + g_probeOff);
+        if (s_n < 200 && (sp1 != sp0 || w1 != w0 || ctx->pc != ra0))
+        {
+            ++s_n;
+            std::fprintf(stderr, "[bt4probe] 0x%x ra=0x%x sp 0x%x->0x%x [sp+0x%x] 0x%x->0x%x pc_after=0x%x\n",
+                         g_probeAddr, ra0, sp0, sp1, g_probeOff, w0, w1, ctx->pc);
+        }
+    }
+
+    // ---- PS2X_BT4_RANGEPROBE=<lo>,<hi> (hex): log every dispatch into a slot of [lo,hi) (entry pc, ra, sp).
+    PS2Runtime::RecompiledFunction g_rangeOrig[2048] = {};
+    uint32_t g_rangeLo = 0u, g_rangeHi = 0u;
+    void bt4RangeProbe(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        static int s_n = 0;
+        const uint32_t pc = ctx->pc;
+        if (s_n < 300)
+        {
+            ++s_n;
+            std::fprintf(stderr, "[bt4range] enter pc=0x%x ra=0x%x sp=0x%x\n", pc, GPR_U32(ctx, 31), GPR_U32(ctx, 29));
+        }
+        const uint32_t idx = (pc - g_rangeLo) / 4u;
+        if (pc >= g_rangeLo && pc < g_rangeHi && g_rangeOrig[idx]) g_rangeOrig[idx](rdram, ctx, runtime);
+        else if (g_rangeOrig[0]) g_rangeOrig[0](rdram, ctx, runtime);
+    }
+
+    // ---- PS2X_BT4_RINGCMP=<fnaddr>,<ringA>,<ringB>,<bytes> (hex): after each call of fnaddr, compare
+    // two guest buffers (e.g. the L and R SJ rings of a stereo ADX stream). Logs equal/differing.
+    PS2Runtime::RecompiledFunction g_rcOrig = nullptr;
+    uint32_t g_rcA = 0u, g_rcB = 0u, g_rcLen = 0u;
+    void bt4RingCmp(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        g_rcOrig(rdram, ctx, runtime);
+        static uint32_t s_calls = 0, s_eq = 0, s_ne = 0, s_zero = 0;
+        ++s_calls;
+        if ((s_calls % 64u) == 0u)
+        {
+            const uint8_t *a = rdram + (g_rcA & 0x01FFFFFFu), *b = rdram + (g_rcB & 0x01FFFFFFu);
+            bool zero = true;
+            for (uint32_t i = 0; i < g_rcLen && zero; ++i) zero = a[i] == 0 && b[i] == 0;
+            if (zero) ++s_zero; else if (std::memcmp(a, b, g_rcLen) == 0) ++s_eq; else ++s_ne;
+            if ((s_calls % 2048u) == 0u)
+                std::fprintf(stderr, "[bt4ring] calls=%u samples: equal=%u differ=%u silent=%u\n", s_calls, s_eq, s_ne, s_zero);
+        }
+    }
+
+    void applyBt4Mod(PS2Runtime &runtime)
+    {
+        if (!isBt4Mod(runtime))
+            return;
+        std::fprintf(stderr, "[game_overrides] BT4-mod detected (hook word at 0x%x)\n", kModSigAddr);
+
+        if (const char *v = std::getenv("PS2X_BT4_RANGEPROBE"))
+        {
+            char *end = nullptr;
+            g_rangeLo = static_cast<uint32_t>(std::strtoul(v, &end, 16));
+            g_rangeHi = (end && *end == ',') ? static_cast<uint32_t>(std::strtoul(end + 1, nullptr, 16)) : g_rangeLo + 4u;
+            if (g_rangeHi > g_rangeLo + 4u * 2048u) g_rangeHi = g_rangeLo + 4u * 2048u;
+            for (uint32_t a = g_rangeLo; a < g_rangeHi; a += 4u)
+            {
+                g_rangeOrig[(a - g_rangeLo) / 4u] = runtime.hasFunction(a) ? runtime.lookupFunction(a) : nullptr;
+                if (g_rangeOrig[(a - g_rangeLo) / 4u]) runtime.replaceFunction(a, &bt4RangeProbe);
+            }
+            std::fprintf(stderr, "[bt4range] watching 0x%x..0x%x\n", g_rangeLo, g_rangeHi);
+        }
+        if (const char *v = std::getenv("PS2X_BT4_RINGCMP"))
+        {
+            uint32_t f[4] = {0, 0, 0, 0};
+            char *p = const_cast<char *>(v);
+            for (int k = 0; k < 4 && p && *p; ++k) { f[k] = static_cast<uint32_t>(std::strtoul(p, &p, 16)); if (*p == ',') ++p; }
+            g_rcA = f[1]; g_rcB = f[2]; g_rcLen = f[3] ? f[3] : 0x1000u;
+            g_rcOrig = runtime.lookupFunction(f[0]);
+            if (g_rcOrig && runtime.replaceFunction(f[0], &bt4RingCmp))
+                std::fprintf(stderr, "[bt4ring] after 0x%x compare 0x%x vs 0x%x (%u bytes)\n", f[0], g_rcA, g_rcB, g_rcLen);
+        }
+        if (const char *v = std::getenv("PS2X_BT4_CALLPROBE"))
+        {
+            char *end = nullptr;
+            g_probeAddr = static_cast<uint32_t>(std::strtoul(v, &end, 16));
+            if (end && *end == ',')
+                g_probeOff = static_cast<uint32_t>(std::strtoul(end + 1, nullptr, 16));
+            g_probeOrig = runtime.lookupFunction(g_probeAddr);
+            if (g_probeOrig && runtime.replaceFunction(g_probeAddr, &bt4CallProbe))
+                std::fprintf(stderr, "[bt4probe] watching 0x%x (+0x%x)\n", g_probeAddr, g_probeOff);
+        }
+    }
+}
+
+PS2_REGISTER_GAME_OVERRIDE("BT4-mod (BT3 USA mod)", "SLUS_216.78", 0u, 0u, &applyBt4Mod);
+
+// Referenced from game_overrides.cpp so the static library keeps this object (and its registration).
+extern "C" int g_bt4modLinkAnchor;
+int g_bt4modLinkAnchor = 0;
