+/////////////////////////////////////////////////////////////
+// [dbz] Depth mask pass (DBZ BT3 post chain), see GSH_OpenGL.h
+/////////////////////////////////////////////////////////////
+
+bool CGSH_OpenGL::TryDepthMaskPass()
+{
+	const uint64 primReg = m_PrimitiveMode;
+	auto prim = make_convertible<PRMODE>(primReg);
+	if(!prim.nTexture) return false;
+	const uint32 context = prim.nContext;
+	auto tex0 = make_convertible<TEX0>(m_nReg[GS_REG_TEX0_1 + context]);
+	auto frame = make_convertible<FRAME>(m_nReg[GS_REG_FRAME_1 + context]);
+	if((tex0.nPsm != PSMZ16) && (tex0.nPsm != PSMZ16S)) return false;
+	if((frame.nPsm != PSMCT16) && (frame.nPsm != PSMCT16S)) return false;
+	if(frame.nMask != 0x3FFF) return false;
+
+	//The Z buffer being read and the 32-bit frame the 16-bit view aliases
+	DepthbufferPtr depthbuffer;
+	for(const auto& candidate : m_depthbuffers)
+	{
+		if(candidate->m_basePtr == tex0.GetBufPtr() && (static_cast<GLuint>(candidate->m_depthTexture) != 0))
+		{
+			depthbuffer = candidate;
+			break;
+		}
+	}
+	if(!depthbuffer) return false;
+	FramebufferPtr framebuffer;
+	for(const auto& candidate : m_framebuffers)
+	{
+		if(candidate->m_basePtr == frame.GetBasePtr() && candidate->m_width == depthbuffer->m_width &&
+		   ((candidate->m_psm == PSMCT32) || (candidate->m_psm == PSMCT24)))
+		{
+			framebuffer = candidate;
+			break;
+		}
 	}
+	if(!framebuffer) return false;
+	if(m_depthMaskDone) return true; //rest of the strips of the same pass
+	m_depthMaskDone = true;
+	m_depthMaskPasses++;
+
+	FlushVertexBuffer();
+	if(m_depthMaskProgram == nullptr)
+	{
+		Framework::OpenGl::CShader vertexShader(GL_VERTEX_SHADER);
+		Framework::OpenGl::CShader pixelShader(GL_FRAGMENT_SHADER);
+		vertexShader.SetSource("#version 300 es\n"
+		                       "in vec2 a_position;\nin vec2 a_texCoord;\nout vec2 v_texCoord;\n"
+		                       "void main() { v_texCoord = a_texCoord; gl_Position = vec4(a_position, 0, 1); }\n");
+		vertexShader.Compile();
+		pixelShader.SetSource("#version 300 es\n"
+		                      "precision highp float;\nin vec2 v_texCoord;\nout vec4 fragColor;\n"
+		                      "uniform highp sampler2D g_texture;\nuniform float g_exact;\n"
+		                      "void main() {\n"
+		                      "  highp float d = texture(g_texture, v_texCoord).r;\n"
+		                      "  highp uint z = uint(d * 4294967296.0 + 0.5);\n"
+		                      "  float a = float((z >> 8u) & 255u) / 255.0;\n"
+		                      "  fragColor = vec4(0.0, 0.0, 0.0, g_exact > 0.5 ? a : clamp(a * 2.0, 0.0, 1.0));\n"
+		                      "}\n");
+		pixelShader.Compile();
+		m_depthMaskProgram = std::make_shared<Framework::OpenGl::CProgram>();
+		m_depthMaskProgram->AttachShader(vertexShader);
+		m_depthMaskProgram->AttachShader(pixelShader);
+		glBindAttribLocation(*m_depthMaskProgram, static_cast<GLuint>(PRIM_VERTEX_ATTRIB::POSITION), "a_position");
+		glBindAttribLocation(*m_depthMaskProgram, static_cast<GLuint>(PRIM_VERTEX_ATTRIB::TEXCOORD), "a_texCoord");
+		m_depthMaskProgram->Link();
+		glUseProgram(*m_depthMaskProgram);
+		glUniform1i(glGetUniformLocation(*m_depthMaskProgram, "g_texture"), 0);
+		m_depthMaskExactUniform = glGetUniformLocation(*m_depthMaskProgram, "g_exact");
+	}
+
+	//The depth texture can't stay attached to the framebuffer we draw into while it is read
+	glBindFramebuffer(GL_FRAMEBUFFER, framebuffer->m_framebuffer);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, 0, 0);
+	glDisable(GL_BLEND);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_SCISSOR_TEST);
+	glDepthMask(GL_FALSE);
+	glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_TRUE);
+	glUseProgram(*m_depthMaskProgram);
+	glUniform1f(m_depthMaskExactUniform, framebuffer->m_exactColor ? 1.0f : 0.0f);
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, depthbuffer->m_depthTexture);
+	//Rows the pass covers: the 16-bit view's scissor, in 32-bit rows (two 16-bit rows each)
+	auto scissor = make_convertible<SCISSOR>(m_nReg[GS_REG_SCISSOR_1 + context]);
+	const uint32 rows = std::min<uint32>(framebuffer->m_height, (scissor.scay1 + 2) / 2);
+	glEnable(GL_SCISSOR_TEST);
+	glScissor(0, 0, framebuffer->m_width * m_fbScale, rows * m_fbScale);
+	glViewport(0, 0, framebuffer->m_width * m_fbScale, framebuffer->m_height * m_fbScale);
+	glBindBuffer(GL_ARRAY_BUFFER, m_copyToFbVertexBuffer);
+	glBindVertexArray(m_copyToFbVertexArray);
+	glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
 	CHECKGLERROR();
+
+	framebuffer->m_resolveNeeded = true;
+	if(!framebuffer->m_gpuDirty)
+	{
+		framebuffer->m_gpuDirty = true;
+		framebuffer->m_gpuDirtyMinY = 0;
+		framebuffer->m_gpuDirtyMaxY = rows - 1;
+	}
+	else
+	{
+		framebuffer->m_gpuDirtyMinY = 0;
+		framebuffer->m_gpuDirtyMaxY = std::max(framebuffer->m_gpuDirtyMaxY, rows - 1);
+	}
+
+	//Everything above bypassed the cached GL state
+	m_validGlState = 0;
+	m_renderState.isValid = false;
+	m_renderState.isFramebufferStateValid = false;
+	m_renderState.isTextureStateValid = false;
+	return true;
 }
