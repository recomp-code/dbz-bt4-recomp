+void InitAudioDevice(void)
+{
+    if (g_audioUp.exchange(true))
+        return;
+    std::thread(mixerLoop).detach();
+    // The page owns the AudioContext (it may only start after a click or a key press).
+    MAIN_THREAD_ASYNC_EM_ASM(
+        {
+            if (typeof ps2xStartAudio == 'function')
+                ps2xStartAudio(HEAP16.buffer, $0, $1, $2);
+        },
+        g_ring, kRingFrames, g_ringIndex);
+    std::printf("[web] audio: streams mixed to 48 kHz stereo for the page's AudioWorklet\n");
+}
