@@ -3229,6 +3229,38 @@
 // [barblock] GL thread: serve queued blocking barriers. Drains any published-but-unrendered
 // lists first (so m_segFrom keeps indexing the current list), then renders the in-progress
 // list up to the request point and flushes the page straight into VRAM.
+#if defined(__EMSCRIPTEN__)
+// [web] The browser build has no GL: the page draws the live GS stream. Whatever the guest side publishes for the
+// present thread is dropped here, and barrier requests are answered at once (the parse records no draws there, so
+// there is nothing to render first).
+void GsGpuRenderer::webDrain()
+{
+    {
+        std::lock_guard<std::mutex> lk(m_mtx);
+        for (auto &l : m_pending)
+            if (m_vecPool.size() < 4) { l.clear(); m_vecPool.push_back(std::move(l)); }
+        m_pending.clear();
+        m_pendingGen.clear();
+        m_upQueue.clear();
+    }
+    unsigned served = 0, decodes = 0;
+    {
+        std::lock_guard<std::mutex> lk(g_bbMx);
+        while (!g_bbQueue.empty())
+        {
+            if (g_bbQueue.front().dec) ++decodes; else { ++g_bbServed; ++served; }
+            g_bbQueue.pop_front();
+        }
+    }
+    if (served || decodes)
+    {
+        g_bbCv.notify_all();
+        static unsigned s_n = 0;
+        if (s_n++ < 8) std::fprintf(stderr, "[web] answered %u GS barrier request(s) without a render (%u decode requests dropped)\n", served, decodes);
+    }
+}
+#endif
