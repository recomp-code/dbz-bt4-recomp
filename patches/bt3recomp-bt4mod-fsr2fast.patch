 		return FFX_ERROR_BACKEND_API_ERROR;
-	const Fsr2Baked &baked = kFsr2Baked[pass];
+	const bool half = fsr2Half(*device), wave64 = fsr2Wave64(*device);
+	if (pass == 0) std::fprintf(stderr, "[fsr2] passes in %s, %s\n", half ? "FP16" : "FP32", wave64 ? "64-wide waves" : "the GPU's own wave size");
+	const Fsr2Baked &baked = half ? kFsr2BakedHalf[pass] : kFsr2Baked[pass];
 	Vulkan::ResourceLayout layout = {};
 	layout.sets[0].sampler_mask = baked.samplers;
 	layout.sets[1].separate_image_mask = baked.separateImages;
@@ -642,7 +666,7 @@ FfxErrorCode Granite::FSR2::CreatePipeline(FfxFsr2Interface *backendInterface, F
 	pipeline.program = device->request_program(baked.code, baked.size, &layout);
 	if (!pipeline.program)
 		return FFX_ERROR_BACKEND_API_ERROR;
-	pipeline.force_wave64 = false;   // baked without the wave64 Lanczos LUT
+	pipeline.force_wave64 = wave64;   // [fsr2fast]
 
 	FFX_ASSERT(backendContext->nextPipelineIndex < FFX_FSR2_PASS_COUNT);
 	backendContext->pipelines[backendContext->nextPipelineIndex] = pipeline;
