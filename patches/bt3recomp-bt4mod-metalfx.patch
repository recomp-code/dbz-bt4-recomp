diff --git a/ps2xRuntime/src/lib/ps2_seamvk_metalfx.mm b/ps2xRuntime/src/lib/ps2_seamvk_metalfx.mm
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_seamvk_metalfx.mm
@@ -0,0 +1,101 @@
+// [metalfx] Apple MetalFX temporal upscaling for the native renderer on macOS (FSR2 / DLSS elsewhere). The renderer runs on
+// MoltenVK, so its Vulkan images and queue are Metal objects underneath: VK_EXT_metal_objects hands them over, and the
+// scaler is encoded on the SAME MTLCommandQueue right after the frame's Vulkan work was submitted (MoltenVK commits
+// a Vulkan submission's MTLCommandBuffer inside vkQueueSubmit), so Metal runs it after that work and before the rest
+// of the frame, with no copy, no semaphore and no CPU wait. Same inputs as DLSS / FSR2: the composed colour, the
+// game's real depth (inverted) and motion (render pixels, towards the previous frame), and the sub-pixel jitter.
+#define VK_USE_PLATFORM_METAL_EXT
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace ps2_seamvk_metalfx
+{
+    struct State
+    {
+        int state = 0;   // 0 unknown, 1 working, -1 unavailable
+        id<MTLFXTemporalScaler> scaler = nil;
+        uint32_t inW = 0, inH = 0, outW = 0, outH = 0;
+        id<MTLCommandQueue> queue = nil;
+        PFN_vkExportMetalObjectsEXT exportObjects = nullptr;
+    };
+    static State g;
+
+    static id<MTLTexture> texture(VkDevice dev, VkImage img)
+    {
+        VkExportMetalTextureInfoEXT t = { VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT };
+        t.image = img;
+        t.plane = VK_IMAGE_ASPECT_PLANE_0_BIT;
+        VkExportMetalObjectsInfoEXT o = { VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT };
+        o.pNext = &t;
+        g.exportObjects(dev, &o);
+        return t.mtlTexture;
+    }
+
+    // maxScale: the largest output / input ratio per axis MetalFX takes on this Mac (3 on an M2 Pro), 0 = no MetalFX.
+    float maxScale(VkDevice dev, PFN_vkGetDeviceProcAddr gdpa)
+    {
+        static float s = -1.0f;
+        if (s >= 0.0f) return s;
+        s = 0.0f;
+        id<MTLDevice> md = MTLCreateSystemDefaultDevice();
+        if (!md || ![MTLFXTemporalScalerDescriptor supportsDevice:md]) return s;
+        if (!gdpa || !(g.exportObjects = (PFN_vkExportMetalObjectsEXT)gdpa(dev, "vkExportMetalObjectsEXT"))) return s;
+        if (@available(macOS 14.0, *)) s = [MTLFXTemporalScalerDescriptor supportedInputContentMaxScaleForDevice:md];
+        else s = 2.0f;
+        return s;
+    }
+
+    // run: colour (RGBA8), depth (R32F, inverted), motion (RG16F) at inW x inH into out (RGBA8, storage + sampled +
+    // colour attachment) at outW x outH. jx, jy: the sample offset in input pixels. false = not run (the caller keeps
+    // the plain composed frame).
+    bool run(VkDevice dev, VkQueue queue, PFN_vkGetDeviceProcAddr gdpa, VkImage color, VkImage depth, VkImage motion, VkImage out,
+             uint32_t inW, uint32_t inH, uint32_t outW, uint32_t outH, float jx, float jy, bool reset)
+    {
+        if (g.state < 0 || maxScale(dev, gdpa) <= 0.0f) { g.state = -1; return false; }
+        if (!g.queue)
+        {
+            VkExportMetalCommandQueueInfoEXT q = { VK_STRUCTURE_TYPE_EXPORT_METAL_COMMAND_QUEUE_INFO_EXT };
+            q.queue = queue;
+            VkExportMetalObjectsInfoEXT o = { VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT };
+            o.pNext = &q;
+            g.exportObjects(dev, &o);
+            g.queue = q.mtlCommandQueue;
+            if (!g.queue) { g.state = -1; std::fprintf(stderr, "[metalfx] no Metal command queue from MoltenVK\n"); return false; }
+        }
+        if (!g.scaler || inW != g.inW || inH != g.inH || outW != g.outW || outH != g.outH)
+        {
+            MTLFXTemporalScalerDescriptor *d = [MTLFXTemporalScalerDescriptor new];
+            d.colorTextureFormat = MTLPixelFormatRGBA8Unorm;
+            d.depthTextureFormat = MTLPixelFormatR32Float;
+            d.motionTextureFormat = MTLPixelFormatRG16Float;
+            d.outputTextureFormat = MTLPixelFormatRGBA8Unorm;
+            d.inputWidth = inW; d.inputHeight = inH; d.outputWidth = outW; d.outputHeight = outH;
+            d.autoExposureEnabled = NO;   // LDR colour, as the game draws it
+            g.scaler = [d newTemporalScalerWithDevice:g.queue.device];
+            g.inW = inW; g.inH = inH; g.outW = outW; g.outH = outH;
+            if (!g.scaler) { std::fprintf(stderr, "[metalfx] scaler %ux%u -> %ux%u not available\n", inW, inH, outW, outH); return false; }
+            std::fprintf(stderr, "[metalfx] temporal scaler %ux%u -> %ux%u\n", inW, inH, outW, outH);
+            reset = true;
+        }
+        id<MTLTexture> c = texture(dev, color), z = texture(dev, depth), m = texture(dev, motion), o = texture(dev, out);
+        if (!c || !z || !m || !o) { static int s_n = 0; if (s_n++ < 4) std::fprintf(stderr, "[metalfx] a texture did not export\n"); return false; }
+        id<MTLFXTemporalScaler> s = g.scaler;
+        s.colorTexture = c; s.depthTexture = z; s.motionTexture = m; s.outputTexture = o;
+        s.inputContentWidth = inW; s.inputContentHeight = inH;
+        s.jitterOffsetX = jx; s.jitterOffsetY = jy;
+        static const float mvs = [](){ const char *v = std::getenv("PS2X_METALFX_MV_SIGN"); return v && v[0] == '-' ? -1.0f : 1.0f; }();   // diagnostics
+        s.motionVectorScaleX = mvs; s.motionVectorScaleY = mvs;   // render pixels, pointing at the previous frame
+        s.depthReversed = YES;
+        s.reset = reset;
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        cb.label = @"MetalFX temporal";
+        [s encodeToCommandBuffer:cb];
+        [cb commit];
+        g.state = 1;
+        return true;
+    }
+}
