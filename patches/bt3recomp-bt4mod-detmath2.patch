+        if (ix <= 0x4016cbe3u) return tandf(sign ? x + s1pio2 : x - s1pio2, 1);
+        return tandf(sign ? x + s2pio2 : x - s2pio2, 0);
+    }
+    if (ix <= 0x40e231d5u)
+    {
+        if (ix <= 0x40afeddfu) return tandf(sign ? x + s3pio2 : x - s3pio2, 1);
+        return tandf(sign ? x + s4pio2 : x - s4pio2, 0);
+    }
