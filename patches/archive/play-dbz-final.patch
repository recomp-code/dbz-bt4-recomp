+Framework::OpenGl::CTexture CGSH_OpenGL::CreateTextureStorage(const TEX0& tex0)
+{
+	auto texWidth = std::min<uint32>(tex0.GetWidth(), TEX0_MAX_TEXTURE_SIZE);
+	auto texHeight = std::min<uint32>(tex0.GetHeight(), TEX0_MAX_TEXTURE_SIZE);
+	auto texFormat = GetTextureFormatInfo(tex0.nPsm);
+	auto textureHandle = Framework::OpenGl::CTexture::Create();
+	glBindTexture(GL_TEXTURE_2D, textureHandle);
+	glTexStorage2D(GL_TEXTURE_2D, 1, texFormat.internalFormat, texWidth, texHeight);
+	CHECKGLERROR();
+	return textureHandle;
+}
+
+void CGSH_OpenGL::TexturePoolPut(std::pair<uint64, uint64> key, Framework::OpenGl::CTexture texture)
+{
+	constexpr size_t MAX_POOLED_TEXTURES = 192;
+	auto& entry = m_texturePool[key];
+	entry.texture = std::move(texture);
+	entry.lastUse = ++m_texturePoolClock;
+	if(m_texturePool.size() > MAX_POOLED_TEXTURES)
+	{
+		auto oldest = m_texturePool.begin();
+		for(auto it = m_texturePool.begin(); it != m_texturePool.end(); ++it)
+			if(it->second.lastUse < oldest->second.lastUse) oldest = it;
+		m_texturePool.erase(oldest);
+	}
+}
+
+Framework::OpenGl::CTexture CGSH_OpenGL::TexturePoolTake(std::pair<uint64, uint64> key)
+{
+	auto it = m_texturePool.find(key);
+	if(it == m_texturePool.end()) return Framework::OpenGl::CTexture();
+	auto texture = std::move(it->second.texture);
+	m_texturePool.erase(it);
+	return texture;
+}
