+		printf("[vu] micro memory %016llx: flags read: MAC %d, status %d, clip %d\n",
+		       static_cast<unsigned long long>(m_microMemoryHash), readMac ? 1 : 0, readSticky ? 1 : 0, readClip ? 1 : 0);
