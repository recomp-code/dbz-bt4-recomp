+// The online banner (RingHeader::netStatus, set by the game): a box at the top centre with what the online match
+// is doing. Drawn with each frame the game presents; while the game waits for the other player it presents none,
+// so the banner set just before that wait stays on screen.
+static void RenderLiveNetBanner()
+{
+	const u32 status = s_live.header ? s_live.header->netStatus : 0u;
+	if (status == 0u || status > 6u)
+		return;
+	static const std::string s_peer = [] {
+		const char* v = std::getenv("PS2X_NET_PEER_NAME");
+		return std::string((v && v[0]) ? v : "el otro jugador");
+	}();
+	// DBZ BT4 meets at its multiplayer menu and player 1 picks the mode there; other games (Bloody Roar 4) meet at
+	// their first frame and both play the menus together.
+	static const bool s_dbz = [] {
+		const char* v = std::getenv("PS2X_LIVE_SERIAL");
+		return !v || !v[0] || std::strcmp(v, "SLUS-21978") == 0;
+	}();
+	std::string title, line;
+	ImU32 accent = IM_COL32(255, 160, 40, 255);
+	switch (status)
+	{
+		case 1: title = "Partida online"; line = "Preparando la partida con " + s_peer + "..."; break;
+		case 2: title = "Esperando a " + s_peer; line = s_dbz ? "En el menú Multijugador. Empezáis en cuanto llegue." : "Empezáis en cuanto llegue."; break;
+		case 3: title = "Conectado con " + s_peer; line = s_dbz ? "El jugador 1 elige el modo." : "Jugáis los dos con vuestro mando."; accent = IM_COL32(90, 210, 120, 255); break;
+		case 4: title = "No se pudo conectar con " + s_peer; line = "Sigues jugando sin conexión."; accent = IM_COL32(230, 80, 70, 255); break;
+		case 5: title = "Estás en una partida online"; line = "Para salir, abre el launcher (Back + Start o Shift + Tab)."; break;
+		default: title = "Se perdió la conexión con " + s_peer; line = "Sigues jugando sin conexión."; accent = IM_COL32(230, 80, 70, 255); break;
+	}
+	const ImVec2 display = ImGui::GetIO().DisplaySize;
+	ImDrawList* dl = ImGui::GetForegroundDrawList();
+	if (bt4font::Ready())
+	{
+		// The game's own look: its text font at the size the game draws it (a 20 px cell in a 448-line picture), the
+		// white text with a black outline of the description boxes, under a gold bar like the selected menu row.
+		const float s = std::max(1.0f, display.y / 448.0f);
+		const float cell = static_cast<float>(bt4font::s_font.cellH ? bt4font::s_font.cellH : 20) * s;
+		const float pad = std::ceil(10.0f * s);
+		const float tw = bt4font::Width(title, s), lw = bt4font::Width(line, s);
+		const float width = std::max(tw, lw) + pad * 4.0f;
+		const float barH = cell + pad, boxH = cell + pad * 2.0f;
+		const ImVec2 p0((display.x - width) * 0.5f, std::ceil(16.0f * s));
+		const ImVec2 bar1(p0.x + width, p0.y + barH);
+		const ImVec2 box1(p0.x + width, bar1.y + boxH);
+		const float r = 6.0f * s;
+		// the description box: deep blue, a lighter blue rim
+		dl->AddRectFilled(ImVec2(p0.x, bar1.y - r), box1, IM_COL32(12, 52, 92, 235), r);
+		dl->AddRect(ImVec2(p0.x, bar1.y - r), box1, IM_COL32(70, 160, 200, 255), r, 2.0f * s);
+		// the title bar: gold gradient (status colour at the edge), dark rim
+		const ImU32 goldTop = IM_COL32(255, 222, 96, 255), goldBot = IM_COL32(214, 150, 24, 255);
+		dl->AddRectFilledMultiColor(p0, bar1, goldTop, goldTop, goldBot, goldBot);
+		dl->AddRect(p0, bar1, IM_COL32(90, 50, 0, 255), 0.0f, 2.0f * s);
+		dl->AddRectFilled(ImVec2(bar1.x - pad * 1.2f, p0.y + 2.0f * s), ImVec2(bar1.x - pad * 0.4f, bar1.y - 2.0f * s), accent, 2.0f * s);
+		bt4font::Draw(dl, ImVec2(p0.x + pad * 2.0f, p0.y + (barH - cell) * 0.5f), s, title, IM_COL32(255, 255, 255, 255), IM_COL32(110, 40, 0, 255));
+		bt4font::Draw(dl, ImVec2(p0.x + pad * 2.0f, bar1.y + pad), s, line, IM_COL32(255, 255, 255, 255), IM_COL32(0, 0, 0, 255));
+		return;
+	}
+	const float scale = ImGuiManager::GetGlobalScale();
+	ImFont* const font = ImGuiManager::GetStandardFont();
+	const float font_size = ImGuiManager::GetFontSizeStandard() * 1.15f;
+	const float pad = std::ceil(14.0f * scale);
+	const ImVec2 ts = font->CalcTextSizeA(font_size * 1.2f, FLT_MAX, -1.0f, title.c_str());
+	const ImVec2 ls = font->CalcTextSizeA(font_size, FLT_MAX, -1.0f, line.c_str());
+	const float width = std::max(ts.x, ls.x) + pad * 2.0f;
+	const float height = ts.y + ls.y + pad * 2.0f + std::ceil(6.0f * scale);
+	const ImVec2 p0((display.x - width) * 0.5f, std::ceil(24.0f * scale));
+	const ImVec2 p1(p0.x + width, p0.y + height);
+	dl->AddRectFilled(p0, p1, IM_COL32(10, 10, 20, 225), 10.0f * scale);
+	dl->AddRect(p0, p1, accent, 10.0f * scale, 2.0f * scale);
+	dl->AddText(font, font_size * 1.2f, ImVec2(p0.x + pad, p0.y + pad), accent, title.c_str());
+	dl->AddText(font, font_size, ImVec2(p0.x + pad, p0.y + pad + ts.y + std::ceil(6.0f * scale)), IM_COL32(230, 230, 240, 255), line.c_str());
+}
+
+// [invite] An online invitation received while playing (the launcher hands it to the host, pcsx2-gsrunner Main.cpp):
+// a box in the middle of the game window, answered with the pad (A accepts, B declines) without leaving the game.
+namespace
+{
+	std::mutex s_invite_mutex;
+	std::string s_invite_from;
+	std::string s_invite_line;
+} // namespace
+
+void GSDumpReplayer::SetLiveInvite(std::string from, std::string line)
+{
+	std::lock_guard lock(s_invite_mutex);
+	s_invite_from = std::move(from);
+	s_invite_line = std::move(line);
+}
+
+static void RenderLiveInvite()
+{
+	std::string from, line;
+	{
+		std::lock_guard lock(s_invite_mutex);
+		if (s_invite_from.empty())
+			return;
+		from = s_invite_from;
+		line = s_invite_line;
+	}
+	const std::string title = from + " te invita a pelear";
+	const std::string keys = "A: aceptar      B: rechazar";
+	const ImVec2 display = ImGui::GetIO().DisplaySize;
+	ImDrawList* dl = ImGui::GetForegroundDrawList();
+	dl->AddRectFilled(ImVec2(0, 0), display, IM_COL32(0, 0, 0, 110));
+	if (bt4font::Ready())
+	{
+		// the game's own look, as the online banner: gold title bar over a blue description box
+		const float s = std::max(1.0f, display.y / 448.0f);
+		const float cell = static_cast<float>(bt4font::s_font.cellH ? bt4font::s_font.cellH : 20) * s;
+		const float pad = std::ceil(10.0f * s);
+		const float width = std::max({bt4font::Width(title, s), bt4font::Width(line, s), bt4font::Width(keys, s)}) + pad * 4.0f;
+		const float barH = cell + pad, boxH = cell * 2.0f + pad * 3.0f;
+		const ImVec2 p0((display.x - width) * 0.5f, (display.y - barH - boxH) * 0.5f);
+		const ImVec2 bar1(p0.x + width, p0.y + barH);
+		const ImVec2 box1(p0.x + width, bar1.y + boxH);
+		const float r = 6.0f * s;
+		dl->AddRectFilled(ImVec2(p0.x, bar1.y - r), box1, IM_COL32(12, 52, 92, 240), r);
+		dl->AddRect(ImVec2(p0.x, bar1.y - r), box1, IM_COL32(70, 160, 200, 255), r, 2.0f * s);
+		const ImU32 goldTop = IM_COL32(255, 222, 96, 255), goldBot = IM_COL32(214, 150, 24, 255);
+		dl->AddRectFilledMultiColor(p0, bar1, goldTop, goldTop, goldBot, goldBot);
+		dl->AddRect(p0, bar1, IM_COL32(90, 50, 0, 255), 0.0f, 2.0f * s);
+		bt4font::Draw(dl, ImVec2(p0.x + pad * 2.0f, p0.y + (barH - cell) * 0.5f), s, title, IM_COL32(255, 255, 255, 255), IM_COL32(110, 40, 0, 255));
+		bt4font::Draw(dl, ImVec2(p0.x + pad * 2.0f, bar1.y + pad), s, line, IM_COL32(255, 255, 255, 255), IM_COL32(0, 0, 0, 255));
+		bt4font::Draw(dl, ImVec2(p0.x + pad * 2.0f, bar1.y + pad * 2.0f + cell), s, keys, IM_COL32(255, 230, 120, 255), IM_COL32(0, 0, 0, 255));
+		return;
+	}
+	const float scale = ImGuiManager::GetGlobalScale();
+	ImFont* const font = ImGuiManager::GetStandardFont();
+	const float fs = ImGuiManager::GetFontSizeStandard() * 1.2f;
+	const float pad = std::ceil(18.0f * scale);
+	const ImVec2 ts = font->CalcTextSizeA(fs * 1.25f, FLT_MAX, -1.0f, title.c_str());
+	const ImVec2 ls = font->CalcTextSizeA(fs, FLT_MAX, -1.0f, line.c_str());
+	const ImVec2 ks = font->CalcTextSizeA(fs, FLT_MAX, -1.0f, keys.c_str());
+	const float gap = std::ceil(8.0f * scale);
+	const float width = std::max({ts.x, ls.x, ks.x}) + pad * 2.0f;
+	const float height = ts.y + ls.y + ks.y + gap * 2.0f + pad * 2.0f;
+	const ImVec2 p0((display.x - width) * 0.5f, (display.y - height) * 0.5f);
+	const ImVec2 p1(p0.x + width, p0.y + height);
+	const ImU32 accent = IM_COL32(255, 160, 40, 255);
+	dl->AddRectFilled(p0, p1, IM_COL32(10, 10, 20, 235), 12.0f * scale);
+	dl->AddRect(p0, p1, accent, 12.0f * scale, 2.0f * scale);
+	float y = p0.y + pad;
+	dl->AddText(font, fs * 1.25f, ImVec2(p0.x + pad, y), accent, title.c_str());
+	y += ts.y + gap;
+	dl->AddText(font, fs, ImVec2(p0.x + pad, y), IM_COL32(230, 230, 240, 255), line.c_str());
+	y += ls.y + gap;
+	dl->AddText(font, fs, ImVec2(p0.x + pad, y), IM_COL32(255, 230, 120, 255), keys.c_str());
+}
