diff -ruN a/ps2xRuntime/android/android_compat.h b/ps2xRuntime/android/android_compat.h
--- a/ps2xRuntime/android/android_compat.h	1969-12-31 18:00:00
+++ b/ps2xRuntime/android/android_compat.h	2026-10-26 17:04:02
@@ -0,0 +1,24 @@
+// [android] Force-included on Android (-include): POSIX/glibc calls bionic lacks at the API level the runner targets.
+// Each one is a diagnostic or PCSX2-host-only path, so a harmless stand-in is enough.
+#pragma once
+#if defined(__ANDROID__)
+#include <errno.h>
+#include <sched.h>
+#include <pthread.h>
+#include <sys/types.h>
+#include <spawn.h>
+#if __ANDROID_API__ < 33
+static inline int backtrace(void **b, int n) { (void)b; (void)n; return 0; }
+static inline char **backtrace_symbols(void *const *b, int n) { (void)b; (void)n; return 0; }
+static inline void backtrace_symbols_fd(void *const *b, int n, int fd) { (void)b; (void)n; (void)fd; }
+#endif
+#if __ANDROID_API__ < 34
+static inline int posix_spawn_file_actions_addchdir_np(posix_spawn_file_actions_t *a, const char *p) { (void)a; (void)p; return 0; }
+#endif
+static inline int shm_open(const char *n, int f, mode_t m) { (void)n; (void)f; (void)m; errno = ENOSYS; return -1; }
+static inline int shm_unlink(const char *n) { (void)n; errno = ENOSYS; return -1; }
+#if defined(__cplusplus)   // cpu_set_t needs _GNU_SOURCE, which only C++ has by default
+static inline int pthread_setaffinity_np(pthread_t t, size_t n, const cpu_set_t *s) { return sched_setaffinity(pthread_gettid_np(t), n, s) == 0 ? 0 : errno; }
+static inline int pthread_getaffinity_np(pthread_t t, size_t n, cpu_set_t *s) { return sched_getaffinity(pthread_gettid_np(t), n, s) == 0 ? 0 : errno; }
+#endif
+#endif
diff -ruN a/ps2xRuntime/android/android_main.cpp b/ps2xRuntime/android/android_main.cpp
--- a/ps2xRuntime/android/android_main.cpp	1969-12-31 18:00:00
+++ b/ps2xRuntime/android/android_main.cpp	2026-10-26 17:04:02
@@ -0,0 +1,107 @@
+// [android] Entry point: GameActivity (SDLActivity, Java) loads libmain.so and calls SDL_main. The runner's own main()
+// is reused. The launcher hands the game its environment through the activity (before SDL_main
+// runs: SDLActivity.nativeSetenv), including where to work and log:
+//   PS2X_ANDROID_CWD       the working folder (the runtime folder: assets/, savedata/, data/)
+//   PS2X_ANDROID_ELF       the boot ELF
+//   PS2X_ANDROID_LOG       stdout + stderr (the launcher's logs/juego.log)
+//   PS2X_ANDROID_PIDFILE   this process's id, written at start (the launcher follows it)
+//   PS2X_ANDROID_EXITFILE  the exit code, written when the game ends; then the process exits, as on the desktop
+// Without a launcher (development) the app's external files dir is used: env.txt there holds KEY=VALUE lines, log.txt
+// gets stderr, and the ELF is SLUS_216.78 there.
+#include <SDL.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unistd.h>
+#include <android/log.h>
+
+extern "C" int ps2x_runner_main(int argc, char **argv) __asm__("main");
+#if defined(PS2X_PGO_GEN)
+extern "C" void __llvm_profile_set_filename(const char *);   // [pgo] the instrumented build's profile goes to the files dir
+#endif
+
+extern "C" { pid_t g_ps2xSdlMainTid = 0; }   // [adpf] the thread that runs the game's window, GL and present
+
+static bool envSet(const char *k)
+{
+    const char *v = getenv(k);
+    return v && v[0];
+}
+
+static void writeFile(const char *path, const std::string &text)
+{
+    if (!path || !path[0]) return;
+    if (FILE *f = std::fopen(path, "w")) { std::fputs(text.c_str(), f); std::fclose(f); }
+}
+
+extern "C" int SDL_main(int argc, char **argv)
+{
+    (void)argc; (void)argv;
+    g_ps2xSdlMainTid = gettid();
+    std::string dir, elf, log;
+    if (envSet("PS2X_ANDROID_CWD"))
+    {   // started by the launcher
+        dir = getenv("PS2X_ANDROID_CWD");
+        elf = envSet("PS2X_ANDROID_ELF") ? getenv("PS2X_ANDROID_ELF") : dir + "/data/SLUS_216.78";
+        log = envSet("PS2X_ANDROID_LOG") ? getenv("PS2X_ANDROID_LOG") : dir + "/juego.log";
+    }
+    else
+    {   // development: everything in the external files dir (adb push)
+        const char *x = SDL_AndroidGetExternalStoragePath();
+        if (!x) { __android_log_print(ANDROID_LOG_ERROR, "dbz", "no external storage: %s", SDL_GetError()); return 1; }
+        dir = x;
+        elf = dir + "/SLUS_216.78";
+        log = dir + "/log.txt";
+        if (FILE *f = std::fopen((dir + "/env.txt").c_str(), "r"))
+        {
+            char line[4096];
+            while (std::fgets(line, sizeof line, f))
+            {
+                size_t n = std::strlen(line);
+                while (n && (line[n - 1] == '\n' || line[n - 1] == '\r')) line[--n] = 0;
+                if (!n || line[0] == '#') continue;
+                char *eq = std::strchr(line, '=');
+                if (!eq) continue;
+                *eq = 0;
+                if (!std::strcmp(line, "ELF")) elf = eq + 1; else setenv(line, eq + 1, 1);
+            }
+            std::fclose(f);
+        }
+        std::freopen((dir + "/stdout.txt").c_str(), "w", stdout);
+    }
+    chdir(dir.c_str());
+    std::freopen(log.c_str(), "w", stderr);
+    if (envSet("PS2X_ANDROID_CWD")) std::freopen(log.c_str(), "a", stdout);
+    setvbuf(stderr, nullptr, _IONBF, 0);
+    setvbuf(stdout, nullptr, _IOLBF, 0);
+#if defined(PS2X_PGO_GEN)
+    static std::string s_prof = dir + "/pgo-%p.profraw";
+    __llvm_profile_set_filename(s_prof.c_str());
+#endif
+    if (!envSet("PS2X_EXEDIR")) setenv("PS2X_EXEDIR", dir.c_str(), 1);
+    // The window is the whole screen, in landscape, without system bars: the display's own size, unless set.
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) == 0)
+    {
+        SDL_DisplayMode dm;
+        if (SDL_GetDesktopDisplayMode(0, &dm) == 0 && dm.w > 0 && dm.h > 0)
+        {
+            const int w = dm.w > dm.h ? dm.w : dm.h, h = dm.w > dm.h ? dm.h : dm.w;
+            if (!envSet("PS2X_WINDOW_W")) setenv("PS2X_WINDOW_W", std::to_string(w).c_str(), 1);
+            if (!envSet("PS2X_WINDOW_H")) setenv("PS2X_WINDOW_H", std::to_string(h).c_str(), 1);
+        }
+    }
+    if (!envSet("PS2X_WINDOW_MODE")) setenv("PS2X_WINDOW_MODE", "2", 1);
+    // Lower audio latency: AAudio where the system has it (SDL falls back to OpenSL ES).
+    if (!envSet("SDL_AUDIODRIVER")) setenv("SDL_AUDIODRIVER", "aaudio,openslES", 1);
+    writeFile(getenv("PS2X_ANDROID_PIDFILE"), std::to_string(getpid()));
+    std::fprintf(stderr, "[android] dir=%s elf=%s\n", dir.c_str(), elf.c_str());
+    char arg0[] = "ps2EntryRunner";
+    char *args[] = { arg0, elf.data(), nullptr };
+    const int code = ps2x_runner_main(2, args);
+    // As on the desktop the game's end is its process's end: the launcher (another process) sees it go, and the next game
+    // starts from a clean process (the runtime keeps state in globals).
+    writeFile(getenv("PS2X_ANDROID_EXITFILE"), std::to_string(code));
+    std::fflush(nullptr);
+    _exit(code);
+}
diff -ruN a/ps2xRuntime/android/gl_desktop_stubs.c b/ps2xRuntime/android/gl_desktop_stubs.c
--- a/ps2xRuntime/android/gl_desktop_stubs.c	1969-12-31 18:00:00
+++ b/ps2xRuntime/android/gl_desktop_stubs.c	2026-10-26 17:04:02
@@ -0,0 +1,12 @@
+// [android] Desktop-GL entry points the GL GS renderer (ps2_gs_gpu_renderer.cpp) calls directly. GLES 3 has none of
+// them; the native renderer never takes that path, so these only keep the link whole (and do the closest GLES thing).
+#include <GLES3/gl3.h>
+#include <string.h>
+void glClearDepth(double d) { glClearDepthf((float)d); }
+void glDrawBuffer(GLenum b) { glDrawBuffers(1, &b); }
+void glGetBufferSubData(GLenum t, GLintptr off, GLsizeiptr n, void *dst)
+{
+    void *p = glMapBufferRange(t, off, n, GL_MAP_READ_BIT);
+    if (p) { memcpy(dst, p, (size_t)n); glUnmapBuffer(t); }
+}
+void glGetTexImage(GLenum t, GLint lvl, GLenum fmt, GLenum type, void *px) { (void)t; (void)lvl; (void)fmt; (void)type; (void)px; }
diff -ruN a/ps2xRuntime/android/gl_es_shim.cpp b/ps2xRuntime/android/gl_es_shim.cpp
--- a/ps2xRuntime/android/gl_es_shim.cpp	1969-12-31 18:00:00
+++ b/ps2xRuntime/android/gl_es_shim.cpp	2026-10-26 17:04:02
@@ -0,0 +1,112 @@
+// [android] Desktop GL 3.3 code on a GLES 3.2 context. Every GL loader in the runner (raylib's glad, gsrl's glad, gfx/gl)
+// asks SDL_GL_GetProcAddress, wrapped here at link time (-Wl,--wrap): glShaderSource rewrites the "#version" line to
+// GLSL ES with default precisions, and the few desktop-only entry points get the closest GLES equivalent.
+#include <SDL.h>
+#include <GLES3/gl32.h>
+#include <cstdio>
+#include <cstring>
+#include <regex>
+#include <string>
+#include <vector>
+
+extern "C" void *__real_SDL_GL_GetProcAddress(const char *name);
+extern "C" void __real_glShaderSource(GLuint, GLsizei, const GLchar *const *, const GLint *);
+
+namespace
+{
+    using ShaderSourceFn = void (*)(GLuint, GLsizei, const GLchar *const *, const GLint *);
+    ShaderSourceFn s_realShaderSource = nullptr;
+
+    std::string toEs(std::string src)
+    {
+        const size_t v = src.find("#version");
+        std::string ver;
+        size_t end = 0;
+        if (v != std::string::npos) { end = src.find('\n', v); if (end == std::string::npos) end = src.size(); ver = src.substr(v, end - v); }
+        const bool legacy = ver.find("100") != std::string::npos || ver.find("110") != std::string::npos || ver.find("120") != std::string::npos;
+        if (ver.find(" es") != std::string::npos) return src;   // already GLSL ES
+        static std::string esVer;   // the newest GLSL ES the context takes: "320 es" / "310 es" / "300 es"
+        if (esVer.empty())
+        {
+            const char *sl = reinterpret_cast<const char *>(glGetString(GL_SHADING_LANGUAGE_VERSION));
+            esVer = sl && std::strstr(sl, "3.20") ? "320 es" : sl && std::strstr(sl, "3.10") ? "310 es" : "300 es";
+            std::fprintf(stderr, "[android] GL %s, GLSL %s -> #version %s\n", glGetString(GL_VERSION), sl ? sl : "?", esVer.c_str());
+        }
+        std::string head = legacy ? "#version 100\n" : "#version " + esVer + "\n";
+        std::string prec = "precision highp float;\nprecision highp int;\nprecision highp sampler2D;\n";
+        if (!legacy) prec += "precision highp usampler2D;\nprecision highp isampler2D;\nprecision highp sampler2DArray;\nprecision highp sampler3D;\n";
+        // Dual-source blending (the GS shader's "index = 1" output): GL_EXT_blend_func_extended where the GPU has it
+        // (most Adreno), otherwise the second output becomes a plain variable and SRC1 blends read garbage (degraded).
+        if (src.find("index") != std::string::npos && std::regex_search(src, std::regex("index\\s*=\\s*[01]")))
+        {
+            static int dual = -1;
+            if (dual < 0)
+            {
+                const char *ex = reinterpret_cast<const char *>(glGetString(GL_EXTENSIONS));
+                dual = ex && std::strstr(ex, "GL_EXT_blend_func_extended") ? 1 : 0;
+                std::fprintf(stderr, "[android] dual-source blend: %s\n", dual ? "GL_EXT_blend_func_extended" : "NOT supported (degraded)");
+            }
+            if (dual) head += "#extension GL_EXT_blend_func_extended : require\n";
+            else
+            {
+                src = std::regex_replace(src, std::regex("layout\\s*\\(\\s*location\\s*=\\s*0\\s*,\\s*index\\s*=\\s*1\\s*\\)\\s*out\\s+"), "");
+                src = std::regex_replace(src, std::regex(",\\s*index\\s*=\\s*0\\s*"), "");
+            }
+        }
+        // "#version" first, then every #extension (the shader's own move up; desktop GL_ARB_* ones are dropped), and only
+        // then the precisions: GLSL ES takes no #extension after a declaration
+        for (size_t p = src.find("#extension"); p != std::string::npos; p = src.find("#extension", p))
+        {
+            size_t e = src.find('\n', p);
+            if (e == std::string::npos) e = src.size();
+            const std::string line = src.substr(p, e - p);
+            if (line.find("GL_ARB_") == std::string::npos) head += line + "\n";
+            src.erase(p, e - p);
+        }
+        head += prec;
+        if (v == std::string::npos) return head + src;
+        return head + src.substr(0, v) + src.substr(end);
+    }
+
+    void shaderSource(GLuint sh, GLsizei count, const GLchar *const *str, const GLint *len)
+    {
+        std::string all;
+        for (GLsizei i = 0; i < count; ++i) all.append(str[i], len && len[i] >= 0 ? size_t(len[i]) : std::strlen(str[i]));
+        std::string es = toEs(all);
+        const GLchar *p = es.c_str();
+        s_realShaderSource(sh, 1, &p, nullptr);
+    }
+
+    void clearDepth(double d) { glClearDepthf(float(d)); }
+    void drawBuffer(GLenum b) { glDrawBuffers(1, &b); }
+    void polygonMode(GLenum, GLenum) {}
+    void getTexImage(GLenum, GLint, GLenum, GLenum, void *) {}
+    void getBufferSubData(GLenum t, GLintptr off, GLsizeiptr n, void *dst)
+    {
+        if (void *p = glMapBufferRange(t, off, n, GL_MAP_READ_BIT)) { std::memcpy(dst, p, size_t(n)); glUnmapBuffer(t); }
+    }
+}
+
+extern "C" void *__wrap_SDL_GL_GetProcAddress(const char *name)
+{
+    if (!name) return nullptr;
+    if (!std::strcmp(name, "glShaderSource"))
+    {
+        if (!s_realShaderSource) s_realShaderSource = reinterpret_cast<ShaderSourceFn>(__real_SDL_GL_GetProcAddress(name));
+        return reinterpret_cast<void *>(&shaderSource);
+    }
+    if (!std::strcmp(name, "glClearDepth")) return reinterpret_cast<void *>(&clearDepth);
+    if (!std::strcmp(name, "glDrawBuffer")) return reinterpret_cast<void *>(&drawBuffer);
+    if (!std::strcmp(name, "glPolygonMode")) return reinterpret_cast<void *>(&polygonMode);
+    if (!std::strcmp(name, "glGetTexImage")) return reinterpret_cast<void *>(&getTexImage);
+    if (!std::strcmp(name, "glGetBufferSubData")) return reinterpret_cast<void *>(&getBufferSubData);
+    return __real_SDL_GL_GetProcAddress(name);
+}
+
+// ImGui's GLES3 backend (and anything else linked straight to libGLESv3) calls glShaderSource directly: -Wl,--wrap sends
+// those calls through the same rewrite.
+extern "C" void __wrap_glShaderSource(GLuint sh, GLsizei count, const GLchar *const *str, const GLint *len)
+{
+    if (!s_realShaderSource) s_realShaderSource = &__real_glShaderSource;
+    shaderSource(sh, count, str, len);
+}
diff -ruN a/ps2xRuntime/android/perf_hint.cpp b/ps2xRuntime/android/perf_hint.cpp
--- a/ps2xRuntime/android/perf_hint.cpp	1969-12-31 18:00:00
+++ b/ps2xRuntime/android/perf_hint.cpp	2026-10-26 17:04:02
@@ -0,0 +1,170 @@
+// [android] ADPF (Android Dynamic Performance Framework, API 33+): once per game frame the guest thread reports how long
+// the frame took against its budget (16.7 ms at 60 fps, 33.3 at 30), so the system raises clocks / moves the game's
+// threads to the big cores BEFORE frames are missed. The duration is the wall time from one frame to the next minus the
+// deliberate pacing wait: it includes the stalls on the other guest threads and the GS, which a thread's CPU time does
+// not -- reporting CPU time read "under budget" while the frame took 20 ms, and the governor kept the cores at ~1 GHz.
+// The session holds every thread the frame waits on: the guest threads (GameThread, PS2Thread_*), the GS / renderer
+// threads (GsThread) and the SDL main thread (GL + present) -- on a Pixel 7a the load is spread over four of them, and
+// the ones outside the session stayed on the small cores. Found by name in /proc/self/task once the game has started,
+// refreshed every few seconds (threads come and go with the game's modes). Loaded by name: Android 12 lacks ADPF.
+// PS2X_ADPF=0 turns it off.
+#include <android/log.h>
+#include <dlfcn.h>
+#include <time.h>
+#include <unistd.h>
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dirent.h>
+#include <vector>
+
+struct APerformanceHintManager;
+struct APerformanceHintSession;
+
+extern "C" pid_t g_ps2xSdlMainTid;   // android_main.cpp
+
+// [dynres] The upscaler's output follows the frame time: a phone that falls behind (heat, a mid-range GPU) gives up
+// resolution before it gives up frames, and gets it back when there is room. 1.0 = the quality's full budget, down to
+// 0.6 per axis. ps2_seamvk.cpp scales its pixel budget by the square. PS2X_DYNRES=0 turns it off.
+static std::atomic<float> g_dynRes{1.0f};
+extern "C" float ps2xAndroidDynRes() { return g_dynRes.load(std::memory_order_relaxed); }
+
+namespace
+{
+    using GetManagerFn = APerformanceHintManager *(*)();
+    using CreateSessionFn = APerformanceHintSession *(*)(APerformanceHintManager *, const int32_t *, size_t, int64_t);
+    using UpdateTargetFn = int (*)(APerformanceHintSession *, int64_t);
+    using ReportFn = int (*)(APerformanceHintSession *, int64_t);
+    using SetThreadsFn = int (*)(APerformanceHintSession *, const pid_t *, size_t);
+
+    // The game's own threads, by the names the runtime gives them.
+    std::vector<int32_t> gameThreads(int32_t self, int32_t sdlMain)
+    {
+        std::vector<int32_t> t;
+        t.push_back(self);
+        if (sdlMain > 0 && sdlMain != self) t.push_back(sdlMain);
+        if (DIR *d = opendir("/proc/self/task"))
+        {
+            while (dirent *e = readdir(d))
+            {
+                const int32_t tid = std::atoi(e->d_name);
+                if (tid <= 0 || tid == self || tid == sdlMain) continue;
+                char path[64], name[32] = {};
+                std::snprintf(path, sizeof path, "/proc/self/task/%d/comm", tid);
+                if (FILE *f = std::fopen(path, "r")) { if (!std::fgets(name, sizeof name, f)) name[0] = 0; std::fclose(f); }
+                if (!std::strncmp(name, "GameThread", 10) || !std::strncmp(name, "GsThread", 8) || !std::strncmp(name, "PS2Thread", 9))
+                    t.push_back(tid);
+            }
+            closedir(d);
+        }
+        return t;
+    }
+
+    struct Hint
+    {
+        bool tried = false;
+        APerformanceHintSession *session = nullptr;
+        UpdateTargetFn update = nullptr;
+        ReportFn report = nullptr;
+        SetThreadsFn setThreads = nullptr;
+        uint32_t frames = 0;
+        size_t nThreads = 0;
+        int64_t target = 0, lastCpu = 0, lastWall = 0;
+        double slowFor = 0.0, fastFor = 0.0, sinceChange = 0.0;   // [dynres] seconds behind / with room / since the last step
+        double workAvg = 0.0, workBeforeStep = 0.0, holdFor = 0.0; bool checkAfterStep = false;   // [dynres] did the step help?
+    };
+    thread_local Hint t_hint;   // only the guest thread reports
+
+    int64_t nowNs(clockid_t c)
+    {
+        timespec t;
+        clock_gettime(c, &t);
+        return int64_t(t.tv_sec) * 1000000000LL + t.tv_nsec;
+    }
+}
+
+extern "C" void ps2xAndroidFrameHint(uint64_t pacingWaitNs, bool fps60)
+{
+    Hint &h = t_hint;
+    const int64_t cpu = nowNs(CLOCK_THREAD_CPUTIME_ID), wall = nowNs(CLOCK_MONOTONIC);
+    if (!h.tried)
+    {
+        h.tried = true;
+        h.lastCpu = cpu; h.lastWall = wall;
+        h.target = 16666667;   // the frame budget (dynres needs it with or without ADPF)
+        const char *v = std::getenv("PS2X_ADPF");
+        if (v && v[0] == '0') return;
+        void *lib = dlopen("libandroid.so", RTLD_NOW);
+        auto getManager = lib ? reinterpret_cast<GetManagerFn>(dlsym(lib, "APerformanceHint_getManager")) : nullptr;
+        auto create = lib ? reinterpret_cast<CreateSessionFn>(dlsym(lib, "APerformanceHint_createSession")) : nullptr;
+        h.update = lib ? reinterpret_cast<UpdateTargetFn>(dlsym(lib, "APerformanceHint_updateTargetWorkDuration")) : nullptr;
+        h.report = lib ? reinterpret_cast<ReportFn>(dlsym(lib, "APerformanceHint_reportActualWorkDuration")) : nullptr;
+        h.setThreads = lib ? reinterpret_cast<SetThreadsFn>(dlsym(lib, "APerformanceHint_setThreads")) : nullptr;   // API 34
+        APerformanceHintManager *m = getManager ? getManager() : nullptr;
+        h.target = 16666667;
+        if (!m || !create || !h.update || !h.report)
+        {
+            std::fprintf(stderr, "[adpf] not available on this system\n");
+            return;
+        }
+        const std::vector<int32_t> tids = gameThreads(gettid(), g_ps2xSdlMainTid);
+        h.target = 16666667;
+        h.session = create(m, tids.data(), tids.size(), h.target);
+        h.nThreads = tids.size();
+        std::fprintf(stderr, "[adpf] session %s (%zu threads)\n", h.session ? "on" : "refused", tids.size());
+        return;
+    }
+    if (h.session && h.setThreads && (++h.frames % 300u) == 0u)
+    {   // threads the game started since (the renderer's, a mode's helpers)
+        const std::vector<int32_t> tids = gameThreads(gettid(), g_ps2xSdlMainTid);
+        if (tids.size() != h.nThreads && h.setThreads(h.session, reinterpret_cast<const pid_t *>(tids.data()), tids.size()) == 0)
+        {
+            std::fprintf(stderr, "[adpf] session now %zu threads\n", tids.size());
+            h.nThreads = tids.size();
+        }
+    }
+    const int64_t dt = wall - h.lastWall;
+    h.lastCpu = cpu; h.lastWall = wall;
+    if (dt <= 0 || dt > 200000000LL) return;   // a pause (loading, the app in the background): not a frame
+    const int64_t want = fps60 ? 16666667 : 33333333;   // the frame step the game runs (its 60 fps mode or the PS2's 30)
+    if (want != h.target) { h.target = want; if (h.session) h.update(h.session, want); }
+    const int64_t work = dt - int64_t(pacingWaitNs);
+    if (work > 0 && h.session) h.report(h.session, work);
+    {   // [dynres] behind for ~1 s: one step down; with room for 5 s: one step up; at most one step every 2 s
+        static const bool s_on = [](){ const char *v = std::getenv("PS2X_DYNRES"); return !(v && v[0] == '0'); }();
+        if (s_on)
+        {
+            const double sec = double(dt) * 1e-9, ratio = double(work) / double(h.target);
+            h.sinceChange += sec;
+            if (ratio > 1.08) { h.slowFor += sec; h.fastFor = 0.0; }
+            else if (ratio < 0.85) { h.fastFor += sec; h.slowFor = 0.0; }
+            else { h.slowFor = 0.0; h.fastFor = 0.0; }
+            // A step down that did not make the frames faster means the GPU is not what is slow (a CPU-bound phone, a
+            // throttled one): the step is undone and the resolution stays for 30 s -- giving up image for nothing helps nobody.
+            h.workAvg = h.workAvg > 0.0 ? h.workAvg * 0.95 + double(work) * 0.05 : double(work);
+            float r = g_dynRes.load(std::memory_order_relaxed);
+            if (h.checkAfterStep && h.sinceChange > 2.0)
+            {
+                h.checkAfterStep = false;
+                if (h.workAvg > h.workBeforeStep * 0.95 && r < 1.0f)
+                {
+                    r = std::min(1.0f, r + 0.1f); h.holdFor = 30.0; h.sinceChange = h.slowFor = h.fastFor = 0.0;
+                    g_dynRes.store(r, std::memory_order_relaxed);
+                    std::fprintf(stderr, "[dynres] no faster at a lower output: back to %.0f%%, held 30 s\n", r * 100.0f);
+                }
+            }
+            h.holdFor = std::max(0.0, h.holdFor - sec);
+            if (h.sinceChange > 2.0 && h.slowFor > 1.0 && r > 0.6f && h.holdFor <= 0.0)
+            {
+                h.workBeforeStep = h.workAvg; h.checkAfterStep = true;
+                r = std::max(0.6f, r - 0.1f); h.sinceChange = h.slowFor = 0.0;
+            }
+            else if (h.sinceChange > 2.0 && h.fastFor > 5.0 && r < 1.0f) { r = std::min(1.0f, r + 0.1f); h.sinceChange = h.fastFor = 0.0; }
+            else r = -1.0f;
+            if (r > 0.0f) { g_dynRes.store(r, std::memory_order_relaxed); std::fprintf(stderr, "[dynres] upscaler output %.0f%%\n", r * 100.0f); }
+        }
+    }
+}
diff -ruN a/ps2xRuntime/android/touch_pad.cpp b/ps2xRuntime/android/touch_pad.cpp
--- a/ps2xRuntime/android/touch_pad.cpp	1969-12-31 18:00:00
+++ b/ps2xRuntime/android/touch_pad.cpp	2026-10-26 17:04:02
@@ -0,0 +1,245 @@
+// [android] On-screen touch controls: a floating left stick, the D-pad, the four face buttons, L1/L2/R1/R2, L3/R3,
+// Select/Start and a menu button (the settings overlay). Fingers arrive as SDL touch events (an event watch, so nothing
+// is consumed); pad_config's poll() ORs the result into player 1's packet; the settings overlay draws the layout with
+// ImGui. The controls hide while a game controller is connected and come back at the next touch.
+#include <SDL.h>
+#include "imgui.h"
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+namespace
+{
+    // PadAction order (= the PS2 button bit order): bit i of the mask is PadAction i.
+    enum Btn : int { Select = 0, L3, R3, Start, Up, Right, Down, Left, L2, R2, L1, R1, Triangle, Circle, Cross, Square, Menu = 16 };
+
+    struct Shape { int btn; float x, y, r; bool rect; float w, h; const char *label; };
+
+    struct Finger { SDL_FingerID id = 0; bool used = false; bool stick = false; int btn = -1; float ox = 0, oy = 0; uint32_t t0 = 0; };
+    uint32_t g_hold[16] = {};   // [minpress] a button stays down until this SDL tick: a tap shorter than a frame still registers
+
+    std::mutex g_m;
+    Finger g_f[10];
+    float g_lx = 0.0f, g_ly = 0.0f;
+    float g_stickX = -1.0f, g_stickY = -1.0f;   // the floating stick's origin while held (pixels), -1 = at rest
+    uint32_t g_mask = 0;
+    std::atomic<bool> g_menuEdge{false};
+    std::atomic<bool> g_visible{true};
+    std::atomic<int> g_w{0}, g_h{0};
+    bool g_watching = false;
+
+    // Layout in pixels for a W x H landscape screen; sizes scale with H. The top band (~14% of the height) is the game's
+    // HUD (health, ki, the timer): nothing goes there. Shoulders under it at the sides, Select / menu / Start and L3 / R3
+    // along the bottom edge, the D-pad and the stick on the left, the face buttons on the right.
+    int layout(Shape *s, float W, float H)
+    {
+        int n = 0;
+        const float r = 0.075f * H, d = 0.145f * H;
+        const float fx = W - 0.30f * H, fy = H - 0.30f * H;   // face buttons
+        s[n++] = {Triangle, fx, fy - d, r, false, 0, 0, ""};
+        s[n++] = {Cross, fx, fy + d, r, false, 0, 0, ""};
+        s[n++] = {Square, fx - d, fy, r, false, 0, 0, ""};
+        s[n++] = {Circle, fx + d, fy, r, false, 0, 0, ""};
+        const float px = 0.26f * H, py = 0.47f * H, pd = 0.09f * H, pr = 0.058f * H;   // D-pad
+        s[n++] = {Up, px, py - pd, pr, false, 0, 0, ""};
+        s[n++] = {Down, px, py + pd, pr, false, 0, 0, ""};
+        s[n++] = {Left, px - pd, py, pr, false, 0, 0, ""};
+        s[n++] = {Right, px + pd, py, pr, false, 0, 0, ""};
+        const float sw = 0.20f * H, sh = 0.075f * H, m = 0.03f * H, top = 0.16f * H;   // shoulders, under the HUD
+        s[n++] = {L2, m + sw * 0.5f, top + sh * 0.5f, 0, true, sw, sh, "L2"};
+        s[n++] = {L1, m + sw * 0.5f, top + m + sh * 1.5f, 0, true, sw, sh, "L1"};
+        s[n++] = {R2, W - m - sw * 0.5f, top + sh * 0.5f, 0, true, sw, sh, "R2"};
+        s[n++] = {R1, W - m - sw * 0.5f, top + m + sh * 1.5f, 0, true, sw, sh, "R1"};
+        const float tw = 0.15f * H, th = 0.065f * H, by = H - m - th * 0.5f;   // the bottom row
+        s[n++] = {Select, W * 0.5f - 0.20f * H, by, 0, true, tw, th, "SELECT"};
+        s[n++] = {Menu, W * 0.5f, by, 0, true, tw * 0.7f, th, ""};
+        s[n++] = {Start, W * 0.5f + 0.20f * H, by, 0, true, tw, th, "START"};
+        s[n++] = {L3, W * 0.5f - 0.40f * H, by, 0, true, tw * 0.8f, th, "L3"};
+        s[n++] = {R3, W * 0.5f + 0.40f * H, by, 0, true, tw * 0.8f, th, "R3"};
+        return n;
+    }
+
+    bool inStickZone(float x, float y, float W, float H) { return x < W * 0.40f && y > H * 0.58f; }
+
+    int hit(float x, float y, float W, float H)
+    {
+        Shape s[24];
+        const int n = layout(s, W, H);
+        int best = -1; float bestD = 1e9f;
+        for (int i = 0; i < n; ++i)
+        {
+            if (s[i].rect)
+            {
+                if (std::fabs(x - s[i].x) <= s[i].w * 0.5f + 0.02f * H && std::fabs(y - s[i].y) <= s[i].h * 0.5f + 0.02f * H) return s[i].btn;
+                continue;
+            }
+            const float dd = std::hypot(x - s[i].x, y - s[i].y);
+            if (dd <= s[i].r * 1.35f && dd < bestD) { bestD = dd; best = s[i].btn; }   // a generous target: thumbs are wide
+        }
+        return best;
+    }
+
+    void recompute()
+    {
+        const float W = float(g_w.load()), H = float(g_h.load());
+        uint32_t mask = 0;
+        float lx = 0, ly = 0;
+        bool stick = false;
+        for (const Finger &f : g_f)
+        {
+            if (!f.used) continue;
+            if (f.stick)
+            {
+                stick = true;
+                const float R = 0.13f * H;
+                float dx = (f.ox - g_stickX) / R, dy = (f.oy - g_stickY) / R;
+                const float len = std::hypot(dx, dy);
+                if (len > 1.0f) { dx /= len; dy /= len; }
+                if (len < 0.15f) { dx = 0; dy = 0; }
+                lx = dx; ly = dy;
+            }
+            else if (f.btn >= 0 && f.btn < 16) mask |= 1u << f.btn;
+        }
+        if (!stick) { g_stickX = -1.0f; g_stickY = -1.0f; }
+        g_mask = mask; g_lx = lx; g_ly = ly;
+    }
+
+    int watch(void *, SDL_Event *e)
+    {
+        if (e->type == SDL_CONTROLLERDEVICEADDED) { g_visible = false; return 0; }
+        if (e->type != SDL_FINGERDOWN && e->type != SDL_FINGERUP && e->type != SDL_FINGERMOTION) return 0;
+        const float W = float(g_w.load()), H = float(g_h.load());
+        if (W <= 0 || H <= 0) return 0;
+        const float x = e->tfinger.x * W, y = e->tfinger.y * H;
+        std::lock_guard<std::mutex> lk(g_m);
+        if (e->type == SDL_FINGERDOWN)
+        {
+            g_visible = true;
+            Finger *f = nullptr;
+            for (Finger &c : g_f) if (!c.used) { f = &c; break; }
+            if (!f) return 0;
+            *f = Finger{};
+            f->used = true; f->id = e->tfinger.fingerId; f->ox = x; f->oy = y; f->t0 = SDL_GetTicks();
+            f->btn = hit(x, y, W, H);
+            if (f->btn == Menu) { g_menuEdge = true; f->btn = -1; }
+            else if (f->btn < 0 && inStickZone(x, y, W, H) && g_stickX < 0) { f->stick = true; g_stickX = x; g_stickY = y; }
+        }
+        else
+        {
+            for (Finger &f : g_f)
+            {
+                if (!f.used || f.id != e->tfinger.fingerId) continue;
+                if (e->type == SDL_FINGERUP)
+                {
+                    if (f.btn >= 0 && f.btn < 16) g_hold[f.btn] = f.t0 + 70u;
+                    f.used = false;
+                    break;
+                }
+                f.ox = x; f.oy = y;
+                if (!f.stick)
+                {   // sliding between buttons follows the thumb (a roll from Square to Cross, ...)
+                    const int b = hit(x, y, W, H);
+                    if (b >= 0 && b < 16) f.btn = b;
+                }
+                break;
+            }
+        }
+        recompute();
+        return 0;
+    }
+}
+
+// The state for player 1: a mask of PadAction bits 0..15 and the left stick in -1..1. False while hidden.
+extern "C" bool ps2xTouchState(uint32_t *mask, float *lx, float *ly)
+{
+    if (!g_watching || !g_visible.load()) return false;
+    std::lock_guard<std::mutex> lk(g_m);
+    uint32_t m = g_mask;
+    const uint32_t now = SDL_GetTicks();
+    for (int b = 0; b < 16; ++b) if (g_hold[b] && SDL_TICKS_PASSED(g_hold[b], now) == 0) m |= 1u << b; else g_hold[b] = 0;
+    *mask = m; *lx = g_lx; *ly = g_ly;
+    return true;
+}
+
+extern "C" bool ps2xTouchVisible() { return g_visible.load(); }
+
+// One tap of the menu button since the last call (the overlay toggles its panel).
+extern "C" bool ps2xTouchTakeMenu() { return g_menuEdge.exchange(false); }
+
+// Inside an ImGui frame: the layout on the foreground draw list, pressed buttons brighter.
+extern "C" void ps2xTouchDraw()
+{
+    if (!g_watching)
+    {
+        SDL_AddEventWatch(&watch, nullptr);
+        g_watching = true;
+        // a controller connected before the game started sent its "added" event before this watch existed: hide now
+        for (int i = 0; i < SDL_NumJoysticks(); ++i)
+            if (SDL_IsGameController(i)) { g_visible = false; break; }
+    }
+    const ImVec2 ds = ImGui::GetIO().DisplaySize;
+    const float fbx = ImGui::GetIO().DisplayFramebufferScale.x > 0 ? ImGui::GetIO().DisplayFramebufferScale.x : 1.0f;
+    (void)fbx;
+    // Touch coordinates are normalized to the window: track it in the same logical units ImGui draws in.
+    g_w = int(ds.x); g_h = int(ds.y);
+    if (!g_visible.load() || ds.x <= 0 || ds.y <= 0) return;
+    uint32_t mask; float sx, sy;
+    {
+        std::lock_guard<std::mutex> lk(g_m);
+        mask = g_mask; sx = g_stickX; sy = g_stickY;
+    }
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    const float W = ds.x, H = ds.y;
+    const ImU32 fill = IM_COL32(255, 255, 255, 38), fillOn = IM_COL32(255, 200, 60, 110), edge = IM_COL32(255, 255, 255, 90),
+                text = IM_COL32(255, 255, 255, 170);
+    Shape s[24];
+    const int n = layout(s, W, H);
+    for (int i = 0; i < n; ++i)
+    {
+        const bool on = s[i].btn < 16 && (mask >> s[i].btn) & 1u;
+        if (s[i].rect)
+        {
+            const ImVec2 a(s[i].x - s[i].w * 0.5f, s[i].y - s[i].h * 0.5f), b(s[i].x + s[i].w * 0.5f, s[i].y + s[i].h * 0.5f);
+            dl->AddRectFilled(a, b, on ? fillOn : fill, s[i].h * 0.5f);
+            dl->AddRect(a, b, edge, s[i].h * 0.5f, 0, 2.0f);
+        }
+        else
+        {
+            dl->AddCircleFilled(ImVec2(s[i].x, s[i].y), s[i].r, on ? fillOn : fill, 32);
+            dl->AddCircle(ImVec2(s[i].x, s[i].y), s[i].r, edge, 32, 2.0f);
+        }
+        {   // the PlayStation symbols and arrows as shapes (the overlay fonts have no such glyphs)
+            const float cx = s[i].x, cy = s[i].y, g = (s[i].rect ? s[i].h : s[i].r) * 0.42f, t = 2.5f;
+            const ImU32 c = text;
+            switch (s[i].btn)
+            {
+            case Triangle: dl->AddTriangle(ImVec2(cx, cy - g), ImVec2(cx - g * 1.05f, cy + g * 0.75f), ImVec2(cx + g * 1.05f, cy + g * 0.75f), IM_COL32(120, 230, 190, 220), t); break;
+            case Circle: dl->AddCircle(ImVec2(cx, cy), g, IM_COL32(240, 110, 110, 220), 24, t); break;
+            case Square: dl->AddRect(ImVec2(cx - g * 0.8f, cy - g * 0.8f), ImVec2(cx + g * 0.8f, cy + g * 0.8f), IM_COL32(230, 150, 220, 220), 0, 0, t); break;
+            case Cross: dl->AddLine(ImVec2(cx - g, cy - g), ImVec2(cx + g, cy + g), IM_COL32(130, 170, 250, 220), t);
+                        dl->AddLine(ImVec2(cx - g, cy + g), ImVec2(cx + g, cy - g), IM_COL32(130, 170, 250, 220), t); break;
+            case Up: dl->AddTriangleFilled(ImVec2(cx, cy - g), ImVec2(cx - g, cy + g * 0.6f), ImVec2(cx + g, cy + g * 0.6f), c); break;
+            case Down: dl->AddTriangleFilled(ImVec2(cx, cy + g), ImVec2(cx + g, cy - g * 0.6f), ImVec2(cx - g, cy - g * 0.6f), c); break;
+            case Left: dl->AddTriangleFilled(ImVec2(cx - g, cy), ImVec2(cx + g * 0.6f, cy + g), ImVec2(cx + g * 0.6f, cy - g), c); break;
+            case Right: dl->AddTriangleFilled(ImVec2(cx + g, cy), ImVec2(cx - g * 0.6f, cy - g), ImVec2(cx - g * 0.6f, cy + g), c); break;
+            case Menu: for (int k = -1; k <= 1; ++k) dl->AddLine(ImVec2(cx - g, cy + k * g * 0.6f), ImVec2(cx + g, cy + k * g * 0.6f), c, t); break;
+            default: break;
+            }
+        }
+        if (!s[i].label[0]) continue;
+        const float fs = (s[i].rect ? s[i].h * 0.5f : s[i].r * 0.8f);
+        ImFont *font = ImGui::GetFont();
+        const ImVec2 ts = font->CalcTextSizeA(fs, 1e9f, 0.0f, s[i].label);
+        dl->AddText(font, fs, ImVec2(s[i].x - ts.x * 0.5f, s[i].y - ts.y * 0.5f), text, s[i].label);
+    }
+    // The stick: its base where the thumb landed (or at rest), the knob at the deflection.
+    const float R = 0.13f * H;
+    const float bx = sx >= 0 ? sx : 0.40f * H, by = sx >= 0 ? sy : H - 0.25f * H;
+    float lx, ly;
+    { std::lock_guard<std::mutex> lk(g_m); lx = g_lx; ly = g_ly; }
+    dl->AddCircleFilled(ImVec2(bx, by), R, IM_COL32(255, 255, 255, 25), 48);
+    dl->AddCircle(ImVec2(bx, by), R, edge, 48, 2.0f);
+    dl->AddCircleFilled(ImVec2(bx + lx * R, by + ly * R), R * 0.45f, sx >= 0 ? fillOn : IM_COL32(255, 255, 255, 60), 32);
+}
