new file mode 100644
index 0000000..b2b901d
--- /dev/null
+++ b/games/bt3/bt4mod/bt4mod_maps.py
@@ -0,0 +1,278 @@
+#!/usr/bin/env python3
+"""[BT4-mod] Function maps for the "BT4 Beta 14 Rev2" mod of BT3 USA (SLUS_219.78 on its disc).
+
+The mod binary-patches the USA ELF in place (same layout, same entry) and APPENDS ~6 KB of code to
+DBZP.BIN right after the USA overlay (0x3BE720..0x3C01D4). It wires that code in with ~70 `j` hooks
+in the main ELF (and more in the overlay) that jump into the appended block, which jumps back into
+the MIDDLE of the hooked functions. The USA maps know none of this:
+
+  * the appended block has no rows        -> overlay rows from bt4mod_ghidra_rows.csv (region=tail),
+                                             a Ghidra map made for the mod's own binaries;
+  * the return targets are mid-function   -> `entry_points` hints (resume entries of the owner);
+  * a few main-ELF functions are new      -> rows from bt4mod_ghidra_rows.csv (region=main) that
+                                             lie outside every USA row.
+
+Usage: bt4mod_maps.py <ELF> <DBZP.BIN> <out_dir>
+Writes: functions_bt4mod.csv, dbzp_funcs_bt4mod.csv, entry_points_main.txt, entry_points_overlay.txt
+"""
+import bisect
+import csv
+import struct
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+BT3 = HERE.parent
+OV_BASE = 0x334C00
+TAIL = 0x3BE720
+MAIN_CODE = (0x100000, 0x2C3400)
+
+# A word only the mod has: `j 0x3bee20` (hook into the appended block) at 0x1133f4.
+MOD_SIG_ADDR, MOD_SIG_WORD = 0x1133F4, 0x080EFB88
+
+
+def elf_words(path: Path) -> dict:
+    data = path.read_bytes()
+    phoff, = struct.unpack_from("<I", data, 28)
+    phentsize, phnum = struct.unpack_from("<HH", data, 42)
+    words = {}
+    for i in range(phnum):
+        p_type, p_off, p_vaddr, _, p_filesz = struct.unpack_from("<IIIII", data, phoff + i * phentsize)
+        if p_type != 1:
+            continue
+        for j in range(0, p_filesz & ~3, 4):
+            words[p_vaddr + j] = struct.unpack_from("<I", data, p_off + j)[0]
+    return words
+
+
+def is_bt4mod(elf: Path) -> bool:
+    return elf_words(elf).get(MOD_SIG_ADDR) == MOD_SIG_WORD
+
+
+def static_targets(words: dict, lo: int, hi: int):
+    """(source, target) of every j/jal in [lo, hi)."""
+    for a in range(lo, hi, 4):
+        w = words.get(a)
+        if w is None:
+            continue
+        if (w >> 26) in (2, 3):
+            yield a, ((a + 4) & 0xF0000000) | ((w & 0x03FFFFFF) << 2)
+
+
+def branch_info(w: int, a: int):
+    """(has_delay_slot, static_targets, is_unconditional_jump) of the word at a."""
+    op = w >> 26
+    if op in (2, 3):
+        t = ((a + 4) & 0xF0000000) | ((w & 0x03FFFFFF) << 2)
+        return True, [t], op == 2
+    if op == 0 and (w & 0x3F) in (8, 9):            # jr / jalr
+        return True, [], (w & 0x3F) == 8
+    off = ((w & 0xFFFF) ^ 0x8000) - 0x8000
+    tgt = a + 4 + (off << 2)
+    if op in (4, 5, 6, 7, 0x14, 0x15, 0x16, 0x17):   # beq bne blez bgtz (+likely)
+        uncond = op == 4 and ((w >> 16) & 31) == 0 and ((w >> 21) & 31) == 0
+        return True, [tgt], uncond
+    if op == 1 and ((w >> 16) & 31) in (0, 1, 2, 3, 0x10, 0x11, 0x12, 0x13):
+        return True, [tgt], False
+    if op == 0x11 and ((w >> 21) & 31) == 8:        # bc1f/bc1t(+l)
+        return True, [tgt], False
+    return False, [], False
+
+
+def cover_uncovered(words: dict, spans: list, lo: int, hi: int, prefix: str) -> list:
+    """[BT4-mod] Rows for code the USA map does not cover but this binary reaches: the address a row
+    runs off its end into, and branch/jump targets, when no row contains them. Each new row runs to
+    the next row start. Repeats until nothing new turns up."""
+    new_rows = []
+    while True:
+        spans.sort()
+        starts = [s for s, _ in spans]
+
+        def covered(a):
+            i = bisect.bisect_right(starts, a) - 1
+            # any row containing a (rows overlap: scan back a little)
+            for k in range(i, max(-1, i - 64), -1):
+                if spans[k][0] <= a < spans[k][1]:
+                    return True
+            return False
+
+        want = set()
+        for s, e in spans:
+            if not (lo <= s < hi):
+                continue
+            last = e - 4
+            w = words.get(last)
+            if w is None:
+                continue
+            ds, _, _ = branch_info(w, last)
+            want.add(e + 4 if ds else e)
+            prev = words.get(last - 4)
+            if prev is not None:
+                pds, _, puncond = branch_info(prev, last - 4)
+                if pds and not puncond:
+                    want.add(e)               # a conditional branch + delay slot: falls to e
+            for a in range(s, e, 4):
+                ww = words.get(a)
+                if ww is None:
+                    continue
+                for t in branch_info(ww, a)[1]:
+                    want.add(t)
+        added = []
+        for t in sorted(want):
+            if not (lo <= t < hi) or (t & 3) or covered(t) or words.get(t, 0) == 0:
+                continue
+            i = bisect.bisect_right(starts, t)
+            end = starts[i] if i < len(starts) else hi
+            end = min(end, t + 0x4000)
+            if end > t and not any(a[0] <= t < a[1] for a in added):
+                added.append((t, end))
+        if not added:
+            return new_rows
+        spans.extend(added)
+        new_rows.extend(added)
+
+
+def read_rows(path: Path, s_key: str, e_key: str):
+    with open(path) as f:
+        return [(r, int(r[s_key], 16), int(r[e_key], 16)) for r in csv.DictReader(f)]
+
+
+def main() -> None:
+    elf, dbzp, out = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
+    out.mkdir(parents=True, exist_ok=True)
+    words = elf_words(elf)
+    code = dbzp.read_bytes()
+    ov_end = OV_BASE + len(code)
+    for i in range(0, len(code) & ~3, 4):
+        words[OV_BASE + i] = struct.unpack_from("<I", code, i)[0]
+
+    extra = list(csv.DictReader(open(HERE / "bt4mod_ghidra_rows.csv")))
+    # region: tail = rows of the appended block, main = mod functions outside every USA row,
+    # start = every Ghidra function start of the mod binaries (entry hints where a USA row hides them)
+
+    # ---- overlay: USA rows + the appended block (rows clipped so they do not overlap) ----
+    ov_rows = read_rows(BT3 / "dbzp_funcs.csv", "start", "end")
+    tail = sorted({int(r["start"], 16): int(r["end"], 16) for r in extra if r["region"] == "tail"}.items())
+    tail_rows = []
+    for k, (s, e) in enumerate(tail):
+        nxt = tail[k + 1][0] if k + 1 < len(tail) else ov_end
+        e = min(max(e, s + 4), nxt, ov_end)
+        tail_rows.append((s, e))
+    ov_spans = [(s, e) for _, s, e in ov_rows] + list(tail_rows)
+    for name in ("dbzp_gaps.csv", "dbzp_missing.csv"):
+        ov_spans += [(s, e) for _, s, e in read_rows(BT3 / name, "start", "end")]
+    ov_cover = cover_uncovered(words, ov_spans, OV_BASE, ov_end, "ov")
+    tail_rows = sorted(set(tail_rows) | set(ov_cover))
+    with open(out / "dbzp_funcs_bt4mod.csv", "w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["name", "start", "end", "size"])
+        for r, s, e in ov_rows:
+            w.writerow([r["name"], r["start"], r["end"], r["size"]])
+        for s, e in tail_rows:
+            w.writerow([f"f_{s:x}", f"0x{s:x}", f"0x{e:x}", e - s])
+
+    ov_starts = {s for _, s, _ in ov_rows} | {s for s, _ in tail_rows}
+    for name in ("dbzp_gaps.csv", "dbzp_missing.csv"):
+        ov_starts |= {s for _, s, _ in read_rows(BT3 / name, "start", "end")}
+
+    # ---- main: USA rows + mod functions outside every USA row ----
+    main_rows = read_rows(BT3 / "functions.csv", "Start", "End")
+    spans = sorted((s, e) for _, s, e in main_rows)
+    span_starts = [s for s, _ in spans]
+
+    def in_usa_row(a: int) -> bool:
+        i = bisect.bisect_right(span_starts, a) - 1
+        return i >= 0 and spans[i][0] <= a < spans[i][1]
+
+    new_main = []
+    for r in extra:
+        s, e = int(r["start"], 16), int(r["end"], 16)
+        if r["region"] == "main" and not in_usa_row(s):
+            i = bisect.bisect_right(span_starts, s)
+            if i < len(span_starts):
+                e = min(e, span_starts[i])   # stop at the next USA row
+            if e > s:
+                new_main.append((s, e))
+    cover = cover_uncovered(words, spans + list(new_main), MAIN_CODE[0], MAIN_CODE[1], "main")
+    new_main = sorted(set(new_main) | set(cover))
+    with open(BT3 / "functions.csv") as f:
+        src = f.read()
+    with open(out / "functions_bt4mod.csv", "w", newline="") as f:
+        f.write(src if src.endswith("\n") else src + "\n")
+        w = csv.writer(f)
+        for s, e in new_main:
+            w.writerow([f"bt4mod_{s:08x}", f"0x{s:08X}", f"0x{e:08X}", e - s])
+    main_starts = {s for _, s, _ in main_rows} | {s for s, _ in new_main}
+
+    # ---- entry hints: cross-module (and mod-block) jumps into the middle of a function ----
+    main_hints, ov_hints = set(), set()
+    sources = [(OV_BASE, ov_end), MAIN_CODE]
+    for lo, hi in sources:
+        for src_pc, t in static_targets(words, lo, hi):
+            from_mod_block = src_pc >= TAIL and src_pc < ov_end
+            if MAIN_CODE[0] <= t < MAIN_CODE[1]:
+                # overlay -> main: invisible to the main recompile. main -> main is found by it.
+                if lo == OV_BASE and t not in main_starts:
+                    main_hints.add(t)
+            elif OV_BASE <= t < ov_end:
+                # main -> overlay is invisible to the overlay recompile; the mod block's own
+                # jumps back into USA overlay code are mid-function returns.
+                if (lo != OV_BASE or from_mod_block or t >= TAIL) and t not in ov_starts:
+                    ov_hints.add(t)
+    # Any static branch/jump whose target is in a DIFFERENT row than its source (and not a row start):
+    # a back-edge from a gap block into the function it was cut from, a hook returning mid-function, ...
+    # The recompiler only sees targets inside the module it is compiling.
+    def cross_row_hints(rows_spans, lo, hi, starts, hints):
+        rs = sorted(rows_spans)
+        st = [a for a, _ in rs]
+
+        def rows_of(a):
+            i = bisect.bisect_right(st, a) - 1
+            return [(s0, e0) for s0, e0 in rs[max(0, i - 64):i + 1] if s0 <= a < e0]
+
+        for s0, e0 in rs:
+            if not (lo <= s0 < hi):
+                continue
+            for a in range(s0, e0, 4):
+                w = words.get(a)
+                if w is None:
+                    continue
+                for t in branch_info(w, a)[1]:
+                    if lo <= t < hi and t not in starts and not (s0 <= t < e0):
+                        hints.add(t)
+
+    cross_row_hints([(s, e) for _, s, e in main_rows] + list(new_main), MAIN_CODE[0], MAIN_CODE[1],
+                    main_starts, main_hints)
+    ov_all = [(s, e) for _, s, e in ov_rows] + list(tail_rows)
+    for name in ("dbzp_gaps.csv", "dbzp_missing.csv"):
+        ov_all += [(s, e) for _, s, e in read_rows(BT3 / name, "start", "end")]
+    cross_row_hints(ov_all, OV_BASE, ov_end, ov_starts, ov_hints)
+
+    # Words in the main ELF's data that point into the overlay: jump tables the mod re-pointed at its
+    # own code (seen: case 7 of the table at 0x272148 -> 0x36c930, inside the USA gap block f_36c610).
+    for a in range(MAIN_CODE[1], max(words) + 4, 4):
+        t = words.get(a)
+        if t is not None and OV_BASE <= t < ov_end and not (t & 3) and t not in ov_starts:
+            ov_hints.add(t)
+
+    # Every function start of the mod's own map that lies INSIDE a USA row: the mod moved/added code
+    # there (seen: 0x36ca30 and 0x36ca6c are called as functions, but sit in the USA gap block
+    # f_36c610, which then ran from its top). Each becomes a resume entry of its USA owner.
+    for r in extra:
+        if r["region"] != "start":
+            continue
+        t = int(r["start"], 16)
+        if MAIN_CODE[0] <= t < MAIN_CODE[1]:
+            if t not in main_starts:
+                main_hints.add(t)
+        elif OV_BASE <= t < TAIL and t not in ov_starts:
+            ov_hints.add(t)
+    (out / "entry_points_main.txt").write_text("".join(f"0x{t:08x}\n" for t in sorted(main_hints)))
+    (out / "entry_points_overlay.txt").write_text("".join(f"0x{t:08x}\n" for t in sorted(ov_hints)))
+    print(f"[bt4mod] overlay rows +{len(tail_rows)} (incl. {len(ov_cover)} uncovered), main rows +{len(new_main)} "
+          f"(incl. {len(cover)} uncovered), "
+          f"entry hints main {len(main_hints)} overlay {len(ov_hints)}")
+
+
+if __name__ == "__main__":
+    main()
