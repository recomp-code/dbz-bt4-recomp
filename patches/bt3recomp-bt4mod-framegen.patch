diff --git a/ps2xRuntime/src/lib/seamvk/fgmid.frag b/ps2xRuntime/src/lib/seamvk/fgmid.frag
new file mode 100644
index 0000000..40905a4
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/fgmid.frag
@@ -0,0 +1,22 @@
+#version 450
+// [framegen] The frame halfway between the previous presented frame and this one, from the game's real motion vectors
+// (the composed frame's motion, current + mv = previous, in composed pixels). A pixel that did not change (the HUD, the
+// sky, a still picture) is the current one as is; a moving one is fetched where its surface is now and where it was,
+// half a vector each way, and the two are averaged when they agree (else the newer one: a surface that was hidden).
+layout(push_constant) uniform PCP { vec4 src; vec4 dst; vec4 alpha; vec4 taps; } pc;   // taps.xy = 1 / composed size
+layout(set = 0, binding = 0) uniform sampler2D uCur;
+layout(set = 0, binding = 1) uniform sampler2D uPrev;
+layout(set = 0, binding = 2) uniform sampler2D uMv;
+layout(location = 0) in vec2 vUv;
+layout(location = 0) out vec4 oColor;
+void main()
+{
+    vec3 c = textureLod(uCur, vUv, 0.0).rgb, p = textureLod(uPrev, vUv, 0.0).rgb;
+    vec3 d = abs(c - p);
+    if (max(d.r, max(d.g, d.b)) < 2.0 / 255.0) { oColor = vec4(c, 1.0); return; }
+    vec2 mv = textureLod(uMv, vUv, 0.0).rg * pc.taps.xy;   // in uv units
+    vec3 a = textureLod(uCur, vUv - 0.5 * mv, 0.0).rgb;
+    vec3 b = textureLod(uPrev, vUv + 0.5 * mv, 0.0).rgb;
+    vec3 e = abs(a - b);
+    oColor = vec4(max(e.r, max(e.g, e.b)) < 0.15 ? mix(a, b, 0.5) : a, 1.0);
+}
