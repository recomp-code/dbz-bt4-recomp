+		std::memcpy(&pmode, h.privRegs.data() + 0x00, 8);
+		std::memcpy(&dispfb1, h.privRegs.data() + 0x70, 8);
+		std::memcpy(&display1, h.privRegs.data() + 0x80, 8);
+		std::printf("[webgs] 2s: draws %llu, PMODE %llx DISPFB1 %llx DISPLAY1 %llx\n", (unsigned long long)h.drawCalls,
+		            (unsigned long long)pmode, (unsigned long long)dispfb1, (unsigned long long)display1);
+		h.drawCalls = 0;
+		{
+			// What is on screen: flips, GS RAM where DISPFB1 points, and the canvas centre.
+			const uint32_t fbp = static_cast<uint32_t>(dispfb1 & 0x1FF) * 8192u;
+			const uint8* gsRam = h.gs->GetRam();
+			uint64_t nonzero = 0, sum = 0;
+			for(uint32_t i = 0; i < 640u * 448u * 4u && fbp + i < 4u * 1024u * 1024u; i += 4)
+			{
+				const uint32_t v = gsRam[fbp + i] | (gsRam[fbp + i + 1] << 8) | (gsRam[fbp + i + 2] << 16);
+				nonzero += v != 0;
+				sum += v;
+			}
+			uint64_t ramNonzero = 0;
+			uint32_t firstNz = 0xFFFFFFFF, lastNz = 0;
+			for(uint32_t i = 0; i < 4u * 1024u * 1024u; i += 4)
+			{
+				if(*reinterpret_cast<const uint32_t*>(gsRam + i) != 0)
+				{
+					ramNonzero++;
+					if(firstNz == 0xFFFFFFFF)
+						firstNz = i;
+					lastNz = i;
+				}
+			}
+			const uint64* r = h.gs->GetRegisters();
+			std::printf("[webgs] 2s: gs ram nonzero words %llu [%x..%x], BITBLTBUF %llx TRXPOS %llx TRXREG %llx TRXDIR %llx\n",
+			            (unsigned long long)ramNonzero, firstNz, lastNz, (unsigned long long)r[0x50], (unsigned long long)r[0x51],
+			            (unsigned long long)r[0x52], (unsigned long long)r[0x53]);
+			uint8_t px[4] = {};
+			glBindFramebuffer(GL_FRAMEBUFFER, 0);
+			int cw = 0, ch = 0;
+			emscripten_get_canvas_element_size("#canvas", &cw, &ch);
+			glReadPixels(cw / 2, ch / 2, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, px);
+			std::printf("[webgs] 2s: flips %llu, gs ram @%x nonzero %llu sum %llx, canvas %dx%d centre %02x%02x%02x glerr %x\n",
+			            (unsigned long long)h.flips, fbp, (unsigned long long)nonzero, (unsigned long long)sum, cw, ch, px[0], px[1], px[2],
+			            glGetError());
+			h.flips = 0;
+		}
+		const uint64* gsRegs = h.gs->GetRegisters();
+		std::printf("[webgs] 2s: path1 %llu B (xgkick %llu) path2 %llu B path3 %llu B, GS PRIM %llx FRAME_1 %llx XYZ2 %llx\n",
+		            (unsigned long long)h.pathBytes[1], (unsigned long long)h.xgkicks, (unsigned long long)h.pathBytes[2],
+		            (unsigned long long)h.pathBytes[3], (unsigned long long)gsRegs[0x00], (unsigned long long)gsRegs[0x4C],
+		            (unsigned long long)gsRegs[0x05]);
+		h.pathBytes[1] = h.pathBytes[2] = h.pathBytes[3] = h.xgkicks = 0;
+		std::printf("[webgs] 2s: framebuffer write-backs %u, software sprites %u, hd textures shown %u, loaded %u\n", h.gsWeb->m_framebufferWriteBacks,
+		            h.gsWeb->m_softwareSprites, h.gsWeb->m_hdTexturesShown, h.gsWeb->m_hdTexturesLoaded);
+		h.gsWeb->m_hdTexturesShown = 0;
+		h.gsWeb->m_framebufferWriteBacks = 0;
+		h.gsWeb->m_softwareSprites = 0;
+		std::printf("[webgs] 2s: gs reg writes:");
+		for(int i = 0; i < 0x80; i++)
+		{
+			if(h.gsWeb->regCounts[i])
+				std::printf(" %02x:%llu", i, (unsigned long long)h.gsWeb->regCounts[i]);
+			h.gsWeb->regCounts[i] = 0;
+		}
+		std::printf("\n");
+		for(int reg : {0x00, 0x06, 0x07, 0x4C, 0x4D, 0x4E, 0x4F, 0x50, 0x52})
+		{
+			auto& values = h.gsWeb->regValues[reg];
+			std::printf("[webgs] 2s: reg %02x values (%zu):", reg, values.size());
+			int shown = 0;
+			for(const auto& [value, count] : values)
