diff --git a/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp b/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
index 32501c6..98e2686 100644
--- a/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
+++ b/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
@@ -1520,7 +1520,11 @@ void GSDeviceVK::ActivateCommandBuffer(u32 index)
 	m_current_command_buffer = resources.command_buffers[1];
 
 	// using the lower 32 bits of the fence index should be sufficient here, I hope...
-	vmaSetCurrentFrameIndex(m_allocator, static_cast<u32>(m_next_fence_counter));
+	// [perf2] With VK_EXT_memory_budget, every call refetches the budget from the OS (a kernel query): DBZ BT4 moves
+	// to a new command buffer at every GS readback, many times a frame, and that refetch was 14% of the GS thread.
+	// The budget is only a heuristic for VMA's heap choices; refreshing it every 8 command buffers is plenty.
+	if ((m_next_fence_counter & 7u) == 0u)
+		vmaSetCurrentFrameIndex(m_allocator, static_cast<u32>(m_next_fence_counter));
 }
 
 void GSDeviceVK::ExecuteCommandBuffer(WaitType wait_for_completion)
diff --git a/pcsx2-gsrunner/Main.cpp b/pcsx2-gsrunner/Main.cpp
