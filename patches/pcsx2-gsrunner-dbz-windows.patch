+// [gamefont] DBZ BT4's own text font (the menu description boxes), read from the player's ISO on this machine
+// (PS2X_CD_IMAGE, inherited from the game) the first time a banner is drawn -- never shipped, never cached on disk.
+// The format (tools/fontprobe/bt4font.py is the reference): DATA/PZS4US1.AFS holds the game's sector-aligned packs;
+// the font pack ("PS2 Fnt5" at entry +0x40) is at byte 0x15E000 on this disc, and is found by a sector scan if not.
+// Its first font: a PSMT4 texture uploaded as PSMCT32 (so: CT32 swizzle in, T4 swizzle out), a CLUT whose four
+// 8x2 blocks each pick one 2-bit plane of the 4-bit texels, and a table of (UTF-16 code, x|w<<10|p0<<15,
+// y|h<<10|p1<<15) sorted by code.
+namespace bt4font
+{
+	struct Glyph { u16 x, y; u8 w, h, plane; };
+	struct Font
+	{
+		bool tried = false, ok = false;
+		u32 tw = 0, th = 0, cellH = 0;
+		std::unordered_map<u32, Glyph> glyphs;
+		std::vector<u32> rgba; // tw x (th * 4): white, alpha from each plane, planes stacked
+		GSTexture* texture = nullptr; // never freed: the GS device may be gone by the time statics are destroyed
+	};
