+// [pipewarm] Granite keeps a command buffer's pipeline state and a render pass's formats private; these name them through
+// explicit instantiation (where access is not checked), the standard way to read a private member without changing Granite.
+namespace seamvk_rob
+{
+    template <typename Tag, typename Tag::type M> struct Rob { friend typename Tag::type get(Tag) { return M; } };
+    struct CmdState { using type = Vulkan::DeferredPipelineCompile Vulkan::CommandBuffer::*; friend type get(CmdState); };
+    template struct Rob<CmdState, &Vulkan::CommandBuffer::pipeline_state>;
+    struct RpColors { using type = VkFormat (Vulkan::RenderPass::*)[Vulkan::VULKAN_NUM_ATTACHMENTS]; friend type get(RpColors); };
+    template struct Rob<RpColors, &Vulkan::RenderPass::color_attachments>;
+    struct RpDepth { using type = VkFormat Vulkan::RenderPass::*; friend type get(RpDepth); };
+    template struct Rob<RpDepth, &Vulkan::RenderPass::depth_stencil>;
+    struct DevRp { using type = const Vulkan::RenderPass &(Vulkan::Device::*)(const Vulkan::RenderPassInfo &, bool); friend type get(DevRp); };
+    template struct Rob<DevRp, &Vulkan::Device::request_render_pass>;
