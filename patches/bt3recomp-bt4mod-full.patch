+++ b/ps2xRuntime/web/web_platform.cpp
@@ -0,0 +1,111 @@
+// [web] Browser platform for the WebAssembly build, run at the start of main() (on a worker: the build uses
+// PROXY_TO_PTHREAD, so the page's main thread stays free for the GS host).
+//
+// Files (WasmFS):
+//   /dbz/data      fetch backend on <page>/data/: the extracted disc (ELF, IRX, BIN, the AFS archives) and the disc
+//                  image (disc.iso), read on demand in 1 MB HTTP Range requests: the 5 GB of AFS archives are never
+//                  downloaded whole, only what the game reads
+//   /dbz/savedata  OPFS (the browser's private file system): the memory card and settings.toml survive reloads
+// The runtime's "executable directory" is /dbz, so its settings (savedata/settings.toml) and the memory cards
+// (<disc>/../savedata) both land in /dbz/savedata.
+// Environment: the GS host is the page (PS2X_GS_LIVE=1). Audio: web/bt3gl_headless.cpp.
+
+#include <emscripten.h>
+#include <emscripten/wasmfs.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace
+{
+	// The extracted disc of SLUS-21978 (Budokai Tenkaichi 4, a BT3 mod), as games/bt3/setup.py leaves it.
+	struct DiscFile
+	{
+		const char* path;
+		bool writable; // the game opens some files read/write (it never writes them)
+	};
+	const DiscFile kDiscFiles[] = {
+	    {"SLUS_216.78", false}, {"SYSTEM.CNF", false},
+	    {"BIN/DBZ4.BIN", true}, {"BIN/DBZP.BIN", true},
+	    {"IRX/CDVDSTM.IRX", false}, {"IRX/CRI_ADXI.IRX", false}, {"IRX/DBCMAN.IRX", false}, {"IRX/DS2O_D.IRX", false},
+	    {"IRX/DS2U_D.IRX", false}, {"IRX/IOPRP300.IMG", false}, {"IRX/LIBSD.IRX", false}, {"IRX/MCMAN.IRX", false},
+	    {"IRX/MCSERV.IRX", false}, {"IRX/MODHSYN.IRX", false}, {"IRX/MODMIDI.IRX", false}, {"IRX/MODSEIN.IRX", false},
+	    {"IRX/MODSESQ.IRX", false}, {"IRX/MODSESQ2.IRX", false}, {"IRX/SDRDRV.IRX", false}, {"IRX/SIO2D.IRX", false},
+	    {"IRX/SIO2MAN.IRX", false}, {"IRX/SOUNDS.IRX", false},
+	    {"DATA/PZS4US.DIR", false}, {"DATA/PZS4US0.AFS", false}, {"DATA/PZS4US1.AFS", false},
+	    {"DATA/PZS4US2.AFS", false}, {"DATA/PZS4US3.AFS", false}, {"DATA/ZS4USED.ADX", false},
+	    {"DATA/ZS4USED.PSS", false}, {"DATA/ZS4USOP.ADX", false}, {"DATA/ZS4USOP.PSS", false},
+	    {"disc.iso", false},
+	};
+
+	// Opens a file the way the runtime will and reports what WasmFS answers (size, first bytes).
+	void ProbeFile(const char* path)
+	{
+		const int fd = open(path, O_RDONLY);
+		if(fd < 0)
+		{
+			std::printf("[web] %s: open failed (%s)\n", path, std::strerror(errno));
+			return;
+		}
+		const off_t size = lseek(fd, 0, SEEK_END);
+		lseek(fd, 0, SEEK_SET);
+		unsigned char head[4] = {};
+		const ssize_t got = read(fd, head, sizeof(head));
+		std::printf("[web] %s: size %lld, read %d -> %02x %02x %02x %02x\n", path, static_cast<long long>(size),
+		            static_cast<int>(got), head[0], head[1], head[2], head[3]);
+		close(fd);
+	}
+
+	bool PageHas(const char* name)
+	{
+		return MAIN_THREAD_EM_ASM_INT({ return new URLSearchParams(location.search).has(UTF8ToString($0)) ? 1 : 0; }, name) != 0;
+	}
+}
+
+void ps2xWasmPlatformInit(int& argc, char**& argv)
+{
+	mkdir("/dbz", 0777);
+	backend_t data = wasmfs_create_fetch_backend("data", 1u << 20);
+	int rc = wasmfs_create_directory("/dbz/data", 0777, data);
+	std::printf("[web] mkdir /dbz/data -> %d\n", rc);
+	mkdir("/dbz/data/BIN", 0777);
+	mkdir("/dbz/data/IRX", 0777);
+	mkdir("/dbz/data/DATA", 0777);
+	for(const DiscFile& f : kDiscFiles)
+	{
+		char path[256];
+		std::snprintf(path, sizeof(path), "/dbz/data/%s", f.path);
+		const int fd = wasmfs_create_file(path, f.writable ? 0666 : 0444, data);
+		if(fd < 0)
+			std::printf("[web] create %s -> %d\n", path, fd);
+		else
+			close(fd);
+	}
+	ProbeFile("/dbz/data/SLUS_216.78");
+	ProbeFile("/dbz/data/DATA/PZS4US0.AFS");
+
+	backend_t opfs = wasmfs_create_opfs_backend();
+	rc = wasmfs_create_directory("/dbz/savedata", 0777, opfs);
+	std::printf("[web] saves: /dbz/savedata (OPFS) -> %d\n", rc);
+
+	setenv("PS2X_EXEDIR", "/dbz", 1);
+	setenv("PS2X_GS_LIVE", "1", 1);
+	setenv("PS2X_CD_IMAGE", "/dbz/data/disc.iso", 1);
+	// No GL here: the runtime's present loop is paced by the headless raylib, not by the barrier pacing.
+	setenv("PS2X_BARPACE", "0", 0);
+	// <page>?debug: more of the runtime's diagnostics
+	if(PageHas("debug"))
+		setenv("PS2X_PAD_LOG", "1", 0);
+
+	static char arg0[] = "ps2EntryRunner";
+	static char arg1[] = "/dbz/data/SLUS_216.78";
+	static char* args[] = {arg0, arg1, nullptr};
+	argc = 2;
+	argv = args;
+	std::printf("[web] files: /dbz/data -> data/ (on demand), saves: OPFS\n");
+}
