+    const double toint = 1.5 / 2.220446049250313080847e-16, pio4 = 0x1.921fb6p-1, invpio2 = 6.36619772367581382433e-01,
+                 pio2_1 = 1.57079631090164184570e+00, pio2_1t = 1.58932547735281966916e-08;
+    const uint32_t ix = asU32(x) & 0x7fffffffu;
+    double xd = x;
+    if (ix >= 0x7f800000u) { *y = double(x - x); return 0; }
+    if (ix >= 0x4dc90fdbu)   // |x| >= 2^28 pi/2: one turn off exactly first (see above)
+        xd = std::fmod(xd, 6.28318530717958647692);
+    double fn = xd * invpio2 + toint - toint;
+    int n = int(int32_t(fn));
+    *y = xd - fn * pio2_1 - fn * pio2_1t;
+    if (*y < -pio4) { n--; fn--; *y = xd - fn * pio2_1 - fn * pio2_1t; }
+    else if (*y > pio4) { n++; fn++; *y = xd - fn * pio2_1 - fn * pio2_1t; }
+    return n;
+}
