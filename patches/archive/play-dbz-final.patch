+bool CGSH_OpenGL::NeedsEmulatedFetch(uint64 frameReg)
+{
+	if(m_hasFramebufferFetchExtension || (frameReg == 0)) return false;
+	if(!m_emulatedFetchDirty && (frameReg == m_emulatedFetchFrameReg)) return m_emulatedFetchActive;
+
+	auto frame = make_convertible<FRAME>(frameReg);
+	bool result = false;
+	if((frame.nPsm == PSMCT32) || (frame.nPsm == PSMCT24))
+	{
+		//FBMSK that keeps some bits of a channel: only the shader can do that
+		for(uint32 shift = 0; shift < 32; shift += 8)
+		{
+			uint32 byteMask = (frame.nMask >> shift) & 0xFF;
+			result |= (byteMask != 0) && (byteMask != 0xFF);
+		}
+		if(!result)
+		{
+			//Small offscreen buffers are where games compose textures (often read back later in
+			//another format, sometimes only once): draw them exactly from the start
+			auto framebuffer = FindFramebuffer(frame);
+			result = (framebuffer && framebuffer->m_exactColor) || (m_exactSmallBuffers && (frame.GetWidth() <= 256));
+		}
+	}
+	m_emulatedFetchDirty = false;
+	m_emulatedFetchFrameReg = frameReg;
+	return result;
+}
