+// into one of a few IOSurfaces; the window's GL context binds the newest finished one (CGLTexImageIOSurface2D) and copies
+// it, still on the GPU, into the 2D texture the present samples. Before, the frame went GPU -> CPU -> GL every frame: 31 MB
+// at a Retina fullscreen, which held a 60 fps fight to ~50.
+namespace ps2_seamvk_metalfx
+{
+    namespace
+    {
+        constexpr int kSlots = 3;
+        struct Slot
+        {
+            IOSurfaceRef surf = nullptr;
+            id<MTLTexture> tex = nil;          // RGBA8 over the surface (the Vulkan image's bytes)
+            uint32_t w = 0, h = 0, gen = 0;
+            int st = 0;                        // 0 free, 1 being written, 2 ready, 3 taken by GL
+            uint64_t seq = 0;
+        };
+        std::mutex g_mtx;
+        Slot g_slots[kSlots];
+        uint64_t g_seq = 0;
+        std::atomic<int> g_glState{0};         // 0 untried, 1 GL side working, -1 unavailable
+        id<MTLCommandQueue> g_queue = nil;
