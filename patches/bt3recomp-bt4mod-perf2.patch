+// [perf2] Kick-job data buffers. Every VIF1/PATH3 kick copied its DMA chain into a fresh vector on the guest thread
+// and the worker freed it after the job: the big ones (above the heap's VirtualAlloc threshold) were a kernel
+// allocation and a kernel free per kick -- ~5% of the worker in a fight. They come back here and are reused.
+namespace
+{
+    std::mutex g_kickBufMtx;
+    std::vector<std::vector<uint8_t>> g_kickBufPool;
+
+    std::vector<uint8_t> kickBufTake(size_t need)
+    {
+        {
+            std::lock_guard<std::mutex> lk(g_kickBufMtx);
+            size_t best = SIZE_MAX;
+            for (size_t i = 0; i < g_kickBufPool.size(); ++i)
+                if (g_kickBufPool[i].capacity() >= need && (best == SIZE_MAX || g_kickBufPool[i].capacity() < g_kickBufPool[best].capacity()))
+                    best = i;
+            if (best == SIZE_MAX && !g_kickBufPool.empty())
+                best = g_kickBufPool.size() - 1;   // none big enough: grow one we already have
+            if (best != SIZE_MAX)
+            {
+                std::vector<uint8_t> b = std::move(g_kickBufPool[best]);
+                g_kickBufPool[best] = std::move(g_kickBufPool.back());
+                g_kickBufPool.pop_back();
+                b.clear();
+                b.reserve(need);
+                return b;
+            }
+        }
+        std::vector<uint8_t> b;
+        b.reserve(need);
+        return b;
+    }
