@@ -216,6 +216,13 @@ void Host::CommitBaseSettingChanges()
 
 void Host::LoadSettings(SettingsInterface& si, std::unique_lock<std::mutex>& lock)
 {
+	// [perf2] PS2X_HWDOWNLOAD_MODE=0..4 overrides the preset's HWDownloadMode (GSHardwareDownloadMode: 0 accurate ...
+	// 2 no readbacks). The launcher sets 2 for offline play: DBZ BT4's glow builds its palette from a render target every
+	// frame, and the synchronous download stalled the GS thread on the GPU -- frame 9.5 -> 7.5 ms, pixel-identical on the
+	// frames compared. Online keeps the preset's accurate mode: what a download returns can reach the game, and both
+	// machines must see the same data.
+	if (const char* v = std::getenv("PS2X_HWDOWNLOAD_MODE"); v && v[0] >= '0' && v[0] <= '4' && !v[1])
+		EmuConfig.GS.HWDownloadMode = static_cast<GSHardwareDownloadMode>(v[0] - '0');
 }
 
 void Host::CheckForSettingsChanges(const Pcsx2Config& old_config)
