+            glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead); glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prevDraw);
+            glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex); glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &prevRect);
+            const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+            GlSlot &gs = g_gl[take];
+            bool ok = true;
+            if (!gs.rect || gs.gen != sgen || gs.w != sw || gs.h != sh)
+            {
+                if (!gs.rect) glGenTextures(1, &gs.rect);
+                glBindTexture(GL_TEXTURE_RECTANGLE, gs.rect);
+                ok = CGLTexImageIOSurface2D(ctx, GL_TEXTURE_RECTANGLE, GL_RGBA8, GLsizei(sw), GLsizei(sh), GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, surf, 0) == kCGLNoError;
+                gs.gen = sgen; gs.w = sw; gs.h = sh;
+            }
+            if (ok && (!g_tex2d || g_w2d != sw || g_h2d != sh))
+            {
+                if (!g_tex2d) { glGenTextures(1, &g_tex2d); glGenFramebuffers(1, &g_fbRead); glGenFramebuffers(1, &g_fbDraw); }
+                glBindTexture(GL_TEXTURE_2D, g_tex2d);
+                glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, GLsizei(sw), GLsizei(sh), 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, GL_BLUE); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_B, GL_RED);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, GL_ONE);   // opaque: the renderer skips its alpha := 1 pass (ps2_seamvk.cpp)
+                g_w2d = sw; g_h2d = sh;
+            }
+            if (ok)
+            {   // GPU copy, surface -> 2D (component for component: the swizzle on the 2D texture puts R and B back)
+                glBindFramebuffer(GL_READ_FRAMEBUFFER, g_fbRead);
+                glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, gs.rect, 0);
+                glBindFramebuffer(GL_DRAW_FRAMEBUFFER, g_fbDraw);
+                glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g_tex2d, 0);
+                if (scissor) glDisable(GL_SCISSOR_TEST);
+                glBlitFramebuffer(0, 0, GLint(sw), GLint(sh), 0, 0, GLint(sw), GLint(sh), GL_COLOR_BUFFER_BIT, GL_NEAREST);
+                if (scissor) glEnable(GL_SCISSOR_TEST);
+                ok = glGetError() == GL_NO_ERROR;
+            }
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, GLuint(prevRead)); glBindFramebuffer(GL_DRAW_FRAMEBUFFER, GLuint(prevDraw));
+            glBindTexture(GL_TEXTURE_2D, GLuint(prevTex)); glBindTexture(GL_TEXTURE_RECTANGLE, GLuint(prevRect));
+            // the surface is free for Metal once this copy is done on the GPU
+            if (g_nRetire < kSlots * 2) g_retire[g_nRetire++] = Retire{ take, glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0) };
+            else { std::lock_guard<std::mutex> lk(g_mtx); g_slots[take].st = 0; }
+            if (!ok)
+            {
+                if (g_glState.load() == 0) std::fprintf(stderr, "[macshare] the GL context cannot take an IOSurface: CPU readback\n");
+                g_glState = -1;
+                return 0;
+            }
+            if (g_glState.exchange(1) != 1) std::fprintf(stderr, "[macshare] zero-copy present: IOSurface %ux%u\n", sw, sh);
+            g_shown = take;
+        }
+        if (!g_tex2d || g_shown < 0) return 0;
+        w = g_w2d; h = g_h2d;
+        return g_tex2d;
+    }
+}
