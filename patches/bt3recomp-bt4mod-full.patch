+
+    void transfer(int path, const uint8_t *data, uint32_t sizeBytes)
+    {
+        if (!data || sizeBytes < 16u || path < 1 || path > 3)
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        writeTransferLocked(w, path, data, sizeBytes & ~15u);
+    }
+
+    void writeRegister(uint8_t reg, uint64_t value)
+    {
+        if (!active())
+            return;
+        // GIFtag: NLOOP=1, EOP=1, FLG=PACKED, NREG=1, REGS=A+D (0xE).
+        uint8_t packet[32] = {};
+        const uint64_t tagLo = 1ull | (1ull << 15) | (1ull << 60);
+        const uint64_t tagHi = 0xEull;
+        const uint64_t adHi = reg;
+        std::memcpy(packet + 0, &tagLo, 8);
+        std::memcpy(packet + 8, &tagHi, 8);
+        std::memcpy(packet + 16, &value, 8);
+        std::memcpy(packet + 24, &adHi, 8);
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        writeTransferLocked(w, 3, packet, sizeof(packet));
+    }
+
+    void readFifo(uint32_t qwc)
+    {
+        if (qwc == 0u || !active())
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        w.writeByte(kTypeReadFifo2);
+        w.writeWord(qwc);
+        w.endPacket();
+    }
+
+    bool readFifoInto(uint8_t *dst, uint32_t bytes)
+    {
+        const uint32_t qwc = bytes / 16u;
+        if (qwc == 0u || !active())
+            return false;
+        Writer &w = writer();
+#if defined(PS2X_GS_LIVE_RING) && !defined(PS2X_GS_LIVE_WEB) // the browser page does not answer (yet)
+        uint32_t seq0 = 0;
+        {
+            std::lock_guard<std::mutex> lock(w.mutex);
+            if (!w.usable())
+                return false;
+            if (w.liveActive)
+                seq0 = __atomic_load_n(&w.live.events->readbackSeq, __ATOMIC_ACQUIRE);
+            w.writeByte(kTypeReadFifo2);
+            w.writeWord(qwc);
+            w.endPacket();
+            if (!w.liveActive)
+                return false;
+            ps2live::eventSet(&w.live.events->data); // the host may be idle-waiting with an old wake-up consumed
+        }
+        // The host answers once it has drawn everything queued before this packet (usually within a frame).
+        static const uint32_t s_timeoutMs = [](){ const char *v = std::getenv("PS2X_GSLIVE_READBACK_MS"); return v && v[0] ? (uint32_t)std::strtoul(v, nullptr, 10) : 3000u; }();
+        const auto t0 = std::chrono::steady_clock::now();
+        while (__atomic_load_n(&w.live.events->readbackSeq, __ATOMIC_ACQUIRE) == seq0)
+        {
+            if (w.live.hostGone() || std::chrono::steady_clock::now() - t0 > std::chrono::milliseconds(s_timeoutMs))
+            {
+                std::fprintf(stderr, "[gslive] readback of %u bytes: no answer from the GS host, keeping the runtime's data\n", bytes);
+                return false;
+            }
+            ps2live::eventWait(&w.live.events->readback, 20);
+        }
+        const uint32_t got = std::min<uint32_t>({bytes, w.live.events->readbackBytes, (uint32_t)ps2live::kReadbackCapacity});
+        std::memcpy(dst, ps2live::readbackData(w.live.header), got);
+        if (const char *dd = std::getenv("PS2X_READBACK_DUMP"); dd && dd[0])
+        {   // [readback] raw copies for inspection: <dir>/rb_<n>.bin
+            static uint32_t s_n = 0;
+            const std::string path = std::string(dd) + "/rb_" + std::to_string(s_n++) + ".bin";
+            if (FILE *f = std::fopen(path.c_str(), "wb")) { std::fwrite(dst, 1, got, f); std::fclose(f); }
+        }
+        static uint32_t s_logged = 0;
+        if (s_logged++ < 8u)
+            std::fprintf(stderr, "[gslive] readback %u bytes from the GS host in %.1f ms\n", got,
+                         std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count());
+        return got == bytes;
+#else
+        (void)dst;
+        readFifo(qwc);
+        return false;
+#endif
+    }
+
+    void streamFlip(uint64_t dispfb1)
+    {
+        if (!active())
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        w.streamLo[7] = dispfb1;
+        w.streamHave |= 1u << 7;
+    }
+
+    void streamPriv(uint32_t regOff, uint64_t value)
+    {
+        if (!active())
+            return;
+        const uint32_t slot = regOff >> 4;
+        if (slot >= 16u)
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        w.streamLo[slot] = value;
+        w.streamHave |= 1u << slot;
+    }
+
+    void vsync(const GSRegisters &regs)
+    {
+        if (!active())
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        snapshotRegisters(w, regs);
+        if (!w.usable())
+            return;
+        w.writeByte(kTypeRegisters);
+        w.write(w.regs.data(), w.regs.size());
+        w.writeByte(kTypeVSync);
+        w.writeByte(static_cast<uint8_t>(w.frames & 1u));
+        w.endPacket();
+#if defined(PS2X_GS_LIVE_RING)
+        if (w.liveActive)
+        {   // bounded lag: wait until the host has read the stream up to the VSync `maxLag` frames back
+            static const uint32_t maxLag = [](){ const char *v = std::getenv("PS2X_GSLIVE_MAXLAG"); const long n = (v && v[0]) ? std::strtol(v, nullptr, 10) : 2L; return (uint32_t)(n < 0 ? 0 : n > 60 ? 60 : n); }();
+            constexpr uint32_t kHist = 64u;
+            static int64_t s_vsyncPos[kHist] = {};
+            s_vsyncPos[w.frames % kHist] = w.live.header->writePos;
+            if (maxLag != 0u && w.frames >= maxLag)
+            {
+                const int64_t target = s_vsyncPos[(w.frames - maxLag) % kHist];
+                const auto t0 = std::chrono::steady_clock::now();
+                while (w.live.header->readPos < target)
+                {
+                    if (w.live.hostGone())
+                        break;
+                    w.live.header->producerWaiting = 1u;
+                    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+                    if (w.live.header->readPos < target)
+                        ps2live::eventWait(&w.live.events->space, 5);
+                    w.live.header->producerWaiting = 0u;
+                }
+                w.lagWaitNs += (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count();
+            }
+        }
+#endif
+        if (w.file && w.frames % 600u == 0u)
+            std::fflush(w.file);
+        ++w.frames;
+        ++w.statFrames;
+        // PS2X_GS_DUMP_UNTIL=<file>: the dump is closed at the first frame after that file appears (test scripts cut a
+        // dump at a chosen moment; the live stream goes on).
+        static const char *s_until = std::getenv("PS2X_GS_DUMP_UNTIL");
+        if (w.file && s_until && s_until[0] && (w.frames % 15u) == 0u && std::filesystem::exists(s_until))
+        {
+            std::fprintf(stderr, "[gsdump] %s appeared: closing dump at frame %u (%.1f MB)\n", s_until, w.frames,
+                         static_cast<double>(w.bytes) / (1024.0 * 1024.0));
+            w.close();
+        }
+        if (w.file && w.maxFrames != 0u && w.frames >= w.maxFrames)
+        {
+            std::fprintf(stderr, "[gsdump] %u frames written, closing dump (%.1f MB)\n", w.frames,
+                         static_cast<double>(w.bytes) / (1024.0 * 1024.0));
+            w.close();
+        }
+        const auto now = std::chrono::steady_clock::now();
+        const double dt = std::chrono::duration<double>(now - w.statT0).count();
+        if (dt >= 5.0)
+        {
+            uint64_t waitNs = 0;
+#if defined(PS2X_GS_LIVE_RING)
+            waitNs = w.live.waitNs;
+            w.live.waitNs = 0;
+#endif
+            std::fprintf(stderr, "[gslive] %.1f frames/s, %.0f packets/s, %.1f MB/s, waited for the host %.1f ms/s (ring full %.1f)\n",
+                         w.statFrames / dt, w.statPackets / dt, w.statBytes / dt / (1024.0 * 1024.0), (waitNs + w.lagWaitNs) / 1e6 / dt, waitNs / 1e6 / dt);
+            w.lagWaitNs = 0;
+            w.statFrames = w.statPackets = w.statBytes = 0;
+            w.statT0 = now;
+        }
+    }
+
+    void setRegs(GSRegisters *regs)
+    {
+        if (!active())
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        w.liveRegs = regs;
+    }
+
+    void onSwap()
+    {
+        if (!active())
+            return;
+        GSRegisters *regs = nullptr;
+        {
+            Writer &w = writer();
+            std::lock_guard<std::mutex> lock(w.mutex);
+            regs = w.liveRegs;
+        }
+        if (regs)
+            vsync(*regs);
+    }
+}
