+void CGSH_OpenGL::WriteBackOverlappingFramebuffers(const TEX0& tex0)
+{
+	auto texPageSize = CGsPixelFormats::GetPsmPageSize(tex0.nPsm);
+	uint32 texPagesX = std::max<uint32>(1, (std::max(tex0.GetBufWidth(), tex0.GetWidth()) + texPageSize.first - 1) / texPageSize.first);
+	uint32 texPagesY = std::max<uint32>(1, (tex0.GetHeight() + texPageSize.second - 1) / texPageSize.second);
+	uint32 texStart = tex0.GetBufPtr();
+	uint32 texEnd = texStart + (texPagesX * texPagesY * CGsPixelFormats::PAGESIZE);
+
+	for(const auto& framebuffer : m_framebuffers)
+	{
+		if(!framebuffer->m_gpuDirty) continue;
+		auto fbPageSize = CGsPixelFormats::GetPsmPageSize(framebuffer->m_psm);
+		uint32 fbPagesX = std::max<uint32>(1, framebuffer->m_width / fbPageSize.first);
+		uint32 fbStart = framebuffer->m_basePtr + (framebuffer->m_gpuDirtyMinY / fbPageSize.second) * fbPagesX * CGsPixelFormats::PAGESIZE;
+		uint32 fbEnd = framebuffer->m_basePtr + ((framebuffer->m_gpuDirtyMaxY / fbPageSize.second) + 1) * fbPagesX * CGsPixelFormats::PAGESIZE;
+		if((fbStart >= texEnd) || (texStart >= fbEnd)) continue;
+		//[dbz] Pages the texture reads that were all rewritten by transfers since the drawing are
+		//newer in RAM than on the GPU (DBZ BT3 uploads glyphs over its downscale buffer every
+		//frame): nothing to bring back for this texture
+		if(m_skipTransferredWriteBacks)
+		{
+			const uint32 lo = std::max(texStart, fbStart), hi = std::min(texEnd, fbEnd);
+			uint32 pages = 0, newer = 0;
+			for(uint32 a = lo & ~(CGsPixelFormats::PAGESIZE - 1); a < hi; a += CGsPixelFormats::PAGESIZE)
+			{
+				pages++;
+				if(a >= framebuffer->m_basePtr && framebuffer->m_cachedArea.IsPageDirty((a - framebuffer->m_basePtr) / CGsPixelFormats::PAGESIZE))
+					newer++;
+			}
+			//Mode 2 (DBZ default): one re-uploaded page is enough -- the game uploads what it is
+			//about to read into scratch memory its post chain drew over
+			const bool indexed = (tex0.nPsm == PSMT8) || (tex0.nPsm == PSMT4);
+			const bool allNewer = (newer == pages) || ((m_skipTransferredWriteBacks >= 2) && indexed && (newer != 0));
+			if(allNewer)
+			{
+				m_skippedWriteBacks++;
+				continue;
+			}
+		}
+#if 1
+		if(m_traceWriteBacks)
+		{
+			printf("[gsh] write-back fb %x w %u psm %x rows %u-%u [%x,%x) for tex %x tbw %u psm %x %ux%u [%x,%x)\n",
+			       framebuffer->m_basePtr, framebuffer->m_width, framebuffer->m_psm, framebuffer->m_gpuDirtyMinY, framebuffer->m_gpuDirtyMaxY,
+			       fbStart, fbEnd, tex0.GetBufPtr(), tex0.GetBufWidth(), static_cast<uint32>(tex0.nPsm), tex0.GetWidth(), tex0.GetHeight(), texStart, texEnd);
+		}
+#endif
+		m_wbStats[(static_cast<uint64>(framebuffer->m_basePtr) << 32) | (static_cast<uint64>(framebuffer->m_psm) << 24) |
+		          (static_cast<uint64>(tex0.nPsm) << 16) | (tex0.GetBufPtr() >> 13)]++;
+		WriteBackFramebuffer(framebuffer);
+		m_textureCache.InvalidateRange(fbStart, fbEnd - fbStart);
+		HdInvalidate(fbStart, fbEnd - fbStart);
+	}
+}
+
+//[dbz] A host->local transfer writes GS RAM under framebuffers the GPU drew into. Those pages are later
+//re-uploaded from RAM to the GPU copy (CommitFramebufferDirtyPages), so RAM must hold the drawing first, or
+//the stale rest of each page overwrites it (DBZ BT3 uploads HUD glyphs into its glow buffer every frame).
+//Only for exact framebuffers served to textures from the GPU (m_exactFbTextures): the RAM path writes them
+//back before every read anyway.
+void CGSH_OpenGL::BeginTransferWrite()
+{
+	CGSHandler::BeginTransferWrite();
+	if(!m_exactFbTextures) return;
+	auto bltBuf = make_convertible<BITBLTBUF>(m_nReg[GS_REG_BITBLTBUF]);
+	auto trxReg = make_convertible<TRXREG>(m_nReg[GS_REG_TRXREG]);
+	auto trxPos = make_convertible<TRXPOS>(m_nReg[GS_REG_TRXPOS]);
+	auto [trxStart, trxSize] = GsTransfer::GetDstRange(bltBuf, trxReg, trxPos);
+	const uint32 trxEnd = trxStart + trxSize;
+	bool flushed = false;
+	for(const auto& framebuffer : m_framebuffers)
+	{
+		if(!framebuffer->m_gpuDirty || !framebuffer->m_exactColor) continue;
+		auto fbPageSize = CGsPixelFormats::GetPsmPageSize(framebuffer->m_psm);
+		uint32 fbPagesX = std::max<uint32>(1, framebuffer->m_width / fbPageSize.first);
+		uint32 fbStart = framebuffer->m_basePtr + (framebuffer->m_gpuDirtyMinY / fbPageSize.second) * fbPagesX * CGsPixelFormats::PAGESIZE;
+		uint32 fbEnd = framebuffer->m_basePtr + ((framebuffer->m_gpuDirtyMaxY / fbPageSize.second) + 1) * fbPagesX * CGsPixelFormats::PAGESIZE;
+		if((fbStart >= trxEnd) || (trxStart >= fbEnd)) continue;
+		if(!flushed)
+		{
+			FlushVertexBuffer();
+			flushed = true;
+		}
+		WriteBackFramebuffer(framebuffer);
+		m_transferWriteBacks++;
+	}
+}
+
+void CGSH_OpenGL::WriteBackFramebuffer(const FramebufferPtr& framebuffer)
+{
+	const auto writeBackStart = std::chrono::steady_clock::now();
+	struct Timer
+	{
+		std::chrono::steady_clock::time_point start;
+		double& total;
+		~Timer() { total += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count(); }
+	} timer{writeBackStart, m_writeBackMs};
+	uint32 minY = framebuffer->m_gpuDirtyMinY;
+	uint32 maxY = framebuffer->m_gpuDirtyMaxY;
+	framebuffer->m_gpuDirty = false;
+	m_framebufferWriteBacks++;
+	if(!framebuffer->m_exactColor && ((framebuffer->m_psm == PSMCT32) || (framebuffer->m_psm == PSMCT24)))
+	{
+		//From now on, draw it with exact alpha (no "x2" alpha for GL blending)
+		framebuffer->m_exactColor = true;
+		m_emulatedFetchDirty = true;
+	}
+
+	//RAM written since the drawing (transfers) goes to the GPU first, then everything comes back
+	CommitFramebufferDirtyPages(framebuffer, minY, maxY);
+	if(m_multisampleEnabled)
+	{
+		ResolveFramebufferMultisample(framebuffer, m_fbScale);
+	}
+
+	uint32 width = framebuffer->m_width;
+	uint32 rows = maxY - minY + 1;
+	uint32 scale = m_fbScale;
+	std::vector<uint32> pixels(width * scale * rows * scale);
+	GLint prevReadFramebuffer = 0;
+	glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevReadFramebuffer);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, m_multisampleEnabled ? static_cast<GLuint>(framebuffer->m_resolveFramebuffer) : static_cast<GLuint>(framebuffer->m_framebuffer));
+	glPixelStorei(GL_PACK_ALIGNMENT, 4);
+	glReadPixels(0, minY * scale, width * scale, rows * scale, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, prevReadFramebuffer);
+	CHECKGLERROR();
+
+	auto pixelAt = [&](uint32 x, uint32 y) { return pixels[(x * scale) + ((y - minY) * scale * width * scale)]; };
+	switch(framebuffer->m_psm)
+	{
+	case PSMCT32:
+	{
+		CGsPixelFormats::CPixelIndexorPSMCT32 indexor(m_pRAM, framebuffer->m_basePtr, width / 64);
+		for(uint32 y = minY; y <= maxY; y++)
+			for(uint32 x = 0; x < width; x++)
+				indexor.SetPixel(x, y, pixelAt(x, y));
+	}
+	break;
+	case PSMCT24:
+	{
+		CGsPixelFormats::CPixelIndexorPSMCT32 indexor(m_pRAM, framebuffer->m_basePtr, width / 64);
+		for(uint32 y = minY; y <= maxY; y++)
+			for(uint32 x = 0; x < width; x++)
+			{
+				uint32* address = indexor.GetPixelAddress(x, y);
+				*address = (*address & 0xFF000000) | (pixelAt(x, y) & 0x00FFFFFF);
+			}
+	}
+	break;
+	case PSMCT16:
+	case PSMCT16S:
+	{
+		auto to16 = [](uint32 c) -> uint16 {
+			return static_cast<uint16>(((c >> 3) & 0x1F) | (((c >> 11) & 0x1F) << 5) | (((c >> 19) & 0x1F) << 10) | ((c >> 31) << 15));
+		};
+		if(framebuffer->m_psm == PSMCT16)
+		{
+			CGsPixelFormats::CPixelIndexorPSMCT16 indexor(m_pRAM, framebuffer->m_basePtr, width / 64);
+			for(uint32 y = minY; y <= maxY; y++)
+				for(uint32 x = 0; x < width; x++)
+					indexor.SetPixel(x, y, to16(pixelAt(x, y)));
+		}
+		else
+		{
+			CGsPixelFormats::CPixelIndexorPSMCT16S indexor(m_pRAM, framebuffer->m_basePtr, width / 64);
+			for(uint32 y = minY; y <= maxY; y++)
+				for(uint32 x = 0; x < width; x++)
+					indexor.SetPixel(x, y, to16(pixelAt(x, y)));
+		}
+	}
+	break;
+	default:
+		break;
+	}
+}
