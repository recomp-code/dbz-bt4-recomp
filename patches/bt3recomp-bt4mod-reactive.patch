diff --git a/ps2xRuntime/src/lib/seamvk/upaux.frag b/ps2xRuntime/src/lib/seamvk/upaux.frag
index 54b744e..3f0f3f0 100644
--- a/ps2xRuntime/src/lib/seamvk/upaux.frag
+++ b/ps2xRuntime/src/lib/seamvk/upaux.frag
@@ -2,16 +2,20 @@
 // [upscale] The upscaler's depth and motion inputs in the composed frame's space: the displayed target's depth and the
 // motion-vector pass's image, sampled with the circuit blit's own mapping (present.vert), nearest. The vectors are in
 // target pixels; alpha.xy converts them to output pixels, taps.xy adds a moved display start ([mvofs], output pixels).
+// [reactive] The effects' reactive mask (binding 2, a black 1x1 when there is none) goes along, linear.
 layout(push_constant) uniform PCP { vec4 src; vec4 dst; vec4 alpha; vec4 taps; } pc;
 layout(set = 0, binding = 0) uniform sampler2D uDepth;
 layout(set = 0, binding = 1) uniform sampler2D uMv;
+layout(set = 0, binding = 2) uniform sampler2D uReact;
 layout(location = 0) in vec2 vUv;
 layout(location = 0) out float oDepth;
 layout(location = 1) out vec2 oMv;
+layout(location = 2) out float oReact;
 void main()
 {
     float d = texture(uDepth, vUv).r;
     vec2 mv = texture(uMv, vUv).rg * pc.alpha.xy + pc.taps.xy;
     oDepth = isnan(d) ? 0.0 : clamp(d, 0.0, 1.0);
     oMv = any(isnan(mv)) || any(isinf(mv)) ? vec2(0.0) : mv;
+    oReact = clamp(texture(uReact, vUv).r, 0.0, 0.9);   // never all the way: some history keeps the effects steady
 }
