<?xml version="1.0" encoding="utf-8"?>
<!-- Android's Game Mode: the player (or the system's game hub) can pick Performance or Battery for this game. No system
     downscaling or fps override: the runtime sizes its own render and paces its own frames. -->
<game-mode-config xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsPerformanceGameMode="true"
    android:supportsBatteryGameMode="true"
    android:allowGameDownscaling="false"
    android:allowGameFpsOverride="false" />
