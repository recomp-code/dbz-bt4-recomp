+		std::printf("[webgs] 2s: vu starts %llu, VIF1 STAT %08x, reg writes:", (unsigned long long)h.vuStarts,
+		            h.vpu1->GetVif().GetRegister(0x10003C00));
+		for(const auto& [address, count] : h.vifRegWrites)
+			std::printf(" %08x x%llu (last %08x)", address, (unsigned long long)count, h.vifRegLast[address]);
+		std::printf("\n");
