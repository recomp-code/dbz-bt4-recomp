+    # [metalfx] pkg-config hands a static FFmpeg's "-framework X" as two separate link options, and CMake de-duplicates
+    # options token by token: with any other framework on the link line the second "-framework" went and CoreVideo /
+    # CoreMedia were left bare ("no such file or directory"). Keep each pair whole.
+    get_target_property(_ffopts PkgConfig::FFMPEG INTERFACE_LINK_OPTIONS)
+    if(_ffopts)
+        set(_ffkeep "")
+        set(_ffnext "")
+        foreach(_o IN LISTS _ffopts)
+            if(_ffnext)
+                list(APPEND _ffkeep "SHELL:-framework ${_o}")
+                set(_ffnext "")
+            elseif(_o STREQUAL "-framework")
+                set(_ffnext 1)
+            else()
+                list(APPEND _ffkeep "${_o}")
+            endif()
+        endforeach()
+        set_target_properties(PkgConfig::FFMPEG PROPERTIES INTERFACE_LINK_OPTIONS "${_ffkeep}")
+    endif()
+
     add_library(ffmpeg INTERFACE)
     target_link_libraries(ffmpeg INTERFACE PkgConfig::FFMPEG)
 endif()
