index f973b42..62595cd 100644
--- a/ps2xRuntime/src/lib/seamvk/seam_mv.frag
+++ b/ps2xRuntime/src/lib/seamvk/seam_mv.frag
@@ -3,19 +3,21 @@
 // (the DLSS / FSR2 convention: current + mv = previous).
 layout(location = 0) in vec4 vCur;
 layout(location = 1) in vec4 vPrev;
+layout(location = 2) flat in vec2 vPrevOfs;
 layout(location = 0) out vec2 oMv;
 
 layout(push_constant) uniform MvPC
 {
     vec4 view;
     vec4 batch;
-    vec4 misc;    // x = target pixels per GS pixel
+    vec4 misc;    // x = target pixels per GS pixel, yz = this draw's XYOFFSET
 } mp;
 
 void main()
 {
     if (vPrev.w <= 1e-6 || vCur.w <= 1e-6) { oMv = vec2(0.0); return; }   // was behind the camera: no usable history
-    vec2 mv = (vPrev.xy / vPrev.w - vCur.xy / vCur.w) * mp.misc.x;
+    // [mvofs] in frame-buffer pixels: the offset moves the picture too (the game's screen shake on heavy hits)
+    vec2 mv = ((vPrev.xy / vPrev.w - vPrevOfs) - (vCur.xy / vCur.w - mp.misc.yz)) * mp.misc.x;
     // a NaN or an infinity here spreads through the upscaler's history until the whole picture is black
     oMv = any(isnan(mv)) || any(isinf(mv)) ? vec2(0.0) : clamp(mv, vec2(-8192.0), vec2(8192.0));
 }
