diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 544bdfa..c71d147 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1680,6 +1680,24 @@ bool PS2Runtime::initialize(const char *title)
             }
             else
                 bt3SetWindowSize(hostWinW, hostWinH);   // moving monitors can leave the window fitted
+            // [autoscale] PS2X_SEAMVK_SCALE=auto: the native renderer's resolution from the size it is shown at. Under a
+            // temporal upscaler the render height is ~75% of the output's (DLSS "Quality"); a fixed 2x was "Ultra
+            // Performance" on a 1440p screen and blurred the picture. 2x at least, 4x at most (1080p 2x, 1440p 3x, 4K 4x).
+            if (const char *sv = std::getenv("PS2X_SEAMVK_SCALE"); sv && !std::strcmp(sv, "auto"))
+            {
+                const int outH = winMode >= 1 ? bt3GetMonitorHeight(idx) : hostWinH;
+                const char *up = std::getenv("PS2X_SEAMVK_UPSCALE");
+                const bool upscaler = up && up[0] && std::strcmp(up, "off") != 0;
+                int sc = upscaler ? (int)std::ceil(double(outH) * 0.75 / 448.0) : (int)std::lround(double(outH) / 448.0);
+                sc = std::max(2, std::min(4, sc));
+                const std::string s = std::to_string(sc);
+#if defined(_WIN32)
+                _putenv_s("PS2X_SEAMVK_SCALE", s.c_str());
+#else
+                setenv("PS2X_SEAMVK_SCALE", s.c_str(), 1);
+#endif
+                std::fprintf(stderr, "[autoscale] shown %d px tall%s: the native renderer at %dx\n", outH, upscaler ? " through the upscaler" : "", sc);
+            }
         }
