diff --git a/ps2xRuntime/include/runtime/ps2_gs_live.h b/ps2xRuntime/include/runtime/ps2_gs_live.h
new file mode 100644
index 0000000..0fb445c
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_gs_live.h
@@ -0,0 +1,49 @@
+#pragma once
+// [gslive] PCSX2's GS as the renderer: the game's GS stream goes, live, to the PCSX2-based GS host window
+// ("pcsx2-gsrunner -live", Metal/Vulkan hardware renderer with upscaling) over a shared-memory ring
+// (ps2_live_ring.h). Ported from the PS2Recomp NBA Street V3 runtime (gs_dump_writer.cpp), without its remote-VU
+// mode: VIF1/VU1 stay local and the host receives finished GIF packets (PATH1/2/3), privileged-register
+// snapshots and one VSync per published frame.
+//
+// Enabled with PS2X_GS_LIVE=1 or settings.toml [video] renderer = "pcsx2". Then our own GS parse runs state-only
+// (PS2X_GS_NODRAW, nothing is drawn locally), paraLLEl-GS and the native renderer are off, the runtime's window
+// stays hidden (audio and pads keep running) and the pad comes from the host window (keyboard + gamepad there).
+//   PS2X_GSHOST       host executable (default ~/NBAStreetRecomp/gshost-dbz/pcsx2-gsrunner)
+//   PS2X_GSHOST_ARGS  extra host arguments (default "-ini dbz.ini", relative to the host's folder)
+//   PS2X_LIVE_SERIAL  game serial for PCSX2's GameIndex fixes (default SLUS-21978; exported to the host)
+//   PS2X_GS_DUMP=<f>  also/instead write the same stream as a PCSX2 .gs dump (PS2X_GS_DUMP_FRAMES limits it)
+#include <cstdint>
+
+struct GSRegisters;
+
+namespace ps2_gslive
+{
+    // PS2X_GS_LIVE=1 or the settings renderer asked for it (decided once, before the first packet).
+    bool requested();
+    // Live ring open and the host started.
+    bool liveActive();
+    // Anything recording (live or dump file).
+    bool active();
+    // Host window state, read by the pad code: active-high libpad buttons, lx|ly<<8|rx<<16|ry<<24.
+    bool remotePad(uint32_t &buttons, uint32_t &axes);
+    bool hostMenuOpen();
+    // path: 1, 2 or 3. Stream order is the caller's (GifArbiter::process on the GS thread).
+    void transfer(int path, const uint8_t *data, uint32_t sizeBytes);
+    // A register the runtime's HLE stubs write straight into its GS parse: sent as an A+D packet.
+    void writeRegister(uint8_t reg, uint64_t value);
+    // GS -> EE transfer of qwc quadwords.
+    void readFifo(uint32_t qwc);
+    // Same packet, then waits for the live host's reply (PCSX2's GS memory, which has the frames it drew) and copies
+    // it to dst. False when there is no live host or it did not answer: dst keeps the runtime's own data.
+    bool readFifoInto(uint8_t *dst, uint32_t bytes);
+    // Stream-ordered DISPFB1 (the display flip as it passes through the GS thread).
+    void streamFlip(uint64_t dispfb1);
+    // Stream-ordered privileged display register ([s1fence] path).
+    void streamPriv(uint32_t regOff, uint64_t value);
+    // A published frame (GsGpuRenderer::swapFrame, stream order): register snapshot + VSync. The producer then waits
+    // while the host is more than PS2X_GSLIVE_MAXLAG (default 2) frames behind, so input latency stays bounded.
+    void vsync(const GSRegisters &regs);
+    // The live privileged register block (PS2Memory::gs_regs) and the per-frame hook that snapshots it.
+    void setRegs(GSRegisters *regs);
+    void onSwap();
+}
