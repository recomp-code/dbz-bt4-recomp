+	// --- GS / VIF1 ---------------------------------------------------------------------------
+
+	// PS2MEM_GS layout (as PCSX2 dumps it) -> Play!'s privileged register writes (0x12000000 + offset).
+	void ApplyPrivRegisters(Host& h)
+	{
+		static const uint32_t kRegs[] = {0x00, 0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80, 0x90, 0xA0, 0xB0, 0xC0, 0xD0, 0xE0, 0x1010};
+		for(uint32_t offset : kRegs)
+		{
+			uint64_t value;
+			std::memcpy(&value, h.privRegs.data() + offset, sizeof(value));
+			h.gs->WritePrivRegister(0x12000000 + offset, static_cast<uint32_t>(value));
+			h.gs->WritePrivRegister(0x12000000 + offset + 4, static_cast<uint32_t>(value >> 32));
+		}
+		{
+			// Display changes (PMODE, SMODE2, DISPFB1/2, DISPLAY1/2), for the "flashes" hunt
+			static uint64_t s_last[6] = {};
+			static int s_logged = 0;
+			static const uint32_t kShown[6] = {0x00, 0x20, 0x70, 0x80, 0x90, 0xA0};
+			for(int i = 0; i < 6; i++)
+			{
+				uint64_t value;
+				std::memcpy(&value, h.privRegs.data() + kShown[i], sizeof(value));
+				if(value != s_last[i] && s_logged < 400)
+				{
+					s_logged++;
+					std::printf("[display] vsync %llu reg %02x: %llx -> %llx\n", (unsigned long long)h.totalVsyncs, kShown[i],
+					            (unsigned long long)s_last[i], (unsigned long long)value);
+					s_last[i] = value;
+				}
+			}
+		}
+		uint64_t smode2;
+		std::memcpy(&smode2, h.privRegs.data() + 0x20, sizeof(smode2));
+		if(smode2 != h.lastSmode2)
+		{
+			h.lastSmode2 = smode2;
+			// NTSC (the game is SLUS); SMODE2: bit 0 INT (interlaced), bit 1 FFMD (frame mode).
+			h.gs->SetCrt((smode2 & 1) != 0, 2, (smode2 & 2) != 0);
+		}
+	}
+
+	enum : uint8_t
+	{
+		kGifPackets = 1,
+		kGifVSync,
+		kGifReadFifo2,
+		kGifPrivRegs,
+		kGifPath3Mask,
+		kGifReadImage,
+	};
+	constexpr size_t kGifQueueLimit = 16u << 20; // the VU1 worker waits beyond this (a few frames' worth)
+
+	// Waking another thread is expensive in WebAssembly (it cost the VU1 worker ~16% when done for
+	// each of the hundreds of packets per frame): the GIF thread is woken at frame ends, for work
+	// someone waits for, and when enough has piled up; it drains everything queued each time.
+	constexpr size_t kGifWakeBytes = 256u << 10;
+
+	void GifEnqueue(Host& h, Host::GifItem&& item)
+	{
+		const bool urgent = (item.kind == kGifVSync) || (item.kind == kGifReadImage) || (item.kind == kGifReadFifo2);
+		std::unique_lock<std::mutex> lock(h.gifMutex);
+		if(h.gifQueuedBytes > kGifQueueLimit)
+		{
+			const double waitStart = emscripten_get_now();
+			if(h.gifWaiting)
+			{
+				h.gifWaiting = false;
+				h.gifHasWork.notify_one();
+			}
+			h.gifProducerWaiting = true;
+			h.gifHasRoom.wait(lock, [&]() { return h.gifQueuedBytes <= kGifQueueLimit / 2; });
+			h.gifProducerWaiting = false;
+			h.gifQueueWaitMs += emscripten_get_now() - waitStart;
+		}
+		const size_t bytes = item.data.size() + 64;
+		h.gifQueuedBytes += bytes;
+		h.gifUnsignalledBytes += bytes;
+		h.gifQueue.push_back(std::move(item));
+		const bool wake = h.gifWaiting && (urgent || (h.gifUnsignalledBytes >= kGifWakeBytes));
+		if(wake)
+		{
+			h.gifWaiting = false;
+			h.gifUnsignalledBytes = 0;
+		}
+		lock.unlock();
+		if(wake) h.gifHasWork.notify_one();
+	}
+
+	void GifEnqueuePackets(Host& h, uint32_t pathIndex, const uint8_t* data, uint32_t size)
+	{
+		Host::GifItem item;
+		item.kind = kGifPackets;
+		item.path = static_cast<uint8_t>(pathIndex);
+		item.data.assign(data, data + size);
+		GifEnqueue(h, std::move(item));
+	}
+
+	// Bytes of the GIF packet (tags up to the one with EOP, and their data) at `start` in VU1 data
+	// memory, which it may wrap around. XGKICK hands the GIF a packet the VU program may overwrite
+	// right after, so the worker copies exactly that much.
+	uint32_t GifPacketLength(const uint8_t* memory, uint32_t memorySize, uint32_t start)
+	{
+		uint32_t offset = 0;
+		while(offset < memorySize)
+		{
+			uint64_t tag;
+			std::memcpy(&tag, memory + ((start + offset) % memorySize), sizeof(tag));
+			const uint32_t loops = static_cast<uint32_t>(tag & 0x7FFF);
+			const bool eop = ((tag >> 15) & 1) != 0;
+			const uint32_t flag = static_cast<uint32_t>((tag >> 58) & 3);
+			uint32_t regs = static_cast<uint32_t>(tag >> 60);
+			if(regs == 0) regs = 16;
+			offset += 16;
+			if(flag == 0)
+				offset += loops * regs * 16; // PACKED
+			else if(flag == 1)
+				offset += ((loops * regs + 1) / 2) * 16; // REGLIST
+			else
+				offset += loops * 16; // IMAGE
+			if(eop) break;
+		}
+		return std::min(offset, memorySize);
+	}
+
+	void GifKick(Host& h, uint32_t value)
+	{
+		const uint32_t start = (value & 0x3FF) * 16;
+		const uint32_t length = GifPacketLength(h.vuMem1, static_cast<uint32_t>(PS2::VUMEM1SIZE), start);
+		Host::GifItem item;
+		item.kind = kGifPackets;
+		item.path = 1;
+		item.data.resize(length);
+		const uint32_t first = std::min<uint32_t>(length, static_cast<uint32_t>(PS2::VUMEM1SIZE) - start);
+		std::memcpy(item.data.data(), h.vuMem1 + start, first);
+		std::memcpy(item.data.data() + first, h.vuMem1, length - first);
+		GifEnqueue(h, std::move(item));
+	}
+
+	// GIF thread: packets of one path; if another path is in the middle of a packet the GIF won't
+	// take them yet, so they wait (in order) until that packet's end arrives
+	bool GifTryPackets(Host& h, uint32_t pathIndex, std::vector<uint8_t>& data, uint32_t& done)
+	{
+		while(done < data.size())
+		{
+			const uint32_t size = static_cast<uint32_t>(data.size());
+			const uint32_t n = h.gif->ProcessMultiplePackets(data.data(), size, done, size, CGsPacketMetadata(pathIndex));
+			if(n == 0) return false;
+			done += n;
+		}
+		return true;
+	}
+
+	void GifRunItem(Host& h, Host::GifItem& item)
+	{
+		switch(item.kind)
+		{
+		case kGifPackets:
+			h.gifDeferred.emplace_back(item.path, std::move(item.data));
+			break;
+		case kGifVSync:
+		{
+			if(g_traceState == 2)
+			{
+				h.gsWeb->traceOn = false;
+				g_traceState = 0;
+				std::printf("[trace] end\n");
+			}
+			else if(g_traceState == 1)
+			{
+				g_traceState = 2;
+				h.gsWeb->traceOn = true;
+				h.gsWeb->traceLines = 0;
+				std::printf("[trace] begin\n");
+			}
+			// Queues the frame's end and the flip for the GL thread. With two frames already
+			// queued (Play!'s MAX_INFLIGHT_FRAMES) this waits: the picture never lags far behind.
+			const double waitStart = emscripten_get_now();
+			h.gs->SetVBlank();
+			h.gs->ResetVBlank();
+			h.vblankWaitMs += emscripten_get_now() - waitStart;
+			break;
+		}
+		case kGifReadFifo2:
+		{
+			std::vector<uint8_t> discard((static_cast<size_t>(item.value) + 1) * 16);
+			h.gs->ReadImageData(discard.data(), item.value * 16);
+			h.gs->SendGSCall([]() {}, true, true); // the GL thread has read it: the buffer can go
+			break;
+		}
+		case kGifPrivRegs:
+			std::memcpy(h.privRegs.data(), item.data.data(), std::min(item.data.size(), h.privRegs.size()));
+			ApplyPrivRegisters(h);
+			break;
+		case kGifPath3Mask:
+			h.gif->SetPath3Masked(item.value != 0);
+			break;
+		case kGifReadImage:
+		{
+			h.gs->ReadImageData(item.ptr, item.value);
+			{
+				std::lock_guard<std::mutex> lock(h.gifMutex);
+				*item.done = true;
+			}
+			h.gifDone.notify_all();
+			break;
+		}
+		}
+		// Packets in arrival order, except that while a path is in the middle of a packet the GIF
+		// only takes that path's data (its continuation may come after other paths' packets)
+		while(!h.gifDeferred.empty())
+		{
+			auto next = h.gifDeferred.begin();
+			const uint32_t activePath = h.gif->GetActivePath();
+			if(activePath != 0)
+			{
+				next = std::find_if(h.gifDeferred.begin(), h.gifDeferred.end(),
+				                    [activePath](const auto& packets) { return packets.first == activePath; });
+				if(next == h.gifDeferred.end())
+					break; // the rest of that packet hasn't arrived yet
+			}
+			uint32_t done = 0;
+			if(GifTryPackets(h, next->first, next->second, done))
+			{
+				h.gifDeferred.erase(next);
+			}
+			else
+			{
+				next->second.erase(next->second.begin(), next->second.begin() + done);
+				if(done == 0)
+				{
+					std::printf("[webgs] GIF path %u refused while path %u is active\n", next->first, activePath);
+					h.gifDeferred.erase(next); // can't happen; don't wedge the GIF
+				}
+			}
+		}
+	}
+
+	void* GifThread(void* arg)
+	{
+		Host& h = *static_cast<Host*>(arg);
+		std::deque<Host::GifItem> batch;
+		for(;;)
+		{
+			{
+				std::unique_lock<std::mutex> lock(h.gifMutex);
+				if(h.gifQueue.empty())
+				{
+					const double waitStart = emscripten_get_now();
+					h.gifWaiting = true;
+					h.gifHasWork.wait(lock, [&]() { return !h.gifWaiting; });
+					h.gifIdleMs += emscripten_get_now() - waitStart;
+				}
+				h.gifWaiting = false;
+				h.gifUnsignalledBytes = 0;
+				batch.swap(h.gifQueue);
+			}
+			size_t bytes = 0;
+			for(auto& item : batch)
+			{
+				bytes += item.data.size() + 64; // before: GifRunItem may move the data away
+				GifRunItem(h, item);
+			}
+			batch.clear();
+			bool producerWaiting;
+			{
+				std::lock_guard<std::mutex> lock(h.gifMutex);
+				h.gifQueuedBytes -= bytes;
+				producerWaiting = h.gifProducerWaiting;
+			}
+			if(producerWaiting) h.gifHasRoom.notify_all();
+		}
+		return nullptr;
+	}
+
+	// What Play!'s VIF1 sends to the GIF (DIRECT, MSKPATH3, image read-backs), through the queue
+	class GifSink : public CGIF::IAsyncSink
+	{
+	public:
+		explicit GifSink(Host& host)
+		    : m_host(host)
+		{
+		}
+		void QueuePackets(const uint8* data, uint32 size, uint32 pathIndex) override
+		{
+			GifEnqueuePackets(m_host, pathIndex, data, size);
+		}
+		void QueuePath3Mask(bool masked) override
+		{
+			Host::GifItem item;
+			item.kind = kGifPath3Mask;
+			item.value = masked ? 1 : 0;
+			GifEnqueue(m_host, std::move(item));
+		}
+		void ReadImageData(void* data, uint32 size) override
+		{
+			bool done = false;
+			Host::GifItem item;
+			item.kind = kGifReadImage;
+			item.ptr = data;
+			item.value = size;
+			item.done = &done;
+			GifEnqueue(m_host, std::move(item));
+			std::unique_lock<std::mutex> lock(m_host.gifMutex);
+			m_host.gifDone.wait(lock, [&]() { return done; });
+		}
+
+	private:
+		Host& m_host;
+	};
+
+	void RunVu1(Host& h)
+	{
+		// The clock is a call out to JavaScript (~1.5% of the worker at a microprogram run's rate):
+		// timed only for the ?debug statistics, its only reader
+		const double start = g_debug ? emscripten_get_now() : 0.0;
+		for(int i = 0; i < 100000 && h.vpu1->IsVuRunning(); i++)
+		{
+			h.vpu1->Execute(5000);
+			h.vuSlices++;
+		}
+		if(g_debug)
+			h.vuMs += emscripten_get_now() - start;
+		if(g_vuStats)
+		{
+			// ?vustats=1 (with ?chain=0): how VU1 blocks follow each other, for superblocks.
+			static double s_last = 0.0;
+			const double now = emscripten_get_now();
+			if(s_last == 0.0)
+				s_last = now;
+			else if(now - s_last >= 5000.0)
+			{
+				const auto stats = static_cast<CVuExecutor*>(h.vu1.m_executor.get())->TakeBlockStats();
+				const double n = static_cast<double>(std::max<uint64_t>(stats.entries, 1));
+				std::printf("[webgs] VU1 blocks: %.0f entries/s, %.1f instructions each, next block: fall-through %.0f%%, same block %.0f%%, "
+				            "most frequent successor %.0f%% (%u blocks)\n",
+				            stats.entries * 1000.0 / (now - s_last), stats.instructions / n, 100.0 * stats.fallThrough / n,
+				            100.0 * stats.sameBlock / n, 100.0 * stats.dominantSuccessor / n, stats.blocks);
+				if(g_vuDump)
+				{
+					auto blob = static_cast<CVuExecutor*>(h.vu1.m_executor.get())->DumpHotBlocks(40);
+					std::lock_guard<std::mutex> lock(g_vuDumpMutex);
+					g_vuDumpBlob = std::move(blob);
+				}
+				s_last = now;
+			}
+		}
+	}
+
+	void DebugStats(Host& h)
+	{
