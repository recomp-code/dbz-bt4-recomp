+u32 GSDumpReplayer::GetLiveFps60()
+{
+#ifdef PS2X_LIVE_RING
+	return s_live.header ? s_live.header->gameFps60 : 0u;
+#else
+	return 0u;
+#endif
+}
+
+void GSDumpReplayer::RequestLiveFps60(bool on)
+{
+#ifdef PS2X_LIVE_RING
+	if (s_live.header)
+		s_live.header->fps60Request = on ? 2u : 1u;
+#endif
+}
