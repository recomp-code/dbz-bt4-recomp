diff -ruN a/ps2xRuntime/web/library_fetch_stream.js b/ps2xRuntime/web/library_fetch_stream.js
--- a/ps2xRuntime/web/library_fetch_stream.js	1969-12-31 18:00:00
+++ b/ps2xRuntime/web/library_fetch_stream.js	2026-10-19 03:51:13
@@ -0,0 +1,289 @@
+/**
+ * WasmFS fetch backend for the game disc, replacing Emscripten's (src/lib/libwasmfs_fetch.js):
+ * the same on-demand HTTP Range reads, plus
+ *  - read-ahead: sequential reads (streamed music, videos, loading) fetch the next chunks in
+ *    the background, several requests at once, so the game rarely waits for the network;
+ *  - one request per chunk: a read waits for a chunk already on its way instead of asking again;
+ *  - a bounded cache (least recently used chunks go), instead of keeping every chunk ever read;
+ *  - a persistent copy in the browser's Cache Storage: what was played once is read locally the
+ *    next time (keyed by the server's ETag, so a changed file is fetched again).
+ */
+
+addToLibrary({
+  $wasmFS$JSMemoryRanges: {},
+
+  _wasmfs_create_fetch_backend_js__deps: [
+    '$wasmFS$backends',
+    '$wasmFS$JSMemoryRanges',
+    '_wasmfs_fetch_get_file_url',
+    '_wasmfs_fetch_get_chunk_size',
+  ],
+  _wasmfs_create_fetch_backend_js: async function(backend) {
+    const READ_AHEAD_CHUNKS = 8;     // chunks fetched ahead of a sequential read
+    const STREAMS = 4;               // interleaved sequential readers followed at once (video, audio...)
+    const MAX_CACHED_CHUNKS = 384;   // per file (x chunk size, 1 MB here)
+
+    // Persistent chunk store (absent in some private modes: then memory only).
+    var diskCache = (typeof caches !== 'undefined') ? caches.open('ps2x-disc-v1').catch(() => null) : Promise.resolve(null);
