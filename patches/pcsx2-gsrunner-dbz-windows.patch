diff --git a/pcsx2/Ps2LiveRing.h b/pcsx2/Ps2LiveRing.h
index 0045f01..e756232 100644
--- a/pcsx2/Ps2LiveRing.h
+++ b/pcsx2/Ps2LiveRing.h
@@ -67,7 +67,35 @@ namespace ps2live
         return reinterpret_cast<uint8_t *>(header) + sizeof(RingHeader);
     }
 
-#if !defined(_WIN32)
+#if defined(_WIN32)
+    // Windows, version 2: the events are named kernel objects (kDataEventName, kSpaceEventName, kReadbackEventName),
+    // so the readback block follows the data area directly. For each ReadFIFO2 packet the consumer copies PCSX2's FIFO
+    // data into it, stores its size, bumps seq and sets the readback event (the game waits for it).
+    // Version 1 mappings (NBA Street V3) end after the data area: the consumer never answers those.
+    constexpr const wchar_t *kReadbackEventName = L"Local\\PS2RecompGsLiveReadback";
+    constexpr uint64_t kReadbackCapacity = 8ull << 20; // a 1024x1024 32-bit download plus slack
+
+    struct alignas(64) RingReadback
+    {
+        volatile uint32_t seq;
+        volatile uint32_t bytes;
+    };
+
+    inline uint64_t mappingSize(uint64_t capacity)
+    {
+        return sizeof(RingHeader) + capacity + sizeof(RingReadback) + kReadbackCapacity;
+    }
+
+    inline RingReadback *ringReadback(RingHeader *header)
+    {
+        return reinterpret_cast<RingReadback *>(ringData(header) + header->capacity);
+    }
+
+    inline uint8_t *readbackData(RingHeader *header)
+    {
+        return reinterpret_cast<uint8_t *>(ringReadback(header)) + sizeof(RingReadback);
+    }
+#else
     // POSIX: the ring is a shm_open object and the two Windows auto-reset events are words in
     // the same mapping, after the data area (macOS: os_sync_wait_on_address, Linux: futex).
     // macOS limits shm names to 31 characters, so the base name is short.
