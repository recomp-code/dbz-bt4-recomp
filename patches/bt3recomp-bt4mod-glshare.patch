+            return true;
+        }
+        void giveUp()
+        {
+            share::enable(false);
+            for (Retire &r : g_retire) { gl.DeleteSync(r.fence); share::release(r.slot); }
+            g_retire.clear();
+            if (g_shown >= 0) share::release(g_shown);
+            g_shown = -1;
+            for (GlSlot &s : g_slots) dropSlot(s);
+            g_state = -1;
+            std::fprintf(stderr, "[glshare] off: back to the CPU readback\n");
+        }
+    }
+
+    uint32_t sharedPresent(void *(*glGetProc)(const char *), uint32_t &w, uint32_t &h)
+    {
+        if (g_state == 0) g_state = init(glGetProc);
+        if (g_state != 1) return 0;
+        for (size_t i = 0; i < g_retire.size();)
+        {   // slots the window stopped showing: free once the GPU is past their last draw
+            const GLenum r = gl.ClientWaitSync(g_retire[i].fence, kSyncFlushCommands, 0);
+            if (r == kAlreadySignaled || r == kConditionSatisfied) { gl.DeleteSync(g_retire[i].fence); share::release(g_retire[i].slot); g_retire[i] = g_retire.back(); g_retire.pop_back(); }
+            else ++i;
+        }
+        share::Frame f;
+        if (share::take(f))
+        {
+            if (f.slot < 0 || f.slot >= int(sizeof(g_slots) / sizeof(g_slots[0]))) { closeExternal(f.mem); closeExternal(f.sem); giveUp(); return 0; }
+            GlSlot &s = g_slots[f.slot];
+            if (f.mem != -1 && !importSlot(s, f)) { closeExternal(f.sem); share::release(f.slot); giveUp(); return 0; }
+            if (!s.tex || s.gen != f.gen) { closeExternal(f.sem); share::release(f.slot); giveUp(); return 0; }   // (never: a new image always comes with its memory)
+            if (f.sem != -1)
+            {
+                GLuint sem = 0; gl.GenSemaphoresEXT(1, &sem);
+#if defined(_WIN32)
+                gl.ImportSemaphoreWin32HandleEXT(sem, kOpaqueWin32, reinterpret_cast<void *>(f.sem));
+                closeExternal(f.sem);
+#else
+                gl.ImportSemaphoreFdEXT(sem, kOpaqueFd, GLint(f.sem));   // takes the fd
+#endif
+                const GLenum layout = kLayoutShaderReadOnly;
+                gl.WaitSemaphoreEXT(sem, 0, nullptr, 1, &s.tex, &layout);
+                gl.DeleteSemaphoresEXT(1, &sem);
+            }
+            if (g_shown >= 0 && g_shown != f.slot) g_retire.push_back(Retire{ g_shown, gl.FenceSync(kSyncGpuCommandsComplete, 0) });   // after its last draw
+            g_shown = f.slot;
+        }
+        if (g_shown < 0) return 0;
+        w = g_slots[g_shown].w; h = g_slots[g_shown].h;
+        return g_slots[g_shown].tex;
+    }
+}
