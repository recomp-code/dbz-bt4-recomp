+static inline float expf(float x)
+{
+    const double xd = x;
+    const uint32_t abstop = (asU32(x) >> 20) & 0x7ffu;
+    if (abstop >= (asU32(88.0f) >> 20))   // |x| >= 88 or NaN
+    {
+        if (asU32(x) == 0xff800000u) return 0.0f;   // -inf
+        if (abstop >= (asU32(INFINITY) >> 20)) return x + x;
+        if (x > 0x1.62e42ep6f) return asF32(0x7f800000u);   // overflow
+        if (x < -0x1.9fe368p6f) return 0.0f;   // underflow
+    }
+    const double z = kExp2fInvLn2Scaled * xd;
+    double kd = z + kExp2fShift;
+    const uint64_t ki = asU64(kd);
+    kd -= kExp2fShift;
+    const double r = z - kd;
+    uint64_t t = kExp2fTab[ki % 32];
+    t += ki << (52 - 5);
+    const double s = asF64(t);
+    const double zz = kExp2fPolyScaled[0] * r + kExp2fPolyScaled[1], r2 = r * r;
+    double y = kExp2fPolyScaled[2] * r + 1;
+    y = zz * r2 + y;
+    y = y * s;
+    return float(y);
+}
+static inline float logf(float x)
+{
+    uint32_t ix = asU32(x);
+    if (ix == 0x3f800000u) return 0.0f;
+    if (ix - 0x00800000u >= 0x7f800000u - 0x00800000u)   // x < 0x1p-126, inf or NaN
+    {
+        if (ix * 2 == 0) return -asF32(0x7f800000u);   // log(0) = -inf
+        if (ix == 0x7f800000u) return x;
+        if ((ix & 0x80000000u) || ix * 2 >= 0xff000000u) return asF32(0x7fc00000u);   // NaN
+        ix = asU32(x * 0x1p23f);   // subnormal: normalize
+        ix -= 23u << 23;
+    }
+    const uint32_t tmp = ix - 0x3f330000u;
+    const int i = int((tmp >> (23 - 4)) % 16);
+    const int k = int32_t(tmp) >> 23;
+    const uint32_t iz = ix - (tmp & 0xff800000u);
+    const double invc = kLogfTab[i].invc, logc = kLogfTab[i].logc;
+    const double z = double(asF32(iz));
+    const double r = z * invc - 1;
+    const double y0 = logc + double(k) * kLogfLn2;
+    const double r2 = r * r;
+    double y = kLogfPoly[1] * r + kLogfPoly[2];
+    y = kLogfPoly[0] * r2 + y;
+    y = y * r2 + (y0 + r);
+    return float(y);
+}
