+//HD texture replacements in PCSX2's texture pack format.
+//
+//A pack file is named <texture hash>-<palette hash>-<bits>.png, where:
+//- texture hash: XXH3-64 of the texture's 256-byte GS memory blocks, in the order PCSX2's
+//  GSLocalMemory reads them (GSTextureCache.cpp, HashTextureLevel's block path)
+//- palette hash: XXH3-64 of the 16 or 256 32-bit palette colours (paletted formats only)
+//- bits: PSM | TW << 6 | TH << 10
+//Covered: PSMCT32, PSMT8 and PSMT4 textures with 32-bit palettes.
+//Textures drawn through a region clamp (menus, HUD) are named <hash>-<palette hash>-r<w>x<h>-<bits>:
+//PCSX2 hashes their region only, and like textures smaller than a block, as unswizzled pixels
+//(one byte per palette index, 4 bytes per PSMCT32 colour) rather than whole GS blocks.
+//
+//The images are read on demand from <base>/<name>.png (the browser decodes them off-thread) and
+//only while they are in use: the least recently used ones are dropped past a limit.
+
+#include "GSH_OpenGL.h"
+#include "../GsPixelFormats.h"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+#define XXH_INLINE_ALL
+#include "../../../deps/Dependencies/xxHash/xxhash.h"
+
+namespace
+{
+	//Block number inside a page (PCSX2's GSTables.cpp), indexed [y & 7][x & 7]
+	constexpr uint8 g_blockTable32[8][8] =
+	    {
+	        {0, 1, 4, 5, 16, 17, 20, 21},
+	        {2, 3, 6, 7, 18, 19, 22, 23},
+	        {8, 9, 12, 13, 24, 25, 28, 29},
+	        {10, 11, 14, 15, 26, 27, 30, 31},
+	        {0, 1, 4, 5, 16, 17, 20, 21},
+	        {2, 3, 6, 7, 18, 19, 22, 23},
+	        {8, 9, 12, 13, 24, 25, 28, 29},
+	        {10, 11, 14, 15, 26, 27, 30, 31},
+	};
+	constexpr uint8 g_blockTable4[8][8] =
+	    {
+	        {0, 2, 8, 10, 0, 2, 8, 10},
+	        {1, 3, 9, 11, 1, 3, 9, 11},
+	        {4, 6, 12, 14, 4, 6, 12, 14},
+	        {5, 7, 13, 15, 5, 7, 13, 15},
+	        {16, 18, 24, 26, 16, 18, 24, 26},
+	        {17, 19, 25, 27, 17, 19, 25, 27},
+	        {20, 22, 28, 30, 20, 22, 28, 30},
+	        {21, 23, 29, 31, 21, 23, 29, 31},
+	};
+
+	struct PSM_LAYOUT
+	{
+		uint32 pageShiftX, pageShiftY;   //log2 of the page size in pixels
+		uint32 blockShiftX, blockShiftY; //log2 of the block size in pixels
+		const uint8 (*blockTable)[8];
+	};
+
+	bool GetLayout(uint32 psm, PSM_LAYOUT& layout)
+	{
+		switch(psm)
+		{
+		case CGSHandler::PSMCT32:
+			layout = {6, 5, 3, 3, g_blockTable32};
+			return true;
+		case CGSHandler::PSMT8:
+			layout = {7, 6, 4, 4, g_blockTable32};
+			return true;
+		case CGSHandler::PSMT4:
+			layout = {7, 7, 5, 4, g_blockTable4};
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	constexpr uint32 MAX_HD_TEXTURES_LOADED = 160;
+	constexpr uint32 GS_PAGE_COUNT = 512;
+}
+
+#ifdef __EMSCRIPTEN__
+EM_JS_DEPS(ps2xHdTextures, "$UTF8ToString,$stringToNewUTF8");
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2xHdTextureLoaded(CGSH_OpenGL* gs, uint32 slot, uint32 textureName)
+{
+	gs->HdTextureLoaded(slot, textureName);
+}
+#endif
+
+void CGSH_OpenGL::EnableHdTextures(const char* baseUrl)
+{
+#ifdef __EMSCRIPTEN__
+	m_hdBaseUrl = baseUrl;
+	char* list = reinterpret_cast<char*>(EM_ASM_PTR({
+		try
+		{
+			const request = new XMLHttpRequest();
+			request.open('GET', UTF8ToString($0) + '/index.txt', false);
+			request.send();
+			if(request.status != 200) return 0;
+			return stringToNewUTF8(request.responseText);
+		}
+		catch(e)
+		{
+			return 0;
+		}
+	}, baseUrl));
+	if(!list)
+	{
+		std::printf("[hd] no texture pack at %s\n", baseUrl);
+		return;
+	}
+	for(char* line = std::strtok(list, "\r\n"); line; line = std::strtok(nullptr, "\r\n"))
+	{
+		//<hash>[-<clut hash>][-r<width>x<height>]-<bits>
+		unsigned long long hash = 0, clutHash = 0;
+		uint32 bits = 0, regionWidth = 0, regionHeight = 0;
+		char end = 0;
+		if(std::sscanf(line, "%llx-%llx-r%ux%u-%x%c", &hash, &clutHash, &regionWidth, &regionHeight, &bits, &end) == 5)
+		{
+		}
+		else if(clutHash = 0, std::sscanf(line, "%llx-r%ux%u-%x%c", &hash, &regionWidth, &regionHeight, &bits, &end) == 4)
+		{
+		}
+		else if(regionWidth = regionHeight = 0, std::sscanf(line, "%llx-%llx-%x%c", &hash, &clutHash, &bits, &end) == 3)
+		{
+		}
+		else if(clutHash = 0, std::sscanf(line, "%llx-%x%c", &hash, &bits, &end) == 2)
+		{
+		}
+		else
+		{
+			continue;
+		}
+		HD_TEXTURE texture;
+		texture.name = line;
+		m_hdIndex[std::make_tuple(uint64(hash), uint64(clutHash), bits, regionWidth | (regionHeight << 16))] = static_cast<uint32>(m_hdTextures.size());
+		//Quick rejections in HdLookup: most of the game's textures have no replacement
+		m_hdPackShapes.insert(uint64(bits) | (uint64(regionWidth | (regionHeight << 16)) << 32));
+		m_hdPackHashes.insert(uint64(hash));
+		m_hdTextures.push_back(std::move(texture));
+	}
+	std::free(list);
+	m_hdEnabled = !m_hdTextures.empty();
+	std::printf("[hd] %u HD textures available\n", static_cast<unsigned>(m_hdTextures.size()));
+#endif
+}
+
+//Once per shown frame: GL textures for up to `count` decoded HD images (texture upload + mipmaps
+//take a few ms each on phones; all of a scene's at once made a visible stall)
+void CGSH_OpenGL::HdUploadQueued(uint32 count)
+{
+#ifdef __EMSCRIPTEN__
+	if(!m_hdEnabled) return;
+	EM_ASM({
+		const queue = self.ps2xHdQueue;
+		for(let left = $0; queue && queue.length && left > 0; left--)
+		{
+			const item = queue.shift();
+			const gs = item[0];
+			const slot = item[1];
+			const image = item[2];
+			const gl = GLctx;
+			const previous = gl.getParameter(gl.TEXTURE_BINDING_2D);
+			const texture = gl.createTexture();
+			gl.bindTexture(gl.TEXTURE_2D, texture);
+			gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
+			gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, false);
+			gl.pixelStorei(gl.UNPACK_COLORSPACE_CONVERSION_WEBGL, gl.NONE);
+			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
+			gl.generateMipmap(gl.TEXTURE_2D);
+			gl.bindTexture(gl.TEXTURE_2D, previous);
+			image.close();
+			const name = GL.getNewId(GL.textures);
+			texture.name = name;
+			GL.textures[name] = texture;
+			_ps2xHdTextureLoaded(gs, slot, name);
+		}
+	}, count);
+#endif
+}
+
+void CGSH_OpenGL::HdTextureLoaded(uint32 slot, uint32 textureName)
+{
+	auto& texture = m_hdTextures[slot];
+	texture.loading = false;
+	texture.handle = textureName;
+	texture.lastUse = m_hdFrame;
+	m_hdTexturesLoaded++;
+	//The loader bound its texture: Play's bindings have to be set again
+	m_validGlState &= ~GLSTATE_TEXTURE;
+	m_hdGen++;
+	HdEvict();
+}
+
+void CGSH_OpenGL::HdEvict()
+{
+	uint32 loaded = 0;
+	for(const auto& texture : m_hdTextures)
+		if(texture.handle) loaded++;
+	while(loaded > MAX_HD_TEXTURES_LOADED)
+	{
+		HD_TEXTURE* oldest = nullptr;
+		for(auto& texture : m_hdTextures)
+			if(texture.handle && (texture.lastUse != m_hdFrame) && (!oldest || texture.lastUse < oldest->lastUse))
+				oldest = &texture;
+		if(!oldest) break;
+		glDeleteTextures(1, &oldest->handle);
+		oldest->handle = 0;
+		loaded--;
+		m_renderState.isValid = false;
+		m_hdGen++;
+	}
+}
+
+void CGSH_OpenGL::HdInvalidate(uint32 start, uint32 size)
+{
+	if(!m_hdEnabled || size == 0) return;
+	uint32 first = start / 8192;
+	uint32 last = (start + size - 1) / 8192;
+	for(uint32 page = first; page <= last; page++)
+		m_hdPageGen[page % GS_PAGE_COUNT]++;
+	m_hdGen++;
+}
+
+uint32 CGSH_OpenGL::HdPageGenSum(uint32 firstPage, uint32 pageCount) const
+{
+	uint32 sum = 0;
+	for(uint32 i = 0; i < pageCount; i++)
+		sum += m_hdPageGen[(firstPage + i) % GS_PAGE_COUNT];
+	return sum;
+}
+
+uint64 CGSH_OpenGL::HdHashTexture(const TEX0& tex0, uint32& firstPage, uint32& pageCount, int blocksHighOverride) const
+{
+	//PCSX2's GSOffset::BNHelper walk over the texture's blocks
+	PSM_LAYOUT layout;
+	GetLayout(tex0.nPsm, layout);
+	const int bwPages = static_cast<int>(tex0.nBufWidth) >> (layout.pageShiftX - 6);
+	const int blocksWide = static_cast<int>(tex0.GetWidth()) >> layout.blockShiftX;
+	const int blocksHigh = (blocksHighOverride >= 0) ? blocksHighOverride : (static_cast<int>(tex0.GetHeight()) >> layout.blockShiftY);
+	const int pageMaskX = (1 << (layout.pageShiftX - layout.blockShiftX)) - 1;
+	const int pageMaskY = (1 << (layout.pageShiftY - layout.blockShiftY)) - 1;
+
+	XXH3_state_t state;
+	XXH3_64bits_reset(&state);
+	int baseBp = static_cast<int>(tex0.nBufPtr);
+	uint32 minBlock = ~0U, maxBlock = 0;
+	for(int blkY = 0; blkY < blocksHigh;)
+	{
+		int bp = baseBp;
+		for(int blkX = 0; blkX < blocksWide;)
+		{
+			uint32 block = static_cast<uint32>(bp + layout.blockTable[blkY & 7][blkX & 7]) % (RAMSIZE / 256);
+			XXH3_64bits_update(&state, m_pRAM + block * 256, 256);
+			minBlock = std::min(minBlock, block);
+			maxBlock = std::max(maxBlock, block);
+			blkX++;
+			if(!(blkX & pageMaskX)) bp += 32;
+		}
+		blkY++;
+		if(!(blkY & pageMaskY)) baseBp += 32 * bwPages;
+	}
+	firstPage = minBlock / 32;
+	pageCount = (maxBlock / 32) - firstPage + 1;
+	return XXH3_64bits_digest(&state);
+}
+
+uint64 CGSH_OpenGL::HdHashExpanded(const TEX0& tex0, int x0, int y0, int x1, int y1, uint32& firstPage, uint32& pageCount) const
+{
+	//PCSX2's HashTextureLevel unswizzled path: rows of the rectangle's pixels, one byte per palette
+	//index (rtxP) or the 32-bit colours (rtx); XXH3 streaming = the rows hashed back to back
+	PSM_LAYOUT layout;
+	GetLayout(tex0.nPsm, layout);
+	const int width = x1 - x0;
+	XXH3_state_t state;
+	XXH3_64bits_reset(&state);
+	if(tex0.nPsm == PSMCT32)
+	{
+		CGsPixelFormats::CPixelIndexorPSMCT32 indexor(m_pRAM, tex0.GetBufPtr(), tex0.nBufWidth);
+		std::vector<uint32> row(width);
+		for(int y = y0; y < y1; y++)
+		{
+			for(int x = x0; x < x1; x++)
+				row[x - x0] = indexor.GetPixel(x, y);
+			XXH3_64bits_update(&state, row.data(), row.size() * sizeof(uint32));
+		}
+	}
+	else
+	{
+		std::vector<uint8> row(width);
+		if(tex0.nPsm == PSMT8)
+		{
+			CGsPixelFormats::CPixelIndexorPSMT8 indexor(m_pRAM, tex0.GetBufPtr(), tex0.nBufWidth);
+			for(int y = y0; y < y1; y++)
+			{
+				for(int x = x0; x < x1; x++)
+					row[x - x0] = indexor.GetPixel(x, y);
+				XXH3_64bits_update(&state, row.data(), row.size());
+			}
+		}
+		else
+		{
+			CGsPixelFormats::CPixelIndexorPSMT4 indexor(m_pRAM, tex0.GetBufPtr(), tex0.nBufWidth);
+			for(int y = y0; y < y1; y++)
+			{
+				for(int x = x0; x < x1; x++)
+					row[x - x0] = indexor.GetPixel(x, y);
+				XXH3_64bits_update(&state, row.data(), row.size());
+			}
+		}
+	}
+	//Pages grow with x and y: the first and last pixels bound them
+	const uint32 bwPages = std::max<uint32>(1, tex0.nBufWidth >> (layout.pageShiftX - 6));
+	auto pageOf = [&](int x, int y) { return (tex0.nBufPtr / 32) + (x >> layout.pageShiftX) + (y >> layout.pageShiftY) * bwPages; };
+	firstPage = pageOf(x0, y0);
+	pageCount = pageOf(x1 - 1, y1 - 1) - firstPage + 1;
+	return XXH3_64bits_digest(&state);
+}
+
+bool CGSH_OpenGL::HdCanHashTexture(const TEX0& tex0) const
+{
+	//The block walk needs a layout and a texture of at least one block
+	PSM_LAYOUT layout;
+	if(!GetLayout(tex0.nPsm, layout)) return false;
+	const uint32 tw = tex0.nWidth;
+	const uint32 th = tex0.nPad0 | (tex0.nPad1 << 2);
+	return (tw >= layout.blockShiftX) && (th >= layout.blockShiftY) && (tw <= 10) && (th <= 10);
+}
+
+GLuint CGSH_OpenGL::HdLookup(uint64 tex0Reg, uint64 clampReg)
+{
+	if((tex0Reg == m_hdMemoTex0) && (clampReg == m_hdMemoClamp) && (m_hdGen == m_hdMemoGen) && (m_clutVersion == m_hdMemoClut))
+	{
+		if(m_hdMemoHandle != 0)
+			m_hdTextures[m_hdMemoSlot].lastUse = m_hdFrame;
+		return m_hdMemoHandle;
+	}
+	m_hdMemoTex0 = tex0Reg;
+	m_hdMemoClamp = clampReg;
+	m_hdMemoGen = m_hdGen;
+	m_hdMemoClut = m_clutVersion;
+	m_hdMemoHandle = 0;
+
+	auto tex0 = make_convertible<TEX0>(tex0Reg);
+	auto clamp = make_convertible<CLAMP>(clampReg);
+	PSM_LAYOUT layout;
+	if(!GetLayout(tex0.nPsm, layout)) return 0;
+	const uint32 tw = tex0.nWidth;
+	const uint32 th = tex0.nPad0 | (tex0.nPad1 << 2);
+	if((tw > 10) || (th > 10)) return 0;
+
+	//The clamp region PCSX2 would cut out (GSTextureCache::SourceRegion::Create)
+	const uint32 texW = 1u << tw, texH = 1u << th;
+	int x0 = 0, x1 = 0, y0 = 0, y1 = 0;
+	bool hasX = false, hasY = false;
+	if((clamp.nWMS == CLAMP_MODE_REGION_CLAMP) && (clamp.GetMaxU() >= clamp.GetMinU()))
+	{
+		const uint32 rw = clamp.GetMaxU() - clamp.GetMinU() + 1;
+		if((rw < texW) || (clamp.GetMaxU() >= texW)) hasX = true, x0 = clamp.GetMinU(), x1 = clamp.GetMaxU() + 1;
+	}
+	else if((clamp.nWMS == CLAMP_MODE_REGION_REPEAT) && (clamp.GetMinU() != 0))
+	{
+		const uint32 rw = ((clamp.GetMinU() | clamp.GetMaxU()) - clamp.GetMaxU()) + 1;
+		if((rw < texW) || ((clamp.GetMaxU() != 0) && (rw <= texW))) hasX = true, x0 = clamp.GetMaxU(), x1 = (clamp.GetMinU() | clamp.GetMaxU()) + 1;
+	}
+	if((clamp.nWMT == CLAMP_MODE_REGION_CLAMP) && (clamp.GetMaxV() >= clamp.GetMinV()))
+	{
+		const uint32 rh = clamp.GetMaxV() - clamp.GetMinV() + 1;
+		if((rh < texH) || (clamp.GetMaxV() >= texH)) hasY = true, y0 = clamp.GetMinV(), y1 = clamp.GetMaxV() + 1;
+	}
+	else if((clamp.nWMT == CLAMP_MODE_REGION_REPEAT) && (clamp.GetMinV() != 0))
+	{
+		const uint32 rh = ((clamp.GetMinV() | clamp.GetMaxV()) - clamp.GetMaxV()) + 1;
+		if((rh < texH) || ((clamp.GetMaxV() != 0) && (rh <= texH))) hasY = true, y0 = clamp.GetMaxV(), y1 = (clamp.GetMinV() | clamp.GetMaxV()) + 1;
+	}
+	if(!hasX) x0 = 0, x1 = texW;
+	if(!hasY) y0 = 0, y1 = texH;
+	const uint32 regionName = (hasX ? (x1 - x0) : 0) | ((hasY ? (y1 - y0) : 0) << 16);
+	const uint32 bits = tex0.nPsm | (tw << 6) | (th << 10);
+	if(!m_hdPackShapes.count(uint64(bits) | (uint64(regionName) << 32))) return 0; //no image of this format/size
+
+	//The texture's hash, again only when its memory changed. Whole blocks, unless the rectangle is
+	//smaller than a block, cut horizontally or starts below the top (PCSX2 unswizzles those)
+	const uint64 hashKey = tex0Reg & ((1ULL << 34) - 1); //TBP0, TBW, PSM, TW, TH
+	const bool expanded = hasX || (y0 > 0) || ((x1 - x0) < (1 << layout.blockShiftX)) || ((y1 - y0) < (1 << layout.blockShiftY));
+	HD_HASH* cachedPtr;
+	if(hasX || hasY)
+	{
+		const uint64 rect = uint64(uint16(x0)) | (uint64(uint16(x1)) << 16) | (uint64(uint16(y0)) << 32) | (uint64(uint16(y1)) << 48);
+		cachedPtr = &m_hdRegionHashes[std::make_pair(hashKey, rect)];
+	}
+	else
+	{
+		cachedPtr = &m_hdHashes[hashKey];
+	}
+	auto& cached = *cachedPtr;
+	if(cached.pageCount == 0 || cached.pageGenSum != HdPageGenSum(cached.firstPage, cached.pageCount))
+	{
+		if(expanded)
+			cached.hash = HdHashExpanded(tex0, x0, y0, x1, y1, cached.firstPage, cached.pageCount);
+		else
+			cached.hash = HdHashTexture(tex0, cached.firstPage, cached.pageCount,
+			                            (y1 + (1 << layout.blockShiftY) - 1) >> layout.blockShiftY);
+		cached.pageGenSum = HdPageGenSum(cached.firstPage, cached.pageCount);
+	}
+	if(!m_hdPackHashes.count(cached.hash)) return 0; //not in the pack: no need for the palette's hash
+
+	uint64 clutHash = 0;
+	if(CGsPixelFormats::IsPsmIDTEX(tex0.nPsm))
+	{
+		if((tex0.nCPSM != PSMCT32) && (tex0.nCPSM != PSMCT24)) return 0;
+		std::array<uint32, 256> clut;
+		MakeLinearCLUT(tex0, clut);
+		clutHash = XXH3_64bits(clut.data(), sizeof(uint32) * (CGsPixelFormats::IsPsmIDTEX4(tex0.nPsm) ? 16 : 256));
+	}
+
+	auto indexIterator = m_hdIndex.find(std::make_tuple(cached.hash, clutHash, bits, regionName));
+	if(regionName != 0)
+	{
+		//First lookups of region textures, to check their names against the pack
+		static uint32 s_regionLogs = 0;
+		if(s_regionLogs < 60)
+		{
+			s_regionLogs++;
+			std::printf("[hd] region %llx-%llx-r%ux%u-%08x %s\n", (unsigned long long)cached.hash, (unsigned long long)clutHash,
+			            regionName & 0xFFFF, regionName >> 16, bits, (indexIterator != std::end(m_hdIndex)) ? "found" : "not in pack");
+		}
+	}
+	if(indexIterator == std::end(m_hdIndex)) return 0;
+	m_hdMemoRegion[0] = static_cast<float>(x0);
+	m_hdMemoRegion[1] = static_cast<float>(y0);
+	m_hdMemoRegion[2] = static_cast<float>(x1 - x0);
+	m_hdMemoRegion[3] = static_cast<float>(y1 - y0);
+
+	uint32 slot = indexIterator->second;
+	auto& texture = m_hdTextures[slot];
+	texture.lastUse = m_hdFrame;
+	if(texture.handle != 0)
+	{
+		m_hdTexturesShown++;
+		m_hdMemoHandle = texture.handle;
+		m_hdMemoSlot = slot;
+		return texture.handle;
+	}
+#ifdef __EMSCRIPTEN__
+	if(!texture.loading)
+	{
+		texture.loading = true;
+		//Fetched and decoded by the browser; the GL texture is made in this thread (its context)
+		EM_ASM({
+			const gs = $0;
+			const slot = $1;
+			const url = UTF8ToString($2) + '/' + UTF8ToString($3) + '.png';
+			fetch(url)
+			    .then((response) => { if(!response.ok) throw new Error(response.status); return response.blob(); })
+			    .then((blob) => createImageBitmap(blob, {premultiplyAlpha: 'none', colorSpaceConversion: 'none'}))
+			    .then((image) => {
+				    //Uploaded by HdUploadQueued, a few per frame: a match start brings ~90 at once
+				    (self.ps2xHdQueue = self.ps2xHdQueue || []).push([gs, slot, image]);
+			    })
+			    .catch((error) => { console.log('[hd] ' + url + ': ' + error); });
+		}, this, slot, m_hdBaseUrl.c_str(), texture.name.c_str());
+	}
+#endif
+	return 0;
+}
