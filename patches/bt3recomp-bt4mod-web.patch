+    function chunkCount(info) {
+      return Math.ceil(info.size / info.chunkSize);
+    }
+
+    // Fetches chunks [first, last] that are neither cached nor on their way, as one request.
+    function requestChunks(info, first, last) {
+      last = Math.min(last, chunkCount(info) - 1);
+      while (first <= last && (info.chunks.has(first) || info.pending.has(first))) first++;
+      while (last >= first && (info.chunks.has(last) || info.pending.has(last))) last--;
+      if (first > last) return;
+      // One promise per chunk, settled as soon as that chunk is in: a read never waits for its
+      // neighbours in the same request.
+      var settle = new Map();
+      for (var i = first; i <= last; i++) {
+        let resolve, reject;
+        var promise = new Promise((ok, fail) => { resolve = ok; reject = fail; });
+        promise.catch(() => {});
+        settle.set(i, {resolve, reject});
+        info.pending.set(i, promise);
+      }
+      var arrived = (i, chunk) => {
+        if (!info.chunks.has(i)) info.chunks.set(i, chunk);
+        info.pending.delete(i);
+        settle.get(i).resolve();
+        settle.delete(i);
+      };
+      (async () => {
+        // Chunks already in the browser's store come from there; the rest from the network.
+        var cache = await diskCache;
+        var missing = [];
+        for (var i = first; i <= last; i++) {
+          var hit = cache ? await cache.match(chunkKey(info, i)).catch(() => null) : null;
+          if (hit) arrived(i, new Uint8Array(await hit.arrayBuffer()));
+          else missing.push(i);
+        }
+        while (missing.length) {
+          var a = missing[0], b = a;
+          while (missing.length > b - a + 1 && missing[b - a + 1] === b + 1) b++;
+          missing.splice(0, b - a + 1);
+          var start = a * info.chunkSize;
+          var end = Math.min((b + 1) * info.chunkSize, info.size);
+          var bytes = await fetchRetry(info.url, {headers: {'Range': `bytes=${start}-${end - 1}`}}, end - start);
+          for (var j = a; j <= b; j++) {
+            var chunk = bytes.slice(j * info.chunkSize - start, (j + 1) * info.chunkSize - start);
+            arrived(j, chunk);
+            if (cache) cache.put(chunkKey(info, j), new Response(chunk)).catch(() => {});
+          }
+        }
+      })().catch((error) => {
+        for (var [i, s] of settle) { info.pending.delete(i); s.reject(error); }
+      });
+    }
+
+    function evict(info, keepFrom, keepTo) {
+      // Maps keep insertion order and touch() re-inserts on use: the first ones are the oldest.
+      for (var key of info.chunks.keys()) {
+        if (info.chunks.size <= MAX_CACHED_CHUNKS) break;
+        if (key >= keepFrom && key <= keepTo) continue;
+        info.chunks.delete(key);
+      }
+    }
+
+    function touch(info, i) {
+      var chunk = info.chunks.get(i);
+      info.chunks.delete(i);
+      info.chunks.set(i, chunk);
+      return chunk;
+    }
+
+    async function getFileRange(info, offset, len) {
+      if (info.chunks.size === 1 && info.chunkSize >= info.size) return; // whole file
+      var first = (offset / info.chunkSize) | 0;
+      var last = ((offset + len - 1) / info.chunkSize) | 0;
+      // Sequential reading? The game may interleave several streams (a video, its sound, music):
+      // a read continues one of them when it starts where that one ended (or in the same chunk).
+      var stream = info.streams.find((st) => first === st.chunk || first === st.chunk + 1);
+      if (stream) {
+        info.streams.splice(info.streams.indexOf(stream), 1);
+        // Only moving on to a new chunk counts: many small reads inside one chunk are not a stream
+        if (last > stream.chunk) stream.streak++;
+      } else {
+        stream = {chunk: last, streak: 0};
+        if (info.streams.length >= STREAMS) info.streams.shift();
+      }
+      stream.chunk = last;
+      info.streams.push(stream);
+      requestChunks(info, first, last);
+      // Ahead of the reader, as far as it has proven to go: 1 chunk, then 2, then the full
+      // read-ahead for long streams (videos). The next chunk goes in its own request, first.
+      var ahead = stream.streak >= 4 ? READ_AHEAD_CHUNKS : Math.min(stream.streak, 2);
+      if (ahead >= 1) requestChunks(info, last + 1, last + 1);
+      if (ahead >= 2) requestChunks(info, last + 2, last + ahead);
+      var waitStart = 0;
+      for (var i = first; i <= last; i++) {
+        var hedge = null, failure = null;
+        while (!info.chunks.has(i)) {
+          waitStart ||= performance.now();
+          if (!info.pending.has(i)) requestChunks(info, i, i);
+          // The game is waiting on it: if it is slow (often inside a read-ahead request of
+          // several chunks, or on a connection that stalled), ask for this chunk alone as well,
+          // and take whichever answer comes first.
+          await Promise.race([info.pending.get(i).catch((e) => { failure = e; }), hedge || new Promise(() => {}),
+                              new Promise((r) => setTimeout(r, 1500))]);
+          if (failure && failure.status === 404) throw failure;
+          if (!info.chunks.has(i) && !hedge && performance.now() - waitStart >= 1500) {
+            let index = i;
+            var start = index * info.chunkSize, end = Math.min(start + info.chunkSize, info.size);
+            hedge = fetchRetry(info.url, {headers: {'Range': `bytes=${start}-${end - 1}`}}, end - start)
+              .then((chunk) => { if (!info.chunks.has(index)) info.chunks.set(index, chunk); })
+              .catch(() => {});
+          }
+        }
+      }
+      if (waitStart) {
+        // The game had to wait for the network: count it (and show long waits with ?debug)
+        var waited = performance.now() - waitStart;
+        info.waits = (info.waits || 0) + 1;
+        info.waitedMs = (info.waitedMs || 0) + waited;
+        if (waited > 20) err(`[disc] waited ${waited.toFixed(0)} ms for chunk ${first}-${last} (stream streak ${stream.streak}, ${info.waits} waits, ${info.waitedMs.toFixed(0)} ms total)`);
+      }
+      evict(info, first, last + READ_AHEAD_CHUNKS);
+    }
+
+    wasmFS$backends[backend] = {
+      allocFile: async (file) => { /* nop */ },
+      freeFile: async (file) => {
+        wasmFS$JSMemoryRanges[file] = undefined;
+      },
+      write: async (file, buffer, length, offset) => {
+        console.error('fetch backend: files are read-only');
+      },
+      read: async (file, buffer, length, offset) => {
+        if (offset < 0 || length <= 0) return 0;
+        var info;
+        try {
+          info = await openFile(file);
+          length = Math.min(length, info.size - offset);
+          if (length <= 0) return 0;
+          await getFileRange(info, offset, length);
+        } catch (failedResponse) {
+          return failedResponse.status === 404 ? -{{{ cDefs.ENOENT }}} : -{{{ cDefs.EBADF }}};
+        }
+        var chunkSize = info.chunkSize;
+        var first = (offset / chunkSize) | 0;
+        var last = ((offset + length - 1) / chunkSize) | 0;
+        for (var i = first; i <= last; i++) {
+          var chunk = touch(info, i);
+          var chunkStart = i * chunkSize;
+          var start = Math.max(chunkStart, offset);
+          var end = Math.min(chunkStart + chunkSize, offset + length);
+          HEAPU8.set(chunk.subarray(start - chunkStart, end - chunkStart), buffer + (start - offset));
+        }
+        return length;
+      },
+      getSize: async (file) => {
+        try {
+          return (await openFile(file)).size;
+        } catch (failedResponse) {
+          return 0;
+        }
+      },
+    };
+  },
+});
diff -ruN a/ps2xRuntime/web/play_gs_host.cpp b/ps2xRuntime/web/play_gs_host.cpp
--- a/ps2xRuntime/web/play_gs_host.cpp	1969-12-31 18:00:00
+++ b/ps2xRuntime/web/play_gs_host.cpp	2026-10-19 04:50:29
@@ -0,0 +1,1674 @@
+// GS host for the browser build: the consumer side of the live ring (gs_dump_writer.cpp) running
+// on the page's main thread, drawing with the GS, VIF1/VU1 and GIF of the Play! emulator
+// (https://github.com/jpd002/Play-, BSD-2-Clause): GSH_OpenGL on WebGL2, VU1 on Play!'s
+// WebAssembly JIT.
+//
+// It does what pcsx2-gsrunner -live does with the same stream (GSDumpReplayer.cpp):
+//   header + privileged GS registers, then packets
+//   Transfer(path, data) -> GIF path 1/2/3      VSync(field) -> vblank, flip
+//   Registers(8 KB)      -> privileged regs     ReadFIFO2    -> local->host transfer
+//   0x10 VIF1 stream     -> VIF1 (UNPACK/MPG fill VU1, MSCAL runs it, XGKICK/DIRECT reach the GIF)
+//   0x11 VIF1 register   -> FBRST / ERR / MARK
+// It runs once per browser frame (requestAnimationFrame) and never blocks: whole packets only,
+// the rest waits for the next frame. The game side runs on workers and blocks on a full ring.
+// Keyboard and gamepad are read here and published through the ring header, like the Mac host.
+
+#include "../src/lib/ps2_live_ring.h"
+
+#include <emscripten.h>
+#include <emscripten/html5.h>
+#include <emscripten/threading.h>
+
+#include "BasicBlock.h"
+#include "FrameDump.h"
+#include "Jitter_CodeGen_Wasm.h"
+#include "MIPS.h"
+#include "MemoryUtils.h"
+#include "Ps2Const.h"
+#include "ee/DMAC.h"
+#include "ee/GIF.h"
+#include "ee/INTC.h"
+#include "ee/MA_VU.h"
+#include "ee/Vif.h"
+#include "ee/Vpu.h"
+#include "ee/VuExecutor.h"
+#include "gs/GSH_OpenGL/GSH_OpenGL.h"
+#include "gs/GsPixelFormats.h"
+#include "DefaultAppConfig.h" // CAppConfig::GetBasePath, defined once per Play! app
+
+#include <pthread.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <map>
+#include <atomic>
+#include <cstdio>
+#include <condition_variable>
+#include <cstdlib>
+#include <deque>
+#include <mutex>
+#include <cstring>
+#include <iterator>
+#include <memory>
+#include <string>
+#include <vector>
+
+extern "C" uint32 LWL_Proxy(uint32, uint32, CMIPS*);
+extern "C" uint32 LWR_Proxy(uint32, uint32, CMIPS*);
+extern "C" uint64 LDL_Proxy(uint32, uint64, CMIPS*);
+extern "C" uint64 LDR_Proxy(uint32, uint64, CMIPS*);
+extern "C" void SWL_Proxy(uint32, uint32, CMIPS*);
+extern "C" void SWR_Proxy(uint32, uint32, CMIPS*);
+extern "C" void SDL_Proxy(uint32, uint64, CMIPS*);
+extern "C" void SDR_Proxy(uint32, uint64, CMIPS*);
+
+EM_JS_DEPS(ps2xShaderList, "$stringToNewUTF8,$UTF8ToString");
+
+// The shader list kept by an earlier session ("hex,hex,..."), read from IndexedDB (GL thread)
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2xPrecompileShaderList(char* list);
+
+namespace
+{
+	// PCSX2 GS dump packet types and the live extensions (gs_dump_writer.cpp).
+	constexpr uint8_t kTypeTransfer = 0;
+	constexpr uint8_t kTypeVSync = 1;
+	constexpr uint8_t kTypeReadFifo2 = 2;
+	constexpr uint8_t kTypeRegisters = 3;
