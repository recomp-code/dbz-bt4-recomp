diff --git a/ps2xRuntime/src/lib/ps2_seamvk_gl.cpp b/ps2xRuntime/src/lib/ps2_seamvk_gl.cpp
new file mode 100644
index 0000000..5a884fb
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_seamvk_gl.cpp
@@ -0,0 +1,223 @@
+// [glshare] The GL side of the native renderer's zero-copy present (see ps2_seamvk.h): the window's GL context imports
+// the shared images' memory once per image (GL_EXT_memory_object) and, per frame, a semaphore the Vulkan copy signals
+// (GL_EXT_semaphore), so the frame never goes through the CPU. A slot the window stops showing is handed back once a GL
+// fence placed after its last draw has signalled. Kept apart from ps2_runtime.cpp: it needs <windows.h>, which collides
+// with raylib's names there. No GL headers: the few entry points are loaded here.
+#include "runtime/ps2_seamvk.h"
+
+#if defined(PS2X_HAVE_SEAMVK)
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <type_traits>
+#include <vector>
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#define PS2X_GLAPI __stdcall
+#else
+#include <dlfcn.h>
+#include <unistd.h>
+#define PS2X_GLAPI
+#endif
+
+namespace seamvk
+{
+    namespace
+    {
+        typedef unsigned GLenum, GLuint, GLbitfield; typedef int GLint, GLsizei; typedef uint64_t GLuint64; typedef unsigned char GLubyte;
+        typedef struct __GLsync *GLsync;
+        enum : GLenum
+        {
+            kTex2D = 0x0DE1, kRGBA8 = 0x8058, kMinFilter = 0x2801, kMagFilter = 0x2800, kLinear = 0x2601, kWrapS = 0x2802, kWrapT = 0x2803,
+            kClampToEdge = 0x812F, kTexBinding2D = 0x8069, kExtensions = 0x1F03, kNumExtensions = 0x821D,
+            kDedicatedMemory = 0x9581, kOpaqueFd = 0x9586, kOpaqueWin32 = 0x9587, kDeviceUuid = 0x9597, kDriverUuid = 0x9598, kDeviceLuid = 0x9599,
+            kLayoutShaderReadOnly = 0x9591, kSyncGpuCommandsComplete = 0x9117, kSyncFlushCommands = 0x1, kAlreadySignaled = 0x911A, kConditionSatisfied = 0x911C,
+        };
+        struct Gl
+        {
+            void (PS2X_GLAPI *GenTextures)(GLsizei, GLuint *);
+            void (PS2X_GLAPI *DeleteTextures)(GLsizei, const GLuint *);
+            void (PS2X_GLAPI *BindTexture)(GLenum, GLuint);
+            void (PS2X_GLAPI *TexParameteri)(GLenum, GLenum, GLint);
+            void (PS2X_GLAPI *GetIntegerv)(GLenum, GLint *);
+            GLenum (PS2X_GLAPI *GetError)(void);
+            const GLubyte *(PS2X_GLAPI *GetStringi)(GLenum, GLuint);
+            void (PS2X_GLAPI *GetUnsignedBytevEXT)(GLenum, GLubyte *);
+            void (PS2X_GLAPI *GetUnsignedBytei_vEXT)(GLenum, GLuint, GLubyte *);
+            void (PS2X_GLAPI *CreateMemoryObjectsEXT)(GLsizei, GLuint *);
+            void (PS2X_GLAPI *DeleteMemoryObjectsEXT)(GLsizei, const GLuint *);
+            void (PS2X_GLAPI *MemoryObjectParameterivEXT)(GLuint, GLenum, const GLint *);
+            void (PS2X_GLAPI *TexStorageMem2DEXT)(GLenum, GLsizei, GLenum, GLsizei, GLsizei, GLuint, GLuint64);
+            void (PS2X_GLAPI *GenSemaphoresEXT)(GLsizei, GLuint *);
+            void (PS2X_GLAPI *DeleteSemaphoresEXT)(GLsizei, const GLuint *);
+            void (PS2X_GLAPI *WaitSemaphoreEXT)(GLuint, GLuint, const GLuint *, GLuint, const GLuint *, const GLenum *);
+#if defined(_WIN32)
+            void (PS2X_GLAPI *ImportMemoryWin32HandleEXT)(GLuint, GLuint64, GLenum, void *);
+            void (PS2X_GLAPI *ImportSemaphoreWin32HandleEXT)(GLuint, GLenum, void *);
+#else
+            void (PS2X_GLAPI *ImportMemoryFdEXT)(GLuint, GLuint64, GLenum, GLint);
+            void (PS2X_GLAPI *ImportSemaphoreFdEXT)(GLuint, GLenum, GLint);
+#endif
+            GLsync (PS2X_GLAPI *FenceSync)(GLenum, GLbitfield);
+            GLenum (PS2X_GLAPI *ClientWaitSync)(GLsync, GLbitfield, GLuint64);
+            void (PS2X_GLAPI *DeleteSync)(GLsync);
+        } gl;
+
+        struct GlSlot { GLuint tex = 0, mem = 0; uint32_t gen = 0, w = 0, h = 0; };
+        struct Retire { int slot; GLsync fence; };
+        GlSlot g_slots[8];
+        std::vector<Retire> g_retire;
+        int g_shown = -1;
+        int g_state = 0;   // 0 not tried yet, 1 sharing, -1 unavailable (readback path)
+
+        void closeExternal(intptr_t h)
+        {
+            if (h == -1) return;
+#if defined(_WIN32)
+            CloseHandle(reinterpret_cast<HANDLE>(h));
+#else
+            close(int(h));
+#endif
+        }
+        void *clientProc(const char *name)
+        {   // GL 1.1 is not returned by wglGetProcAddress
+#if defined(_WIN32)
+            static HMODULE lib = GetModuleHandleA("opengl32.dll");
+            return lib ? reinterpret_cast<void *>(GetProcAddress(lib, name)) : nullptr;
+#else
+            return dlsym(RTLD_DEFAULT, name);
+#endif
+        }
+        bool hasExtension(const char *name)
+        {
+            GLint n = 0; gl.GetIntegerv(kNumExtensions, &n);
+            for (GLint i = 0; i < n; ++i) { const GLubyte *e = gl.GetStringi(kExtensions, GLuint(i)); if (e && !std::strcmp(reinterpret_cast<const char *>(e), name)) return true; }
+            return false;
+        }
+        // 1 = ready, 0 = not yet (the Vulkan device does not exist yet), -1 = unavailable for good
+        int init(void *(*getProc)(const char *))
+        {
+            static const bool s_off = [](){ const char *v = std::getenv("PS2X_SEAMVK_GLSHARE"); return v && v[0] == '0'; }();
+            if (s_off || !getProc) return -1;
+            uint8_t luid[8], devUuid[16], drvUuid[16]; bool luidValid = false;
+            if (!share::deviceIds(luid, luidValid, devUuid, drvUuid)) return 0;
+            int missing = 0;
+            auto load = [&](auto &fn, const char *name) { void *p = getProc(name); if (!p) p = clientProc(name); fn = reinterpret_cast<std::remove_reference_t<decltype(fn)>>(p); if (!p) ++missing; };
+            load(gl.GenTextures, "glGenTextures"); load(gl.DeleteTextures, "glDeleteTextures"); load(gl.BindTexture, "glBindTexture");
+            load(gl.TexParameteri, "glTexParameteri"); load(gl.GetIntegerv, "glGetIntegerv"); load(gl.GetError, "glGetError"); load(gl.GetStringi, "glGetStringi");
+            load(gl.GetUnsignedBytevEXT, "glGetUnsignedBytevEXT"); load(gl.GetUnsignedBytei_vEXT, "glGetUnsignedBytei_vEXT");
+            load(gl.CreateMemoryObjectsEXT, "glCreateMemoryObjectsEXT"); load(gl.DeleteMemoryObjectsEXT, "glDeleteMemoryObjectsEXT");
+            load(gl.MemoryObjectParameterivEXT, "glMemoryObjectParameterivEXT"); load(gl.TexStorageMem2DEXT, "glTexStorageMem2DEXT");
+            load(gl.GenSemaphoresEXT, "glGenSemaphoresEXT"); load(gl.DeleteSemaphoresEXT, "glDeleteSemaphoresEXT"); load(gl.WaitSemaphoreEXT, "glWaitSemaphoreEXT");
