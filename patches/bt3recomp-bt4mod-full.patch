+            bool hostExited = false;
+            ps2live::RingHeader *header = nullptr;
+            ps2live::RingEvents *events = nullptr;
+            uint8_t *data = nullptr;
+            uint64_t capacity = 0;
+            uint64_t waitNs = 0; // time the game blocked on a full ring ([gslive] stats)
+
+            bool open()
+            {
+                capacity = 64ull << 20; // the browser build keeps memory small
+                void *block = std::aligned_alloc(64, static_cast<size_t>(ps2live::mappingSize(capacity)));
+                if (!block)
+                    return false;
