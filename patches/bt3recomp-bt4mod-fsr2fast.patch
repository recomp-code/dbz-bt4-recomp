 #include "image.hpp"
 #include "buffer.hpp"
 #include "command_buffer.hpp"
+#include <cstdio>
+#include <cstdlib>
 
 static constexpr unsigned FSR2_MAX_RESOURCE_COUNT = 64;
 static constexpr unsigned FSR2_MAX_GPU_JOBS = 32;
@@ -610,6 +612,26 @@ FfxErrorCode Granite::FSR2::DestroyResource(FfxFsr2Interface *backendInterface,
 #include "ffx_fsr2_granite_static_reflection.h"
 #include "fsr2_baked.inc"
 
+// [fsr2fast] AMD and Intel run FSR 2 faster in packed half precision (the FP16 passes) and AMD in 64-wide waves: both as
+// upstream FSR 2 picks them there. NVIDIA keeps FP32 / its 32-wide warps (FP16 is slow on the GTX 10 series, which use FSR 2,
+// not DLSS). PS2X_FSR2_FP16=0/1 and PS2X_FSR2_WAVE64=0/1 force either way.
+static bool fsr2Half(Vulkan::Device &device)
+{
+	static const int env = []() { const char *v = std::getenv("PS2X_FSR2_FP16"); return v && v[0] ? (v[0] == '1' ? 1 : 0) : -1; }();
+	auto &f = device.get_device_features();
+	const bool can = f.vk12_features.shaderFloat16 && f.vk11_features.storageBuffer16BitAccess;
+	const uint32_t vendor = device.get_gpu_properties().vendorID;
+	return can && (env >= 0 ? env == 1 : (vendor == 0x1002u || vendor == 0x8086u));
+}
+static bool fsr2Wave64(Vulkan::Device &device)
+{
+	static const int env = []() { const char *v = std::getenv("PS2X_FSR2_WAVE64"); return v && v[0] ? (v[0] == '1' ? 1 : 0) : -1; }();
+	auto &f = device.get_device_features();
+	const bool can = f.vk13_features.subgroupSizeControl && f.vk13_props.minSubgroupSize <= 64u && f.vk13_props.maxSubgroupSize >= 64u &&
+	                 (f.vk13_props.requiredSubgroupSizeStages & VK_SHADER_STAGE_COMPUTE_BIT) != 0;
+	return can && (env >= 0 ? env == 1 : device.get_gpu_properties().vendorID == 0x1002u);
+}
