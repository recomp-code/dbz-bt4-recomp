+// PS2Recomp: Apple MetalFX spatial upscaling of the displayed frame up to the window size (the Mac counterpart of
+// the Vulkan renderer's FSR 1 / DLSS). Returns 3 when used, 0 when MetalFX is unavailable.
+int GSDeviceMTL::DoUpscale(GSTexture* sTex, const GSVector4i& src_rect, GSTexture* dTex, int mode, float sharpness)
+{ @autoreleasepool {
+	if (mode == 0)
+		return 0;
+	if (@available(macOS 13.0, *))
+	{
+		id<MTLDevice> dev = m_dev.dev;
+		if (![MTLFXSpatialScalerDescriptor supportsDevice:dev])
+			return 0;
+		const int in_w = src_rect.width(), in_h = src_rect.height();
+		const int out_w = dTex->GetWidth(), out_h = dTex->GetHeight();
+		id<MTLTexture> src = static_cast<GSTextureMTL*>(sTex)->GetTexture();
+		const MTLPixelFormat fmt = [src pixelFormat];
+		if (!m_mfx_scaler || m_mfx_in_w != in_w || m_mfx_in_h != in_h || m_mfx_out_w != out_w || m_mfx_out_h != out_h ||
+			[(id<MTLFXSpatialScaler>)m_mfx_scaler.Get() colorTextureFormat] != fmt)
+		{
+			MTLFXSpatialScalerDescriptor* d = [MTLFXSpatialScalerDescriptor new];
+			d.inputWidth = in_w;
+			d.inputHeight = in_h;
+			d.outputWidth = out_w;
+			d.outputHeight = out_h;
+			d.colorTextureFormat = fmt;
+			d.outputTextureFormat = fmt;
+			d.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+			id<MTLFXSpatialScaler> sc = [d newSpatialScalerWithDevice:dev];
+			[d release];
+			if (!sc)
+			{
+				Console.Error("(PS2Recomp) MetalFX: could not create the spatial scaler %dx%d -> %dx%d", in_w, in_h, out_w, out_h);
+				m_mfx_scaler = nil;
+				return 0;
+			}
+			m_mfx_scaler = MRCTransfer((id)sc);
+			MTLTextureDescriptor* od = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt width:out_w height:out_h mipmapped:NO];
+			od.storageMode = MTLStorageModePrivate;
+			od.usage = sc.outputTextureUsage | MTLTextureUsageShaderRead;
+			m_mfx_out = MRCTransfer([dev newTextureWithDescriptor:od]);
+			MTLTextureDescriptor* id_ = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt width:in_w height:in_h mipmapped:NO];
+			id_.storageMode = MTLStorageModePrivate;
+			id_.usage = sc.colorTextureUsage | MTLTextureUsageShaderRead;
+			m_mfx_in = MRCTransfer([dev newTextureWithDescriptor:id_]);
+			m_mfx_in_w = in_w; m_mfx_in_h = in_h; m_mfx_out_w = out_w; m_mfx_out_h = out_h;
+		}
+		id<MTLFXSpatialScaler> sc = (id<MTLFXSpatialScaler>)m_mfx_scaler.Get();
+		g_perfmon.Put(GSPerfMon::TextureCopies, 1);
+		EndRenderPass();
+		id<MTLCommandBuffer> cb = GetRenderCmdBuf();
+		// MetalFX reads its input from the texture origin: copy the displayed rectangle out first.
+		id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+		[blit setLabel:@"MetalFX input"];
+		[blit copyFromTexture:src sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(src_rect.x, src_rect.y, 0)
+		           sourceSize:MTLSizeMake(in_w, in_h, 1) toTexture:m_mfx_in destinationSlice:0 destinationLevel:0
+		    destinationOrigin:MTLOriginMake(0, 0, 0)];
+		[blit endEncoding];
+		sc.colorTexture = m_mfx_in;
+		sc.outputTexture = m_mfx_out;
+		sc.inputContentWidth = in_w;
+		sc.inputContentHeight = in_h;
+		[sc encodeToCommandBuffer:cb];
+		blit = [cb blitCommandEncoder];
+		[blit setLabel:@"MetalFX output"];
+		[blit copyFromTexture:m_mfx_out sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+		           sourceSize:MTLSizeMake(out_w, out_h, 1) toTexture:static_cast<GSTextureMTL*>(dTex)->GetTexture()
+		     destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0, 0, 0)];
+		[blit endEncoding];
+		return 3;
+	}
+	return 0;
+}}
