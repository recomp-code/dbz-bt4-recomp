+	EM_BOOL OnKey(int eventType, const EmscriptenKeyboardEvent* e, void*)
+	{
+		if(eventType == EMSCRIPTEN_EVENT_KEYDOWN && std::strcmp(e->code, "F9") == 0 && g_traceState == 0)
+			g_traceState = 1;
+		uint32_t stick = 0;
+		const uint32_t bit = KeyBit(e->code, &stick);
+		if(g_debug)
+			std::printf("[pad] %s %s -> bit %08x stick %x\n", eventType == EMSCRIPTEN_EVENT_KEYDOWN ? "down" : "up", e->code, bit, stick);
+		if(!bit && !stick)
+			return EM_FALSE;
+		if(eventType == EMSCRIPTEN_EVENT_KEYDOWN)
+		{
+			g_keyButtons |= bit;
+			g_keyStick |= stick;
+		}
+		else
+		{
+			g_keyButtons &= ~bit;
+			g_keyStick &= ~stick;
+		}
+		return EM_TRUE; // no page scrolling with the arrows
+	}
