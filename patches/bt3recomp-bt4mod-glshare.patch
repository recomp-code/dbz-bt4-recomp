+#endif
+            { GLubyte d16[16] = {}, r16[16] = {}; gl.GetUnsignedBytei_vEXT(kDeviceUuid, 0, d16); gl.GetUnsignedBytevEXT(kDriverUuid, r16); same = !std::memcmp(d16, devUuid, 16) && !std::memcmp(r16, drvUuid, 16); }
