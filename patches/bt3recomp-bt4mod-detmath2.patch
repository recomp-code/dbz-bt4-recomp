+    if ((m & 2) && iy + (26u << 23) < ix) z = 0.0f;   // |y/x| < 0x1p-26, x < 0
+    else z = atanf(std::fabs(y / x));
+    switch (m)
+    {
+    case 0: return z;
+    case 1: return -z;
+    case 2: return pi - (z - pi_lo);
+    default: return (z - pi_lo) - pi;
+    }
