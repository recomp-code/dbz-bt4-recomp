     { extern GS *g_gsWb; if (!g_gsWb) g_gsWb = this; }
+    {   // [livelite] Live mode: PCSX2's GS renders every packet and answers the GS->EE downloads (sceGsExecStoreImage
+        // replaces our bytes with its readback), so nothing reads our VRAM, vertices or page stamps. Only what the game
+        // can observe is kept: the transfer registers (a download's size and position), the runtime's privileged-register
+        // shadows (0x59-0x5f, DISPFB/DISPLAY: flips) and SIGNAL/FINISH/LABEL (CSR, SIGLBLID). The full parse cost ~1/3 of a
+        // core in a 60 fps fight (texture uploads into our VRAM, every vertex, page stamps). PS2X_GS_LIVE_FULLPARSE=1
+        // restores it; the paraLLEl-GS pack mode needs it for its hashes.
+        static const bool s_lite = [](){ const char *l = std::getenv("PS2X_GS_LIVE"); const char *f = std::getenv("PS2X_GS_LIVE_FULLPARSE");
+                                         const bool on = l && l[0] && l[0] != '0' && !(f && f[0] == '1') && !ps2x_pgs::packMode();
+                                         if (on) std::fprintf(stderr, "[livelite] live GS: our parse keeps only transfer, privileged and SIGNAL/FINISH/LABEL registers\n");
+                                         return on; }();
+        if (s_lite)
+        {
+            uint32_t off = 0;
+            while (off + 16u <= sizeBytes)
+            {
+                uint64_t tagLo, tagHi;
+                std::memcpy(&tagLo, data + off, 8); std::memcpy(&tagHi, data + off + 8, 8);
+                off += 16u;
+                const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+                const uint8_t flg = static_cast<uint8_t>((tagLo >> 58) & 0x3u);
+                uint32_t nreg = static_cast<uint32_t>((tagLo >> 60) & 0xFu);
+                if (nreg == 0u) nreg = 16u;
+                if (flg == GIF_FMT_PACKED)
+                {
+                    bool anyAd = false;
+                    for (uint32_t r = 0; r < nreg; ++r) anyAd |= ((tagHi >> (4u * r)) & 0xFu) == 0xEu;
+                    if (!anyAd) { off += nloop * nreg * 16u; continue; }
+                    for (uint32_t loop = 0; loop < nloop; ++loop)
+                        for (uint32_t r = 0; r < nreg; ++r)
+                        {
+                            if (off + 16u > sizeBytes) return;
+                            if (((tagHi >> (4u * r)) & 0xFu) == 0xEu)
+                            {   // A+D: the register address is the low byte of the upper half
+                                const uint8_t a = data[off + 8];
+                                if ((a >= GS_REG_BITBLTBUF && a <= GS_REG_TRXDIR) || (a >= 0x59u && a <= 0x5Fu) ||
+                                    (a >= GS_REG_SIGNAL && a <= GS_REG_LABEL))
+                                {
+                                    uint64_t v; std::memcpy(&v, data + off, 8);
+                                    writeRegister(a, v);
+                                }
+                            }
+                            off += 16u;
+                        }
+                }
+                else if (flg == GIF_FMT_REGLIST)
+                {   // registers 0x0-0xD only: none of the ones kept above
+                    const uint32_t q = nloop * nreg;
+                    off += q * 8u + ((q & 1u) ? 8u : 0u);
+                }
+                else if (flg == GIF_FMT_IMAGE)
+                    off += nloop * 16u;   // texture data: PCSX2's VRAM, not ours
+            }
+            return;
+        }
+    }
