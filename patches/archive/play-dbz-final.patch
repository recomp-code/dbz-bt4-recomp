+//Superblocks: a block may span several VU basic blocks that follow each other when a conditional
+//branch is not taken (see CVuExecutor::PartitionNewFunction). Each one is compiled exactly as if it
+//were a block of its own (pipeline state, cycle quota, integer branch delays), but instead of
+//returning to the dispatcher between them, the code goes straight on to the next one when the branch
+//isn't taken. Taken branches leave through the usual block chaining.
+std::vector<uint32> CVuBasicBlock::FindSubBlockEnds() const
+{
+	std::vector<uint32> ends;
+	for(uint32 address = m_begin; address + 0xC < m_end; address += 8)
+	{
+		uint32 opcodeLo = m_context.m_pMemoryMap->GetInstruction(address);
+		if(IsConditionalBranch(opcodeLo))
+		{
+			ends.push_back(address + 0xC);
+			address += 8; //Skip the delay slot
+		}
+	}
+	ends.push_back(m_end);
+	return ends;
+}
