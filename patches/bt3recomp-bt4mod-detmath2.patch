+    if (ix == 0x3f800000u) return atanf(y);   // x = 1.0
+    const uint32_t m = ((iy >> 31) & 1u) | ((ix >> 30) & 2u);   // 2*sign(x)+sign(y)
+    ix &= 0x7fffffffu; iy &= 0x7fffffffu;
+    if (iy == 0)
+    {
+        switch (m) { case 0: case 1: return y; case 2: return pi; default: return -pi; }
+    }
+    if (ix == 0) return (m & 1) ? -pi / 2 : pi / 2;
+    if (ix == 0x7f800000u)
+    {
