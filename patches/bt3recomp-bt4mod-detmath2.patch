+    const uint32_t iz = ix - top;
+    const int k = int32_t(top) >> 23;
+    const double invc = kPowfLog2Tab[i].invc, logc = kPowfLog2Tab[i].logc;
+    const double z = double(asF32(iz));
+    const double r = z * invc - 1;
+    const double y0 = logc + double(k);
+    const double r2 = r * r;
+    double y = kPowfLog2Poly[0] * r + kPowfLog2Poly[1];
+    const double p = kPowfLog2Poly[2] * r + kPowfLog2Poly[3];
+    const double r4 = r2 * r2;
+    double q = kPowfLog2Poly[4] * r + y0;
+    q = p * r2 + q;
+    y = y * r4 + q;
