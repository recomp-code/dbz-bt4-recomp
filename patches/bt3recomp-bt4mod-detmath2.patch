+static inline float sinf(float x)
+{
+    uint32_t ix = asU32(x); const unsigned sign = ix >> 31; ix &= 0x7fffffffu;
+    if (ix <= 0x3f490fdau)   // |x| ~<= pi/4
+        return ix < 0x39800000u ? x : sindf(x);   // |x| < 2**-12: x
+    if (ix <= 0x407b53d1u)   // |x| ~<= 5*pi/4
+    {
+        if (ix <= 0x4016cbe3u) return sign ? -cosdf(x + s1pio2) : cosdf(x - s1pio2);
+        return sindf(sign ? -(x + s2pio2) : -(x - s2pio2));
+    }
+    if (ix <= 0x40e231d5u)   // |x| ~<= 9*pi/4
+    {
+        if (ix <= 0x40afeddfu) return sign ? cosdf(x + s3pio2) : -cosdf(x - s3pio2);
+        return sindf(sign ? x + s4pio2 : x - s4pio2);
+    }
+    if (ix >= 0x7f800000u) return x - x;
+    double y; const int n = remPio2f(x, &y);
+    switch (n & 3) { case 0: return sindf(y); case 1: return cosdf(y); case 2: return sindf(-y); default: return -cosdf(y); }
+}
+static inline float cosf(float x)
+{
+    uint32_t ix = asU32(x); const unsigned sign = ix >> 31; ix &= 0x7fffffffu;
+    if (ix <= 0x3f490fdau)
+        return ix < 0x39800000u ? 1.0f : cosdf(x);
+    if (ix <= 0x407b53d1u)
+    {
+        if (ix > 0x4016cbe3u) return -cosdf(sign ? x + s2pio2 : x - s2pio2);
+        return sign ? sindf(x + s1pio2) : sindf(s1pio2 - x);
+    }
+    if (ix <= 0x40e231d5u)
+    {
+        if (ix > 0x40afeddfu) return cosdf(sign ? x + s4pio2 : x - s4pio2);
+        return sign ? sindf(-x - s3pio2) : sindf(x - s3pio2);
+    }
+    if (ix >= 0x7f800000u) return x - x;
+    double y; const unsigned n = unsigned(remPio2f(x, &y));
+    switch (n & 3) { case 0: return cosdf(y); case 1: return sindf(-y); case 2: return -cosdf(y); default: return sindf(y); }
+}
+static inline float tanf(float x)
+{
+    uint32_t ix = asU32(x); const unsigned sign = ix >> 31; ix &= 0x7fffffffu;
+    if (ix <= 0x3f490fdau)
+        return ix < 0x39800000u ? x : tandf(x, 0);
+    if (ix <= 0x407b53d1u)
