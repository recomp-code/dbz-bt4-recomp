+static void LiveInviteFinish(const char* answer)
+{
+	if (s_invite_id.empty())
+		return;
+	if (answer)
+	{
+		if (const char* path = std::getenv("PS2X_INVITE_ANSWER"); path && path[0])
+		{
+			const std::string tmp = std::string(path) + ".tmp";
+			if (std::FILE* fp = FileSystem::OpenCFile(tmp.c_str(), "wb"))
+			{
+				std::fprintf(fp, "%s %s\n", s_invite_id.c_str(), answer);
+				std::fclose(fp);
+				FileSystem::RenamePath(tmp.c_str(), path);
+			}
+		}
+	}
+	s_invite_id.clear();
+	GSDumpReplayer::SetLiveInvite({}, {});
+	GSDumpReplayer::SetLiveMenuOpen(s_menu_open.load());
+}
+
+// Every vsync on the CPU thread: a new invitation file, and the timeout.
