index 4886320..8663e5c 100644
--- a/pcsx2-gsrunner/LiveMac.mm
+++ b/pcsx2-gsrunner/LiveMac.mm
@@ -10,6 +10,7 @@
 
 #import <AppKit/AppKit.h>
 #import <Carbon/Carbon.h> // kVK_* key codes
+#include <unistd.h> // _exit
 #import <GameController/GameController.h>
 
 #include <atomic>
@@ -193,8 +194,33 @@ namespace
 }
 @end
 
+// Cmd+Q, Quit from the Dock or a logout: [NSApp terminate:] would call exit() with the GS still running, and the static
+// destructors then crashed in GSTextureCache (SIGSEGV, a crash report on every quit). Quit does what closing the window
+// does: the VM stops in order and the process ends on its own. A second quit while that runs ends it at once, with
+// _exit, never through the static destructors.
+@interface PS2RecompLiveAppDelegate : NSObject <NSApplicationDelegate>
+@end
+
+@implementation PS2RecompLiveAppDelegate
+- (NSApplicationTerminateReply)applicationShouldTerminate:(NSApplication*)sender
+{
+	static bool s_asked = false;
+	if (s_asked || !s_callbacks.close)
+		_exit(0);
+	s_asked = true;
+	s_callbacks.close();
+	return NSTerminateCancel;
+}
+@end
+
 void LiveMac::Install(void* window_handle, const Callbacks& cb)
 {
+	static PS2RecompLiveAppDelegate* s_app_delegate = nil;
+	if (!s_app_delegate)
+	{
+		s_app_delegate = [[PS2RecompLiveAppDelegate alloc] init];
+		NSApp.delegate = s_app_delegate;
+	}
 	static PS2RecompLiveWindowDelegate* s_delegate = nil;
 	static id s_key_monitor = nil;
 
