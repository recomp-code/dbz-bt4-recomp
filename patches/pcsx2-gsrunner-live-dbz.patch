+
+// PS2X_SHOT_DIR=<dir>: writing a file name (e.g. "live_a.png") into <dir>/host.req makes the host save its own
+// rendered frame as <dir>/<name> (the request file is removed). On-demand screenshots for test scripts, without
+// desktop captures.
+static void LiveRequestedSnapshot()
+{
+	static const std::string dir = [] {
+		const char* value = std::getenv("PS2X_SHOT_DIR");
+		return std::string(value && *value ? value : "");
+	}();
+	if (dir.empty())
+		return;
+	static u32 s_poll = 0;
+	if ((s_poll++ % 8u) != 0u) // a stat() every 8 vsyncs is plenty
+		return;
+	const std::string req = Path::Combine(dir, "host.req");
+	std::FILE* fp = std::fopen(req.c_str(), "rb");
+	if (!fp)
+		return;
+	char name[256] = {};
+	const size_t n = std::fread(name, 1, sizeof(name) - 1, fp);
+	std::fclose(fp);
+	std::remove(req.c_str());
+	std::string file(name, n);
+	while (!file.empty() && (file.back() == '\n' || file.back() == '\r' || file.back() == ' '))
+		file.pop_back();
+	if (file.empty() || file.find('/') != std::string::npos)
+		file = "host_shot.png";
+	GSQueueSnapshot(Path::Combine(dir, file));
+}
