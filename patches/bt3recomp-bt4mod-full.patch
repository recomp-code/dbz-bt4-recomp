diff --git a/CMakeLists.txt b/CMakeLists.txt
index f2cc958..92efe9f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,7 +16,7 @@ project(PS2RetroX)
 # and then dies at link with ~20 undefined `_glBindTexture`-style symbols, which reads as a missing
 # OpenGL library rather than as the wrong architecture. Stop at configure and name the real cause.
 # (It also shrinks DrawCmd from 352 to 320 bytes, tripping a guard in the GPU renderer first.)
-if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT EMSCRIPTEN)
     message(FATAL_ERROR
         "PS2RetroX requires a 64-bit toolchain; this one targets ${CMAKE_SIZEOF_VOID_P}-byte pointers.\n"
         "  Windows: configure from the \"x64 Native Tools Command Prompt for VS\" (not the plain\n"
@@ -57,6 +57,13 @@ if(WIN32)
     add_compile_definitions(_CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
 endif()
 
+# [web] WebAssembly build (Emscripten): pthreads, wasm SIMD with the SSE4.2 headers, wasm exceptions.
+# The browser build is described in ps2xRuntime/web/web.cmake.
+if(EMSCRIPTEN)
+    add_compile_options(-msimd128 -msse4.2 -pthread -fwasm-exceptions)
+    add_link_options(-pthread -fwasm-exceptions)
+endif()
+
 option(PS2X_BUILD_RECOMP "Build ps2xRecomp" ON)
 option(PS2X_BUILD_RUNTIME "Build ps2xRuntime" ON)
 option(PS2X_BUILD_ANALYZER "Build ps2xAnalyzer" ON)
diff --git a/games/bt3/apply_patches.py b/games/bt3/apply_patches.py
index 0b18a43..155692d 100644
--- a/games/bt3/apply_patches.py
+++ b/games/bt3/apply_patches.py
@@ -172,6 +172,10 @@ def apply(output_dir: Path) -> int:
                 idx = text.find(lean)
                 if idx >= 0:
                     anchor = lean
+        if idx < 0 and patch.get("marker") == "[bt3 patch: truews]":
+            # DBZ BT4 mod: the ISO already has the 16:9 projection constant (0x3F10) built in
+            print(f"NOTE: {patch['marker']} skipped (projection constant differs: widescreen mod build)", file=sys.stderr)
+            continue
         if idx < 0:
             print(f"ERROR: anchor {anchor!r} not found in {patch['file']}", file=sys.stderr)
             failures += 1
