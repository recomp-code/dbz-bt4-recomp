+            }();
+            (void)s_initialized;
+            return w;
+        }
+
+        void snapshotRegisters(Writer &w, const GSRegisters &r)
+        {
+            auto put = [&](uint32_t offset, uint64_t value) { std::memcpy(w.regs.data() + offset, &value, sizeof(value)); };
+            auto pick = [&](uint32_t off, uint64_t live) { const uint32_t slot = off >> 4; return (w.streamHave & (1u << slot)) ? w.streamLo[slot] : live; };
+            put(0x0000u, pick(0x00u, r.pmode));
+            put(0x0010u, r.smode1 ? r.smode1 : 0x0000000740814504ULL); // NTSC default when the CRTC was never programmed
+            put(0x0020u, pick(0x20u, r.smode2));
+            put(0x0030u, r.srfsh);
+            put(0x0040u, r.synch1);
+            put(0x0050u, r.synch2);
+            put(0x0060u, r.syncv);
+            put(0x0070u, pick(0x70u, r.dispfb1));
+            put(0x0080u, pick(0x80u, r.display1));
+            put(0x0090u, pick(0x90u, r.dispfb2));
+            put(0x00A0u, pick(0xA0u, r.display2));
+            put(0x00B0u, r.extbuf);
+            put(0x00C0u, r.extdata);
+            put(0x00D0u, r.extwrite);
+            put(0x00E0u, pick(0xE0u, r.bgcolor));
+            put(0x1000u, r.csr.load(std::memory_order_relaxed));
+            put(0x1010u, r.imr);
+            put(0x1040u, r.busdir);
+            put(0x1080u, r.siglblid);
+        }
+
+        void writeTransferLocked(Writer &w, int path, const uint8_t *data, uint32_t size)
+        {
+            w.writeByte(kTypeTransfer);
+            w.writeByte(path == 1 ? kPath1New : (path == 2 ? kPath2 : kPath3));
+            w.writeWord(size);
+            w.write(data, size);
+            w.endPacket();
+        }
+    }
