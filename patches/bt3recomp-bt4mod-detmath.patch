+#pragma once
+// ps2xDetAcosf: acosf from musl (MIT; derived from FreeBSD msun, Sun Microsystems 1993), float arithmetic and an
+// IEEE sqrtf only, so it is bit-identical on every platform built with -ffp-contract=off (the host libms are not:
+// Apple's, bionic's and MSVC's acosf disagree in the last bit for many inputs).
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+static inline float ps2xDetAcosfR(float z)
+{
+    const float pS0 = 1.6666586697e-01f, pS1 = -4.2743422091e-02f, pS2 = -8.6563630030e-03f, qS1 = -7.0662963390e-01f;
+    const float p = z * (pS0 + z * (pS1 + z * pS2));
+    const float q = 1.0f + z * qS1;
+    return p / q;
+}
+static inline float ps2xDetAcosf(float x)
+{
+    const float pio2_hi = 1.5707962513e+00f, pio2_lo = 7.5497894159e-08f;
+    uint32_t hx; std::memcpy(&hx, &x, 4);
+    const uint32_t ix = hx & 0x7fffffffu;
+    if (ix >= 0x3f800000u)
+    {
+        if (ix == 0x3f800000u) return (hx >> 31) ? 2.0f * pio2_hi + 0x1p-120f : 0.0f;
+        return 0.0f / (x - x);
+    }
+    if (ix < 0x3f000000u)
+    {
+        if (ix <= 0x32800000u) return pio2_hi + 0x1p-120f;
+        return pio2_hi - (x - (pio2_lo - x * ps2xDetAcosfR(x * x)));
+    }
+    if (hx >> 31)
+    {
+        const float z = (1.0f + x) * 0.5f;
+        const float s = std::sqrt(z);
+        const float w = ps2xDetAcosfR(z) * s - pio2_lo;
+        return 2.0f * (pio2_hi - (s + w));
+    }
+    const float z = (1.0f - x) * 0.5f;
+    const float s = std::sqrt(z);
+    uint32_t hs; std::memcpy(&hs, &s, 4); hs &= 0xfffff000u;
+    float df; std::memcpy(&df, &hs, 4);
+    const float c = (z - df * df) / (s + df);
+    const float w = ps2xDetAcosfR(z) * s + c;
+    return 2.0f * (df + w);
+}
+
+// ps2xDetKernelSinf / ps2xDetKernelCosf: the float kernels of fdlibm (Sun Microsystems 1993, "Permission to use, copy,
+// modify, and distribute this software is freely granted, provided that this notice is preserved"; newlib's k_sinf.c /
+// k_cosf.c, which the game itself linked). The recompiler stubs the game's __kernel_sinf / __kernel_cosf with host
+// code; ::sinf / ::cosf there gave Apple and bionic results a bit apart, and every rotation the game builds goes
+// through them (online fights drifted apart, Mac vs Android). Float arithmetic only: bit-identical everywhere.
+static inline float ps2xDetKernelSinf(float x, float y, int iy)
+{
+    const float half = 5.0000000000e-01f, S1 = -1.6666667163e-01f, S2 = 8.3333337680e-03f, S3 = -1.9841270114e-04f,
+                S4 = 2.7557314297e-06f, S5 = -2.5050759689e-08f, S6 = 1.5896910177e-10f;
+    uint32_t ix; std::memcpy(&ix, &x, 4); ix &= 0x7fffffffu;
+    if (ix < 0x32000000u && static_cast<int>(x) == 0) return x;   // |x| < 2**-27
+    const float z = x * x, v = z * x;
+    const float r = S2 + z * (S3 + z * (S4 + z * (S5 + z * S6)));
+    if (iy == 0) return x + v * (S1 + z * r);
+    return x - ((z * (half * y - v * r) - y) - v * S1);
+}
+static inline float ps2xDetKernelCosf(float x, float y)
+{
+    const float one = 1.0f, C1 = 4.1666667908e-02f, C2 = -1.3888889225e-03f, C3 = 2.4801587642e-05f,
+                C4 = -2.7557314297e-07f, C5 = 2.0875723372e-09f, C6 = -1.1359647598e-11f;
+    uint32_t ix; std::memcpy(&ix, &x, 4); ix &= 0x7fffffffu;
+    if (ix < 0x32000000u && static_cast<int>(x) == 0) return one;   // |x| < 2**-27
+    const float z = x * x;
+    const float r = z * (C1 + z * (C2 + z * (C3 + z * (C4 + z * (C5 + z * C6)))));
+    if (ix < 0x3e99999au) return one - (0.5f * z - (z * r - x * y));   // |x| < 0.3
+    float qx;
+    if (ix > 0x3f480000u) qx = 0.28125f;   // |x| > 0.78125
+    else { const uint32_t q = ix - 0x01000000u; std::memcpy(&qx, &q, 4); }   // x/4
+    const float hz = 0.5f * z - qx, a = one - qx;
+    return a - (hz - (z * r - x * y));
+}
