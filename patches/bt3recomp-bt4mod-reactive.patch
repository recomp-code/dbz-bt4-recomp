diff --git a/ps2xRuntime/src/lib/seamvk/reactive.frag b/ps2xRuntime/src/lib/seamvk/reactive.frag
new file mode 100644
index 0000000..c220326
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/reactive.frag
@@ -0,0 +1,67 @@
+#version 450
+// [reactive] The upscaler's reactive mask: the shown scene's blended GS effect sprites (ki sparks, beams, glows) drawn again
+// into an R8 image, each pixel the share of its colour the effect puts there this frame (the blend weight, times the
+// effect's brightness when it adds onto the scene). DLSS (its bias-current-colour mask) and FSR 2 (reactive) then trust
+// the current frame there instead of the history: the effects carry no motion vectors, so the history smeared them into
+// trails. Texturing as gs.frag (GS draws: screen-linear s,t,q).
+layout(location = 0) noperspective in vec4 vColor;
+layout(location = 1) noperspective in vec3 vTex;
+layout(location = 2) noperspective in float vLit;
+layout(location = 3) noperspective in float vFog;
+layout(location = 4) flat in vec4 vRect;
+layout(set = 0, binding = 1) uniform sampler2D uTex;
+#include "pc.glsl"
+layout(location = 0) out float oMask;
+
+ivec2 wrapT(ivec2 t)
+{
+    int nat = max(pc.misc.x, 1);
+    ivec2 size = ivec2(pc.texInfo.xy) * nat;
+    int wms = pc.fA.z & 3, wmt = (pc.fA.z >> 2) & 3;
+    if (wms == 0) t.x = t.x & (size.x - 1);
+    else if (wms == 1) t.x = clamp(t.x, 0, size.x - 1);
+    else if (wms == 2) t.x = clamp(t.x, pc.fB.x * nat, pc.fB.y * nat + nat - 1);
+    else t.x = ((t.x / nat & pc.fB.x) | pc.fB.y) * nat + (t.x % nat);
+    if (wmt == 0) t.y = t.y & (size.y - 1);
+    else if (wmt == 1) t.y = clamp(t.y, 0, size.y - 1);
+    else if (wmt == 2) t.y = clamp(t.y, pc.fB.z * nat, pc.fB.w * nat + nat - 1);
+    else t.y = ((t.y / nat & pc.fB.z) | pc.fB.w) * nat + (t.y % nat);
+    return clamp(t, ivec2(0), size - 1);
+}
+
+void main()
+{
+    int flags = pc.fA.x;
+    vec4 c = vColor;
+    if ((flags & 1) != 0)
+    {
+        vec2 uv = ((flags & 2) != 0) ? vTex.xy : (vTex.xy / vTex.z) * pc.texInfo.xy;
+        float natf = float(max(pc.misc.x, 1)); uv *= natf;
+        vec4 rectN = vRect * natf;
+        if (vRect.x >= 0.0 && (flags & (32768 | 8)) != 0) uv = min(max(uv, rectN.xy), max(rectN.zw - natf, rectN.xy));
+        vec4 ct;
+        if ((flags & (32768 | 8)) != 0) ct = texture(uTex, uv / (pc.texInfo.xy * natf));   // (the mask needs no exact GS bilinear)
+        else ct = texelFetch(uTex, wrapT(ivec2(floor(uv))), 0);
+        int tfx = pc.fA.y;
+        bool tcc = (flags & 128) != 0;
+        vec3 cfs = c.rgb * (255.0 / 128.0);
+        float afs = c.a * (255.0 / 128.0);
+        if (tfx == 0)      { c.rgb = ct.rgb * cfs;       c.a = tcc ? ct.a * afs : c.a; }
+        else if (tfx == 1) { c.rgb = ct.rgb;             c.a = tcc ? ct.a : c.a; }
+        else if (tfx == 2) { c.rgb = ct.rgb * cfs + c.a; c.a = tcc ? ct.a + c.a : c.a; }
+        else               { c.rgb = ct.rgb * cfs + c.a; c.a = tcc ? ct.a : c.a; }
+        c = clamp(c, 0.0, 1.0);
+    }
+    float a255 = c.a * 255.0;
+    if ((flags & 16) != 0)
+    {   // the draw's alpha test: what it discards adds nothing
+        int atst = pc.fA.w & 7, aref = (pc.fA.w >> 3) & 0xFF, afail = (pc.fA.w >> 11) & 3;
+        int a = int(a255 + 0.5);
+        bool pass = atst == 1 || (atst == 2 && a < aref) || (atst == 3 && a <= aref) || (atst == 4 && a == aref) || (atst == 5 && a >= aref) || (atst == 6 && a > aref) || (atst == 7 && a != aref);
+        if (!pass && afail == 0) discard;
+    }
+    int aB = (pc.blend.y >> 2) & 3, aC = (pc.blend.y >> 4) & 3;
+    float w = aC == 2 ? float(pc.blend.z) / 128.0 : a255 / 128.0;   // the blend weight: FIX or As
+    float m = aB == 2 ? w * max(c.r, max(c.g, c.b)) : w;           // B = 0: the effect adds Cs * w onto the scene
+    oMask = clamp(m, 0.0, 1.0);   // (summed over the layered sprites; upaux.frag caps it)
+}
