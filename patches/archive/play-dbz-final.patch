+/////////////////////////////////////////////////////////////
+// Software sprites
+/////////////////////////////////////////////////////////////
+
+bool CGSH_OpenGL::DrawSpriteInSoftware()
+{
+	if(!m_softwareSpritesEnabled) return false; //[dbz] ?swsprites=0
+	uint64 prim = m_PrimitiveMode;
+	const bool textured = (prim >> 4) & 1;
+	const bool fog = (prim >> 5) & 1;
+	const bool blend = (prim >> 6) & 1;
+	const bool antialias = (prim >> 7) & 1;
+	const bool useUV = (prim >> 8) & 1;
+	const unsigned ctx = (prim >> 9) & 1;
+	if(fog || antialias) return false;
+
+	uint64 frameReg = m_nReg[GS_REG_FRAME_1 + ctx];
+	uint32 fbp = static_cast<uint32>(frameReg & 0x1FF);
+	uint32 fbw = static_cast<uint32>((frameReg >> 16) & 0x3F);
+	uint32 fpsm = static_cast<uint32>((frameReg >> 24) & 0x3F);
+	uint32 fbmsk = static_cast<uint32>(frameReg >> 32);
+	if((fpsm != PSMCT32) && (fpsm != PSMCT24)) return false;
+	if((fbw == 0) || (fbw * 64 > 256)) return false;
+
+	uint64 testReg = m_nReg[GS_REG_TEST_1 + ctx];
+	uint64 zbufReg = m_nReg[GS_REG_ZBUF_1 + ctx];
+	const bool zte = (testReg >> 16) & 1;
+	const uint32 ztst = (testReg >> 17) & 3;
+	const bool zmsk = (zbufReg >> 32) & 1;
+	if(zte && !(ztst == 1 && zmsk)) return false; //needs the depth buffer
+
+	uint64 tex0Reg = m_nReg[GS_REG_TEX0_1 + ctx];
+	uint64 tex1Reg = m_nReg[GS_REG_TEX1_1 + ctx];
+	auto tex0 = make_convertible<TEX0>(tex0Reg);
+	if(textured)
+	{
+		if((tex1Reg >> 5) & 1) return false; //bilinear magnification
+		switch(tex0.nPsm)
+		{
+		case PSMCT32: case PSMCT24: case PSMCT16: case PSMCT16S:
+		case PSMT8: case PSMT4: case PSMT8H: case PSMT4HL: case PSMT4HH:
+			break;
+		default:
+			return false;
+		}
+	}
+
+	//Pending GPU work must land first, in order
+	FlushVertexBuffer();
+	if(textured)
+	{
+		WriteBackOverlappingFramebuffers(tex0);
+	}
+	for(const auto& framebuffer : m_framebuffers)
+	{
+		if(framebuffer->m_gpuDirty && (framebuffer->m_basePtr == fbp * 8192))
+		{
+			m_wbStats[(static_cast<uint64>(framebuffer->m_basePtr) << 32) | (static_cast<uint64>(framebuffer->m_psm) << 24) | (0xFFull << 16)]++;
+			WriteBackFramebuffer(framebuffer);
+		}
+	}
+
+	//Vertices (12.4 fixed point), the second one carries the colour
+	auto offset = m_nReg[GS_REG_XYOFFSET_1 + ctx];
+	int32 ofx = static_cast<int32>(offset & 0xFFFF);
+	int32 ofy = static_cast<int32>((offset >> 32) & 0xFFFF);
+	int32 x[2], y[2];
+	int64 u[2] = {0, 0}, v[2] = {0, 0};
+	const uint32 texW = std::min<uint32>(tex0.GetWidth(), 1024);
+	const uint32 texH = std::min<uint32>(tex0.GetHeight(), 1024);
+	for(int i = 0; i < 2; i++)
+	{
+		const auto& vtx = m_VtxBuffer[1 - i];
+		x[i] = static_cast<int32>(vtx.position & 0xFFFF) - ofx;
+		y[i] = static_cast<int32>((vtx.position >> 16) & 0xFFFF) - ofy;
+		if(useUV)
+		{
+			u[i] = vtx.uv & 0x3FFF;
+			v[i] = (vtx.uv >> 16) & 0x3FFF;
+		}
+		else
+		{
+			float s, t, q;
+			uint32 sBits = static_cast<uint32>(vtx.st), tBits = static_cast<uint32>(vtx.st >> 32), qBits = static_cast<uint32>(vtx.rgbaq >> 32);
+			memcpy(&s, &sBits, 4);
+			memcpy(&t, &tBits, 4);
+			memcpy(&q, &qBits, 4);
+			if(q == 0) q = 1;
+			u[i] = static_cast<int64>(s / q * texW * 16.0f);
+			v[i] = static_cast<int64>(t / q * texH * 16.0f);
+		}
+	}
+	if(x[0] > x[1]) { std::swap(x[0], x[1]); std::swap(u[0], u[1]); }
+	if(y[0] > y[1]) { std::swap(y[0], y[1]); std::swap(v[0], v[1]); }
+
+	auto scissor = m_nReg[GS_REG_SCISSOR_1 + ctx];
+	int32 sx0 = static_cast<int32>(scissor & 0x7FF), sx1 = static_cast<int32>((scissor >> 16) & 0x7FF);
+	int32 sy0 = static_cast<int32>((scissor >> 32) & 0x7FF), sy1 = static_cast<int32>((scissor >> 48) & 0x7FF);
+	int32 px0 = std::max((x[0] + 15) >> 4, sx0), px1 = std::min(((x[1] + 15) >> 4) - 1, sx1);
+	int32 py0 = std::max((y[0] + 15) >> 4, sy0), py1 = std::min(((y[1] + 15) >> 4) - 1, sy1);
+	px1 = std::min<int32>(px1, fbw * 64 - 1);
+	py1 = std::min<int32>(py1, 2047);
+	m_softwareSprites++;
+	if((px0 > px1) || (py0 > py1)) return true;
+
+	//Colour of the primitive (flat: last vertex)
+	uint64 rgbaq = m_VtxBuffer[0].rgbaq;
+	const int32 vr = rgbaq & 0xFF, vg = (rgbaq >> 8) & 0xFF, vb = (rgbaq >> 16) & 0xFF, va = (rgbaq >> 24) & 0xFF;
+
+	//Texture sampling
+	uint64 clampReg = m_nReg[GS_REG_CLAMP_1 + ctx];
+	uint64 texaReg = m_nReg[GS_REG_TEXA];
+	const uint32 wms = clampReg & 3, wmt = (clampReg >> 2) & 3;
+	const uint32 minu = (clampReg >> 4) & 0x3FF, maxu = (clampReg >> 14) & 0x3FF;
+	const uint32 minv = (clampReg >> 24) & 0x3FF, maxv = (clampReg >> 34) & 0x3FF;
+	const uint32 ta0 = texaReg & 0xFF, ta1 = (texaReg >> 32) & 0xFF;
+	const bool aem = (texaReg >> 15) & 1;
+	const bool tcc = tex0.nColorComp != 0;
+	const uint32 tfx = tex0.nFunction;
+	std::array<uint32, 256> clut;
+	if(textured && CGsPixelFormats::IsPsmIDTEX(tex0.nPsm))
+	{
+		MakeLinearCLUT(tex0, clut);
+		if(tex0.nCPSM != PSMCT32)
+		{
+			for(auto& color : clut)
+			{
+				//16-bit CLUT: alpha from TEXA
+				uint32 rgb = color & 0xFFFFFF;
+				color = rgb | ((color >> 31) ? (ta1 << 24) : ((aem && rgb == 0) ? 0 : (ta0 << 24)));
+			}
+		}
+	}
+	auto wrap = [](int32 c, uint32 size, uint32 mode, uint32 minc, uint32 maxc) -> uint32 {
+		switch(mode)
+		{
+		case 0: return static_cast<uint32>(c) & (size - 1);
+		case 1: return static_cast<uint32>(std::clamp<int32>(c, 0, static_cast<int32>(size) - 1));
+		case 2: return static_cast<uint32>(std::clamp<int32>(c, static_cast<int32>(minc), static_cast<int32>(maxc)));
+		default: return (static_cast<uint32>(c) & minc) | maxc;
+		}
+	};
+	uint32 texBase = tex0.GetBufPtr();
+	uint32 texBufWidth = tex0.nBufWidth;
+	CGsPixelFormats::CPixelIndexorPSMCT32 tex32(m_pRAM, texBase, texBufWidth);
+	CGsPixelFormats::CPixelIndexorPSMCT16 tex16(m_pRAM, texBase, texBufWidth);
+	CGsPixelFormats::CPixelIndexorPSMCT16S tex16s(m_pRAM, texBase, texBufWidth);
+	CGsPixelFormats::CPixelIndexorPSMT8 tex8(m_pRAM, texBase, texBufWidth);
+	CGsPixelFormats::CPixelIndexorPSMT4 tex4(m_pRAM, texBase, texBufWidth);
+	auto fetch = [&](uint32 tx, uint32 ty) -> uint32 {
+		switch(tex0.nPsm)
+		{
+		case PSMCT32: return tex32.GetPixel(tx, ty);
+		case PSMCT24:
+		{
+			uint32 rgb = tex32.GetPixel(tx, ty) & 0xFFFFFF;
+			return rgb | ((aem && rgb == 0) ? 0 : (ta0 << 24));
+		}
+		case PSMCT16:
+		case PSMCT16S:
+		{
+			uint16 c = (tex0.nPsm == PSMCT16) ? tex16.GetPixel(tx, ty) : tex16s.GetPixel(tx, ty);
+			uint32 rgb = ((c & 0x1F) << 3) | (((c >> 5) & 0x1F) << 11) | (((c >> 10) & 0x1F) << 19);
+			return rgb | ((c & 0x8000) ? (ta1 << 24) : ((aem && (c & 0x7FFF) == 0) ? 0 : (ta0 << 24)));
+		}
+		case PSMT8: return clut[tex8.GetPixel(tx, ty)];
+		case PSMT4: return clut[tex4.GetPixel(tx, ty)];
+		case PSMT8H: return clut[tex32.GetPixel(tx, ty) >> 24];
+		case PSMT4HL: return clut[(tex32.GetPixel(tx, ty) >> 24) & 0xF];
+		default: return clut[tex32.GetPixel(tx, ty) >> 28];
+		}
+	};
+
+	//Pixel pipeline
+	uint64 alphaReg = m_nReg[GS_REG_ALPHA_1 + ctx];
+	const uint32 blendA = alphaReg & 3, blendB = (alphaReg >> 2) & 3, blendC = (alphaReg >> 4) & 3, blendD = (alphaReg >> 6) & 3;
+	const int32 blendFix = static_cast<int32>((alphaReg >> 32) & 0xFF);
+	const bool colClamp = m_nReg[GS_REG_COLCLAMP] & 1;
+	const bool pabe = m_nReg[GS_REG_PABE] & 1;
+	const bool fba = m_nReg[GS_REG_FBA_1 + ctx] & 1;
+	const bool ate = testReg & 1;
+	const uint32 atst = (testReg >> 1) & 7, aref = (testReg >> 4) & 0xFF, afail = (testReg >> 12) & 3;
+	const bool date = (testReg >> 14) & 1, datm = (testReg >> 15) & 1;
+	if(fpsm == PSMCT24) fbmsk |= 0xFF000000;
+	CGsPixelFormats::CPixelIndexorPSMCT32 target(m_pRAM, fbp * 8192, fbw);
+	const int64 du = (x[1] != x[0]) ? ((u[1] - u[0]) << 16) / (x[1] - x[0]) : 0;
+	const int64 dv = (y[1] != y[0]) ? ((v[1] - v[0]) << 16) / (y[1] - y[0]) : 0;
+
+	for(int32 py = py0; py <= py1; py++)
+	{
+		const int64 vv = v[0] + ((((static_cast<int64>(py) << 4) - y[0]) * dv) >> 16);
+		for(int32 px = px0; px <= px1; px++)
+		{
+			int32 r = vr, g = vg, b = vb, a = va;
+			if(textured)
+			{
+				const int64 uu = u[0] + ((((static_cast<int64>(px) << 4) - x[0]) * du) >> 16);
+				uint32 texel = fetch(wrap(static_cast<int32>(uu >> 4), texW, wms, minu, maxu), wrap(static_cast<int32>(vv >> 4), texH, wmt, minv, maxv));
+				int32 tr = texel & 0xFF, tg = (texel >> 8) & 0xFF, tb = (texel >> 16) & 0xFF, ta = texel >> 24;
+				switch(tfx)
+				{
+				case 0: //MODULATE
+					r = std::min((tr * vr) >> 7, 255);
+					g = std::min((tg * vg) >> 7, 255);
+					b = std::min((tb * vb) >> 7, 255);
+					if(tcc) a = std::min((ta * va) >> 7, 255);
+					break;
+				case 1: //DECAL
+					r = tr; g = tg; b = tb;
+					if(tcc) a = ta;
+					break;
+				default: //HIGHLIGHT, HIGHLIGHT2
+					r = std::min(((tr * vr) >> 7) + va, 255);
+					g = std::min(((tg * vg) >> 7) + va, 255);
+					b = std::min(((tb * vb) >> 7) + va, 255);
+					if(tcc) a = (tfx == 2) ? std::min(ta + va, 255) : ta;
+					break;
+				}
+			}
+
+			uint32* pixel = target.GetPixelAddress(px, py);
+			const uint32 dst = *pixel;
+			uint32 mask = fbmsk;
+			if(date && (((dst >> 31) & 1) != static_cast<uint32>(datm))) continue;
+			if(ate)
+			{
+				bool pass = true;
+				switch(atst)
+				{
+				case 0: pass = false; break;
+				case 1: pass = true; break;
+				case 2: pass = static_cast<uint32>(a) < aref; break;
+				case 3: pass = static_cast<uint32>(a) <= aref; break;
+				case 4: pass = static_cast<uint32>(a) == aref; break;
+				case 5: pass = static_cast<uint32>(a) >= aref; break;
+				case 6: pass = static_cast<uint32>(a) > aref; break;
+				case 7: pass = static_cast<uint32>(a) != aref; break;
+				}
+				if(!pass)
+				{
+					if(afail == 0 || afail == 2) continue; //KEEP, ZB_ONLY (no depth here)
+					if(afail == 3) mask |= 0xFF000000;      //RGB_ONLY
+				}
+			}
+			if(blend && !(pabe && (a & 0x80) == 0))
+			{
+				const int32 dr = dst & 0xFF, dg = (dst >> 8) & 0xFF, db = (dst >> 16) & 0xFF, da = dst >> 24;
+				auto pick = [](uint32 sel, int32 s, int32 d) { return sel == 0 ? s : (sel == 1 ? d : 0); };
+				const int32 c = blendC == 0 ? a : (blendC == 1 ? da : blendFix);
+				r = (((pick(blendA, r, dr) - pick(blendB, r, dr)) * c) >> 7) + pick(blendD, r, dr);
+				g = (((pick(blendA, g, dg) - pick(blendB, g, dg)) * c) >> 7) + pick(blendD, g, dg);
+				b = (((pick(blendA, b, db) - pick(blendB, b, db)) * c) >> 7) + pick(blendD, b, db);
+				if(colClamp)
+				{
+					r = std::clamp(r, 0, 255); g = std::clamp(g, 0, 255); b = std::clamp(b, 0, 255);
+				}
+				else
+				{
+					r &= 0xFF; g &= 0xFF; b &= 0xFF;
+				}
+			}
+			if(fba) a |= 0x80;
+			const uint32 src = static_cast<uint32>(r) | (static_cast<uint32>(g) << 8) | (static_cast<uint32>(b) << 16) | (static_cast<uint32>(a & 0xFF) << 24);
+			*pixel = (dst & mask) | (src & ~mask);
+		}
+	}
+
+	//GS RAM changed under the GPU copies and the cached textures
+	auto pageSize = CGsPixelFormats::GetPsmPageSize(PSMCT32);
+	uint32 start = fbp * 8192 + (py0 / pageSize.second) * fbw * CGsPixelFormats::PAGESIZE;
+	uint32 size = ((py1 / pageSize.second) - (py0 / pageSize.second) + 1) * fbw * CGsPixelFormats::PAGESIZE;
+	m_textureCache.InvalidateRange(start, size);
+	HdInvalidate(start, size);
+	for(const auto& framebuffer : m_framebuffers)
+	{
+		framebuffer->m_cachedArea.Invalidate(start, size);
+	}
+	return true;
+}
