+    // view's SCISSOR; PCSX2's GS gets the packets before those rewrites, so the same rule runs here, on the copy
+    // that goes to the live ring: the other view's SCISSOR becomes an empty rect (x0 2047 > x1 0) and PCSX2 skips
+    // its draws (m_scissor_invalid). Full-width/HUD/post-pass scissors are never touched. PS2X_VPKEEP=1|2 forces it.
+    int netViewKeep()
+    {
+        static const int s_env = [](){ const char *e = std::getenv("PS2X_VPKEEP"); return (e && e[0]) ? std::atoi(e) : 0; }();
+        if (s_env == 1 || s_env == 2) return s_env;
+        return ps2NetActive() ? ps2NetLocalPlayer() : 0;
