+    // [gslive] With PCSX2's GS host drawing the game, its window has the focus: player 1 also gets that window's
+    // keyboard + gamepad (published in the live ring), merged with whatever the runtime itself reads. While the host's
+    // options menu (F1) is open the game gets no input at all.
+    static void mergeLivePad(PadPacket &pkt, size_t player)
+    {
+        if (player != 0u || !ps2_gslive::liveActive())
+            return;
+        if (ps2_gslive::hostMenuOpen())
+        {
+            pkt = PadPacket{};
+            return;
+        }
+        uint32_t buttons = 0, axes = 0x80808080u;
+        if (!ps2_gslive::remotePad(buttons, axes))
+            return;
+        {   // PS2X_GSLIVE_PADLOG=1: every change of the host window's pad state
+            static const bool s_log = [](){ const char *v = std::getenv("PS2X_GSLIVE_PADLOG"); return v && v[0] == '1'; }();
+            static uint32_t s_last = 0;
+            if (s_log && buttons != s_last) { std::fprintf(stderr, "[gslive] host pad %04x axes %08x\n", buttons, axes); s_last = buttons; }
+        }
+        pkt.buttons = static_cast<uint16_t>(pkt.buttons & ~(buttons & 0xFFFFu));   // active-high -> active-low
+        auto axis = [](uint8_t &dst, uint32_t v) { if (v < 0x60u || v > 0xA0u) dst = static_cast<uint8_t>(v); };
