+	if (!s_invite_id.empty() && std::chrono::steady_clock::now() - s_invite_since > std::chrono::seconds(30))
+		LiveInviteFinish(nullptr);
+	static int s_tick = 0;
+	if (++s_tick % 15 != 0)
