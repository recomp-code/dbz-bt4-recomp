+// [invite] An online invitation received while playing. The launcher writes PS2X_INVITE_FILE ("<id>\n<from>\n<line>"),
+// the host takes it (removes the file: the launcher knows it is on screen) and draws it over the game; A / Enter
+// accepts, B / Escape declines, and the answer goes to PS2X_INVITE_ANSWER ("<id> accept|decline"). Meanwhile the
+// pad is the host's (like the options menu): the game does not see the press. 30 s without an answer hide it.
+namespace
+{
+	std::string s_invite_id;
+	std::chrono::steady_clock::time_point s_invite_since{};
+} // namespace
