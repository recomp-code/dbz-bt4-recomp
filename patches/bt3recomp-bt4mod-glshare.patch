+        }
+        void dropSlot(GlSlot &s)
+        {
+            if (s.tex) gl.DeleteTextures(1, &s.tex);
+            if (s.mem) gl.DeleteMemoryObjectsEXT(1, &s.mem);
+            s = GlSlot();
+        }
+        bool importSlot(GlSlot &s, const share::Frame &f)
+        {
+            dropSlot(s);
+            gl.CreateMemoryObjectsEXT(1, &s.mem);
