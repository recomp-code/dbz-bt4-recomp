+
+    bool otherView(uint64_t v, int keep)
+    {
+        const uint32_t sx0 = uint32_t(v & 0x7FFu), sx1 = uint32_t((v >> 16) & 0x7FFu);
+        const uint32_t sy0 = uint32_t((v >> 32) & 0x7FFu), sy1 = uint32_t((v >> 48) & 0x7FFu);
+        if (sy1 < 400u) return false;   // only the full-height scene views
+        const bool leftVp = sx0 == 0u && sx1 > 0u && sx1 <= 255u, rightVp = sx0 >= 256u;
+        const bool p1Full = sx0 == 0u && sx1 == 511u && sy0 == 1u, p2Full = sx0 == 0u && sx1 == 511u && sy0 == 2u;
+        return keep == 1 ? (rightVp || p2Full) : (leftVp || p1Full);
+    }
+
+    // Returns the packet to send: `data` itself, or a rewritten copy in `scratch` when a SCISSOR had to go.
+    const uint8_t *netViewFilter(const uint8_t *data, uint32_t size, std::vector<uint8_t> &scratch)
+    {
+        const int keep = netViewKeep();
+        if (keep != 1 && keep != 2) return data;
+        uint8_t *out = nullptr;
+        size_t off = 0;
+        while (off + 16u <= size)
+        {
+            uint64_t lo, hi; std::memcpy(&lo, data + off, 8); std::memcpy(&hi, data + off + 8, 8);
+            const uint32_t nloop = uint32_t(lo & 0x7FFFu), flg = uint32_t((lo >> 58) & 3u);
+            uint32_t nreg = uint32_t((lo >> 60) & 0xFu); if (nreg == 0u) nreg = 16u;
+            off += 16u;
+            if (nloop == 0u) continue;
+            if (flg == 0u)
+            {   // PACKED: SCISSOR_1/2 only arrive as A+D (descriptor 0xE, address 0x40/0x41)
+                const size_t bytes = size_t(nloop) * nreg * 16u;
+                if (off + bytes > size) break;
+                bool anyAd = false;
+                for (uint32_t i = 0; i < nreg; i++) anyAd |= ((hi >> (4 * i)) & 0xFu) == 0xEu;
+                if (anyAd)
+                    for (uint32_t l = 0; l < nloop; l++)
+                        for (uint32_t i = 0; i < nreg; i++)
+                        {
+                            if (((hi >> (4 * i)) & 0xFu) != 0xEu) continue;
+                            const size_t q = off + (size_t(l) * nreg + i) * 16u;
+                            const uint8_t addr = data[q + 8];
+                            if (addr != 0x40u && addr != 0x41u) continue;
+                            uint64_t v; std::memcpy(&v, data + q, 8);
+                            if (!otherView(v, keep)) continue;
+                            if (!out) { scratch.assign(data, data + size); out = scratch.data(); }
+                            const uint64_t empty = (v & ~(0x7FFull | (0x7FFull << 16))) | 0x7FFull;   // x0 = 2047 > x1 = 0
+                            std::memcpy(out + q, &empty, 8);
+                            static std::atomic<uint32_t> s_said{0};
+                            if (s_said.fetch_add(1u) < 3u)
+                                std::fprintf(stderr, "[netview] player %d: the other player's view is not drawn (scissor x %u..%u y %u..%u)\n",
+                                             keep, uint32_t(v & 0x7FFu), uint32_t((v >> 16) & 0x7FFu), uint32_t((v >> 32) & 0x7FFu), uint32_t((v >> 48) & 0x7FFu));
+                        }
+                off += bytes;
+            }
+            else if (flg == 1u)
+                off += (size_t(nloop) * nreg + 1u) / 2u * 16u;   // REGLIST: no SCISSOR there
+            else
+                off += size_t(nloop) * 16u;                     // IMAGE
+        }
+        return out ? out : data;
+    }
+}
