+    const double r = xd - kd;
+    uint64_t t = kExp2fTab[ki % 32];
+    const uint64_t ski = ki + signBias;
+    t += ski << (52 - 5);
+    const double s = asF64(t);
+    const double z = kExp2fPoly[0] * r + kExp2fPoly[1], r2 = r * r;
+    double y = kExp2fPoly[2] * r + 1;
+    y = z * r2 + y;
