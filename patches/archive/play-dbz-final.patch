+//PSMT4 pixel places inside a page (128x128): byte offset of the 32-bit word << 5 | bit shift,
+//from the same column math as CPixelIndexor<PSMT4>
+static const uint32* GetPsmt4PagePlaces()
+{
+	static const std::vector<uint32> places = [] {
+		typedef CGsPixelFormats::STORAGEPSMT4 Storage;
+		std::vector<uint32> result(Storage::PAGEWIDTH * Storage::PAGEHEIGHT);
+		std::vector<uint8> scratch(CGSHandler::RAMSIZE);
+		CGsPixelFormats::CPixelIndexorPSMT4 indexor(scratch.data(), 0, Storage::PAGEWIDTH / 64);
+		for(uint32 y = 0; y < Storage::PAGEHEIGHT; y++)
+		{
+			for(uint32 x = 0; x < Storage::PAGEWIDTH; x++)
+			{
+				const unsigned int columnNum = (y / Storage::COLUMNHEIGHT) & 0x01;
+				const unsigned int shift = (x & 0x18) + ((y & 0x02) << 1);
+				const unsigned int subTable = ((y & 0x02) >> 1) ^ columnNum;
+				uint32 columnX = x, columnY = y;
+				const uint32 address = indexor.GetColumnAddress(columnX, columnY);
+				const uint32 word = address + 4 * Storage::m_nColumnWordTable[subTable][y & 0x01][x & 0x07];
+				result[y * Storage::PAGEWIDTH + x] = (word << 5) | shift;
+			}
+		}
+		return result;
+	}();
+	return places.data();
+}
