+  // worklet plays it from there. Browsers only start audio after a click or a key press.
+  const audioWorklet = `
+    class Ps2xOutput extends AudioWorkletProcessor {
+      constructor(options) {
+        super();
+        const o = options.processorOptions;
+        this.ring = new Int16Array(o.buffer, o.ring, o.frames * 2);
+        this.index = new Uint32Array(o.buffer, o.index, 2);
+        this.frames = o.frames;
+        this.waiting = true;
+        this.lastL = this.lastR = 0;
+        this.fadeLeft = 0; this.fadeFrom = 0; this.fadeIn = 128;
+        this.underruns = this.skips = this.blocks = 0;
+        this.frac = 0;
+        // Frames kept queued: ~50 ms (phones ~100 ms), growing after each underrun up to 150 ms
+        // (phones 200 ms), whose threads get descheduled more often
+        // [starting target, largest target] in frames (48 kHz); stable rides out ~1/3 s hiccups
+        const sizes = { low: [1600, 4800], normal: [2400, 7200], stable: [6000, 16000] }[o.mode] || [2400, 7200];
+        this.target = sizes[0];
+        this.maxTarget = sizes[1];
+        this.level = this.target;
+        this.capture = null;
+        this.port.onmessage = (e) => { if (e.data === 'capture') this.capture = []; };
+      }
+      // No allocations in here: the audio thread must never wait for the garbage collector
+      // (on phones its pauses were heard as glitches).
+      left16(pos) { return this.ring[(pos % this.frames) * 2] * (1 / 32768); }
+      right16(pos) { return this.ring[(pos % this.frames) * 2 + 1] * (1 / 32768); }
+      process(inputs, outputs) {
+        const left = outputs[0][0], right = outputs[0][1];
+        const written = Atomics.load(this.index, 0);
+        let read = Atomics.load(this.index, 1);
+        let queued = (written - read) >>> 0;
+        // Far too much queued (the game caught up after a stall): jump ahead, cross-fading from the
+        // old position over 128 samples (a speed-up would be heard as faster, higher sound)
+        if (queued > Math.min(this.frames - 2048, this.target * 2.5)) {
+          this.fadeFrom = read; this.fadeLeft = 128;
+          read = (written - this.target) >>> 0; queued = this.target; this.level = queued; this.skips++;
+        }
+        // Back from a gap as soon as some sound is queued (it fades in), not after a long silence
+        if (this.waiting && queued >= this.target * 0.4) { this.waiting = false; this.fadeIn = 0; }
+        if (!this.waiting && queued < left.length + 2) {
+          // Ran dry: keep a bit more sound queued from now on
+          this.waiting = true; this.underruns++;
+          this.target = Math.min(this.target + 600, this.maxTarget);
+        }
+        // The game's clock and the sound card's differ (the game makes ~48-49 kHz): play slightly
+        // faster or slower, at most 3% (not heard), to keep the target queued
+        this.level += (queued - this.level) * 0.01;
+        const step = 1 + Math.max(-0.03, Math.min(0.03, (this.level - this.target) / this.target * 0.04));
+        for (let i = 0; i < left.length; i++) {
+          if (!this.waiting && ((written - read) >>> 0) > 1) {
+            const next = (read + 1) >>> 0;
+            const l0 = this.left16(read), r0 = this.right16(read);
+            let outL = l0 + (this.left16(next) - l0) * this.frac;
+            let outR = r0 + (this.right16(next) - r0) * this.frac;
+            if (this.fadeLeft > 0) { // cross-fade from where it was before a jump
+              const k = this.fadeLeft / 128;
+              outL = outL * (1 - k) + this.left16(this.fadeFrom) * k;
+              outR = outR * (1 - k) + this.right16(this.fadeFrom) * k;
+              this.fadeFrom = (this.fadeFrom + 1) >>> 0; this.fadeLeft--;
+            }
+            if (this.fadeIn < 128) { // back from a gap: fade in instead of a click
+              const g = ++this.fadeIn / 128;
+              outL = this.lastL + (outL - this.lastL) * g; outR = this.lastR + (outR - this.lastR) * g;
+            }
+            this.lastL = outL;
+            this.lastR = outR;
+            this.frac += step;
+            const whole = Math.floor(this.frac);
+            this.frac -= whole;
+            read = (read + whole) >>> 0;
+          } else {
+            this.lastL *= 0.995; this.lastR *= 0.995;
+          }
+          left[i] = this.lastL;
+          right[i] = this.lastR;
+          if (this.capture && !this.waiting) { this.capture.push(this.lastL); if (this.capture.length >= 48000 * 8) { this.port.postMessage({ capture: this.capture }); this.capture = null; } }
+        }
+        Atomics.store(this.index, 1, read);
+        if (++this.blocks % 1500 === 0) {
+          const produced = ((written - (this.lastWritten ?? written)) >>> 0) / (currentTime - (this.lastTime ?? currentTime) || 1);
+          this.lastWritten = written; this.lastTime = currentTime;
+          this.port.postMessage({ underruns: this.underruns, skips: this.skips, queued, step, produced, target: this.target });
+        }
+        return true;
+      }
+    }
+    registerProcessor('ps2x-output', Ps2xOutput);`;
+  async function ps2xStartAudio(buffer, ring, frames, index) {
+    audioContext ??= new AudioContext({ sampleRate: 48000, latencyHint: audioMode() === 'stable' ? 'playback' : 'interactive' });
+    const url = URL.createObjectURL(new Blob([audioWorklet], { type: 'text/javascript' }));
+    await audioContext.audioWorklet.addModule(url);
+    const node = new AudioWorkletNode(audioContext, 'ps2x-output', {
+      numberOfInputs: 0, outputChannelCount: [2],
+      processorOptions: { buffer, ring, frames, index, mode: audioMode() },
+    });
+    node.connect(audioContext.destination);
+    node.port.onmessage = (e) => {
+      if (e.data.capture) { window.ps2xAudioCapture = e.data.capture; return; }
+      append(`[audio] underruns ${e.data.underruns}, skips ${e.data.skips}, queued ${e.data.queued}, rate ${e.data.step.toFixed(4)}, target ${e.data.target}, game makes ${e.data.produced.toFixed(0)} Hz`);
+    };
+    window.ps2xAudioNode = node;
+    if (audioContext.state !== 'running') sound.hidden = false;
+  }
+  const sound = document.getElementById('sound');
+  function resumeAudio() {
+    if (audioContext && audioContext.state !== 'running') audioContext.resume().then(() => { sound.hidden = true; });
+  }
+  for (const type of ['pointerdown', 'keydown']) window.addEventListener(type, resumeAudio, { capture: true });
+  window.addEventListener('gamepadconnected', resumeAudio);
+  sound.onclick = resumeAudio;
+</script>
+<script src="ps2EntryRunner.js"></script>
+</body>
+</html>
diff --git a/ps2xRuntime/web/wasm_compat.h b/ps2xRuntime/web/wasm_compat.h
new file mode 100644
index 0000000..8454524
--- /dev/null
+++ b/ps2xRuntime/web/wasm_compat.h
@@ -0,0 +1,19 @@
+// [web] Force-included in every translation unit of the browser build (web/web.cmake).
+#pragma once
+#if defined(__EMSCRIPTEN__)
+#include <xmmintrin.h>
+#ifdef __cplusplus
+// xxhash.h includes <arm_neon.h> inside its extern "C" block on wasm SIMD, and that pulls in the em_asm
+// templates: include them here first, at C++ linkage.
+#include <emscripten/em_asm.h>
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Emscripten's SSE headers have _mm_getcsr but no _mm_setcsr: WebAssembly has no rounding-mode or
+// flush-to-zero control, so the native builds' MXCSR changes (EE rounding, VU denormals) are no-ops here.
+static inline void _mm_setcsr(unsigned int csr) { (void)csr; }
+#ifdef __cplusplus
+}
+#endif
+#endif
