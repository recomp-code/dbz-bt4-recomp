 }
 vec4 fetchT(ivec2 t) { return texelFetch(uTex, wrapT(t), 0); }
 
+// [sharpmag] Catmull-Rom through the hardware sampler (9 bilinear taps, the weights folded into the tap positions): the
+// low-resolution PS2 textures are MAGNIFIED at 2x-4x render scale, where bilinear blurs them. Colour only; overshoot clamped.
+vec3 catmullRom(vec2 tuv, vec2 tsz, vec2 gx, vec2 gy)
+{
+    vec2 sp = tuv * tsz, t1 = floor(sp - 0.5) + 0.5, f = sp - t1;
+    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f)), w1 = 1.0 + f * f * (-2.5 + 1.5 * f), w2 = f * (0.5 + f * (2.0 - 1.5 * f)), w3 = f * f * (-0.5 + 0.5 * f);
+    vec2 w12 = w1 + w2, t12 = (t1 + w2 / w12) / tsz, t0 = (t1 - 1.0) / tsz, t3 = (t1 + 2.0) / tsz;
+    vec3 r = vec3(0.0);
+    r += textureGrad(uTex, vec2(t0.x, t0.y), gx, gy).rgb * w0.x * w0.y;
+    r += textureGrad(uTex, vec2(t12.x, t0.y), gx, gy).rgb * w12.x * w0.y;
+    r += textureGrad(uTex, vec2(t3.x, t0.y), gx, gy).rgb * w3.x * w0.y;
+    r += textureGrad(uTex, vec2(t0.x, t12.y), gx, gy).rgb * w0.x * w12.y;
+    r += textureGrad(uTex, vec2(t12.x, t12.y), gx, gy).rgb * w12.x * w12.y;
+    r += textureGrad(uTex, vec2(t3.x, t12.y), gx, gy).rgb * w3.x * w12.y;
+    r += textureGrad(uTex, vec2(t0.x, t3.y), gx, gy).rgb * w0.x * w3.y;
+    r += textureGrad(uTex, vec2(t12.x, t3.y), gx, gy).rgb * w12.x * w3.y;
+    r += textureGrad(uTex, vec2(t3.x, t3.y), gx, gy).rgb * w3.x * w3.y;
+    return r;
+}
+
