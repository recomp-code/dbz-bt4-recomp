+	uint32_t KeyBit(const char* code, uint32_t* stick)
+	{
+		struct Map { const char* code; uint32_t bit; uint32_t stick; };
+		static const Map kMap[] = {
+			{"ArrowUp", 1u << 4, 0}, {"ArrowRight", 1u << 5, 0}, {"ArrowDown", 1u << 6, 0}, {"ArrowLeft", 1u << 7, 0},
+			{"KeyZ", 1u << 15, 0}, {"KeyX", 1u << 14, 0}, {"KeyC", 1u << 13, 0}, {"KeyV", 1u << 12, 0},
+			{"KeyQ", 1u << 10, 0}, {"KeyE", 1u << 11, 0}, {"Digit1", 1u << 8, 0}, {"Digit3", 1u << 9, 0},
+			{"Enter", 1u << 3, 0}, {"Backspace", 1u << 0, 0}, {"ShiftRight", 1u << 0, 0},
+			{"ControlLeft", 1u << 1, 0}, {"ControlRight", 1u << 1, 0},
+			{"KeyA", 0, 1}, {"KeyD", 0, 2}, {"KeyW", 0, 4}, {"KeyS", 0, 8},
+		};
+		for(const Map& m : kMap)
+		{
+			if(std::strcmp(code, m.code) == 0)
+			{
+				*stick = m.stick;
+				return m.bit;
+			}
+		}
+		*stick = 0;
+		return 0;
+	}
