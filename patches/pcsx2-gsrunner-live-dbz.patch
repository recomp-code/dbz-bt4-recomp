+// UserHacks_TCOffsetByScale = "2:x/y,3:x/y,...": the texture-coordinate offset that removes doubled edges depends on
+// the internal resolution, so it is picked from this table (nearest scale) at start and whenever the scale changes.
+static void LiveApplyTCOffsetByScale()
+{
+	const std::string table = s_settings_interface.GetStringValue("EmuCore/GS", "UserHacks_TCOffsetByScale", "");
+	if (table.empty())
+		return;
+	const float upscale = s_settings_interface.GetFloatValue("EmuCore/GS", "upscale_multiplier", 1.0f);
+	float best_dist = 1e9f;
+	int best_x = -1, best_y = -1;
+	for (const std::string_view entry : StringUtil::SplitString(table, ','))
+	{
+		float scale;
+		int x, y;
+		if (std::sscanf(std::string(entry).c_str(), " %f : %d / %d", &scale, &x, &y) != 3)
+			continue;
+		if (std::fabs(scale - upscale) < best_dist)
+		{
+			best_dist = std::fabs(scale - upscale);
+			best_x = x;
+			best_y = y;
+		}
+	}
+	if (best_x < 0)
+		return;
+	s_settings_interface.SetIntValue("EmuCore/GS", "UserHacks_TCOffsetX", best_x);
+	s_settings_interface.SetIntValue("EmuCore/GS", "UserHacks_TCOffsetY", best_y);
+	std::fprintf(stderr, "[gshost] TC offset for %gx: %d/%d\n", upscale, best_x, best_y);
+}
